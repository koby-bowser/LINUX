{"step_index":461,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:06:36Z","content":"Created At: 2026-09-10T17:06:36+04:00\nCompleted At: 2026-09-10T17:06:43+04:00\nFile Path: `file:///home/koby/.ansible/playbooks/issue-deploy-certs.yml`\nTotal Lines: 331\nTotal Bytes: 14340\nShowing lines 1 to 331\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # Émet/renouvelle des certificats Let's Encrypt par challenge DNS-01 pour les\n3: # domaines listés dans group_vars/all/certificates.yml, puis les déploie sur\n4: # le serveur qui héberge chaque domaine (nginx/apache), avec reload\n5: # UNIQUEMENT si le certificat a réellement changé (comparaison de numéro de\n6: # série avant/après émission — pas de coupure de service inutile).\n7: #\n8: # Deux backends DNS supportés (un par domaine, voir certificates.yml) :\n9: #   - rfc2136  : ns1 (BIND), via le plugin officiel certbot-dns-rfc2136\n10: #   - powerdns : dnsp-mst (PowerDNS), via l'API REST + hooks certbot --manual\n11: #                (pas de plugin apt/pip fiable disponible pour PowerDNS —\n12: #                l'API REST officielle est plus stable qu'un plugin tiers)\n13: #\n14: # Prérequis avant le premier run :\n15: #   1. Remplir group_vars/all/certificates.yml (domaine -> backend/hôte cible)\n16: #   2. Créer group_vars/all/vault.yml chiffré à partir de vault.yml.example :\n17: #        ansible-vault create group_vars/all/vault.yml\n18: #   3. SSH par clé déjà déployé sur chaque target_host\n19: #      (cf. playbooks/deploy-ssh-key.yml)\n20: #\n21: # Usage :\n22: #   ansible-playbook playbooks/issue-deploy-certs.yml --ask-vault-pass\n23: #\n24: # Ne traiter qu'un seul domaine du catalogue (ex. premier test) :\n25: #   ansible-playbook playbooks/issue-deploy-certs.yml --ask-vault-pass \\\n26: #     -e certs_filter=outremer-telecom.fr\n27: #\n28: # Mode ad-hoc — n'importe quel domaine hébergé sur ns1, SANS l'ajouter à\n29: # certificates.yml : la zone ns1 (et son fichier) qui héberge le domaine\n30: # est découverte automatiquement via named.conf sur ns1. Utile pour un\n31: # domaine ponctuel qui n'a pas vocation à être géré durablement ici.\n32: #   ansible-playbook playbooks/issue-deploy-certs.yml --ask-vault-pass --ask-become-pass \\\n33: #     --tags issue -e cert_domain=nouveau.only.fr\n34: # Avec déploiement (sinon target_host reste \"CHANGEME\" et --tags deploy échoue) :\n35: #     -e cert_domain=nouveau.only.fr -e adhoc_target_host=web1 \\\n36: #     -e adhoc_webserver=nginx -e adhoc_service_name=nginx \\\n37: #     -e adhoc_cert_dest_dir=/etc/nginx/ssl/nouveau.only.fr\n38: #\n39: # ATTENTION mode ad-hoc : acme-zone-update.sh suppose un format de fichier\n40: # de zone précis (serial SOA \"NNNNNNNNNN ; serial\", TXT sur une seule\n41: # ligne) — validé sur only.fr. Pour une zone jamais testée, vérifiez d'abord\n42: # sur une copie (cf. méthode utilisée pour only.fr) avant de faire confiance\n43: # à ce mode sur une zone de production inconnue.\n44: \n45: - name: Émettre/renouveler les certificats Let's Encrypt (DNS-01) et les installer\n46:   hosts: localhost\n47:   connection: local\n48:   gather_facts: false\n49:   become: true\n50:   vars:\n51:     letsencrypt_email: \"{{ vault_letsencrypt_email }}\"\n52:     # Sécurité par défaut : émet contre l'environnement STAGING de Let's\n53:     # Encrypt (certificats non fiables par les navigateurs, mais rate-limit\n54:     # très large) tant que ce n'est pas explicitement désactivé. Passez\n55:     # -e letsencrypt_staging=false pour un vrai certificat de production —\n56:     # à ne faire qu'une fois le playbook validé en staging.\n57:     letsencrypt_staging: true\n58:     # Mode ad-hoc (cert_domain défini) : la liste démarre vide, elle est\n59:     # reconstruite plus bas dans pre_tasks une fois la zone ns1 découverte.\n60:     active_certificates: >-\n61:       {{ [] if cert_domain is defined\n62:          else ((certificates | selectattr('domain', 'equalto', certs_filter) | list)\n63:                if certs_filter is defined else certificates) }}\n64:     # Vrai si un backend ssh_zonefile (ns1) est en jeu, catalogue OU ad-hoc —\n65:     # utilisé pour déclencher le provisionnement ns1 (clé root, scripts\n66:     # distants) avant même que active_certificates soit repeuplé en ad-hoc.\n67:     ssh_zonefile_needed: >-\n68:       {{ (active_certificates | selectattr('dns_backend', 'equalto', 'ssh_zonefile') | list | length > 0)\n69:          or (cert_domain is defined) }}\n70: \n71:   pre_tasks:\n72:     # tags: [always] sur chaque pre_task : sans ça, --tags issue (ou --tags\n73:     # deploy) les fait sauter silencieusement (aucune ligne \"skipping\" même\n74:     # affichée) puisqu'ils n'ont eux-mêmes aucun tag correspondant — piège\n75:     # rencontré en test réel : certbot jamais installé alors que le run\n76:     # semblait se dérouler normalement.\n77:     - name: Installer certbot, le plugin RFC2136, et les outils nécessaires aux hooks\n78:       ansible.builtin.apt:\n79:         name:\n80:           - certbot\n81:           - python3-certbot-dns-rfc2136\n82:           - bind9-dnsutils\n83:           - curl\n84:           - jq\n85:         state: present\n86:         update_cache: true\n87:       tags: [always]\n88: \n89:     - name: S'assurer que le répertoire des identifiants/hooks certbot existe (700)\n90:       ansible.builtin.file:\n91:         path: /root/.secrets/certbot\n92:         state: directory\n93:         mode: '0700'\n94:         owner: root\n95:         group: root\n96:       tags: [always]\n97: \n98:     - name: Déployer le fichier d'identifiants RFC2136 (ns1/BIND)\n99:       ansible.builtin.template:\n100:         src: templates/rfc2136-credentials.ini.j2\n101:         dest: /root/.secrets/certbot/rfc2136.ini\n102:         mode: '0600'\n103:         owner: root\n104:         group: root\n105:       when: active_certificates | selectattr('dns_backend', 'equalto', 'rfc2136') | list | length > 0\n106:       tags: [always]\n107: \n108:     - name: Déployer les hooks manuels PowerDNS (auth/cleanup)\n109:       ansible.builtin.copy:\n110:         src: \"files/certbot-hooks/{{ item }}\"\n111:         dest: \"/root/.secrets/certbot/{{ item }}\"\n112:         mode: '0700'\n113:         owner: root\n114:         group: root\n115:       loop:\n116:         - pdns-auth-hook.sh\n117:         - pdns-cleanup-hook.sh\n118:       when: active_certificates | selectattr('dns_backend', 'equalto', 'powerdns') | list | length > 0\n119:       tags: [always]\n120: \n121:     - name: Déployer les hooks manuels ns1/BIND (édition de zone via SSH)\n122:       ansible.builtin.copy:\n123:         src: \"files/certbot-hooks/{{ item }}\"\n124:         dest: \"/root/.secrets/certbot/{{ item }}\"\n125:         mode: '0700'\n126:         owner: root\n127:         group: root\n128:       loop:\n129:         - ns1-zonefile-auth-hook.sh\n130:         - ns1-zonefile-cleanup-hook.sh\n131:       when: ssh_zonefile_needed\n132:       tags: [always]\n133: \n134:     # become: false ici : scp/ssh doivent utiliser le ~/.ssh/config et la clé\n135:     # de koby (où l'alias \"ns1\" est défini), pas ceux de root — become: true\n136:     # au niveau du play les ferait échouer avec \"Could not resolve hostname\".\n137:     # Chemin distant en dur (pas de \"~\") : le module command d'Ansible\n138:     # expanse \"~\" côté contrôleur (avec le home de koby !) avant d'envoyer\n139:     # la commande à ssh — piège rencontré en test réel.\n140:     - name: Déployer le script distant d'édition de zone sur ns1\n141:       become: false\n142:       ansible.builtin.command: >-\n143:         scp {{ playbook_dir }}/files/ns1-hooks/acme-zone-update.sh\n144:         {{ vault_ns1_ssh_alias }}:{{ vault_ns1_admin_home | default('/home/admin') }}/acme-zone-update.sh\n145:       changed_when: true\n146:       when: ssh_zonefile_needed\n147:       tags: [always]\n148: \n149:     - name: Rendre le script distant exécutable sur ns1\n150:       become: false\n151:       ansible.builtin.command: >-\n152:         ssh {{ vault_ns1_ssh_alias }} chmod +x {{ vault_ns1_admin_home | default('/home/admin') }}/acme-zone-update.sh\n153:       changed_when: true\n154:       when: ssh_zonefile_needed\n155:       tags: [always]\n156: \n157:     - name: Déployer le script de découverte de zone sur ns1 (mode ad-hoc)\n158:       become: false\n159:       ansible.builtin.command: >-\n160:         scp {{ playbook_dir }}/files/ns1-hooks/find-zone.sh\n161:         {{ vault_ns1_ssh_alias }}:{{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh\n162:       changed_when: true\n163:       when: ssh_zonefile_needed\n164:       tags: [always]\n165: \n166:     - name: Rendre le script de découverte de zone exécutable sur ns1\n167:       become: false\n168:       ansible.builtin.command: >-\n169:         ssh {{ vault_ns1_ssh_alias }} chmod +x {{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh\n170:       changed_when: true\n171:       when: ssh_zonefile_needed\n172:       tags: [always]\n173: \n174:     # certbot (plus loin dans ce playbook) tourne en root et invoque nos\n175:     # hooks --manual, qui font \"ssh ${NS1_SSH_ALIAS}\" — il faut donc que\n176:     # root ait AUSSI la clé et l'alias ns1, pas seulement koby.\n177:     - name: Provisionner le ~/.ssh de root avec la clé et l'alias ns1 (pour les hooks certbot)\n178:       ansible.builtin.copy:\n179:         src: \"{{ item.src }}\"\n180:         dest: \"{{ item.dest }}\"\n181:         mode: \"{{ item.mode }}\"\n182:         owner: root\n183:         group: root\n184:         remote_src: true\n185:       loop:\n186:         - { src: \"/home/koby/.ssh/id_rsa\", dest: \"/root/.ssh/id_rsa\", mode: '0600' }\n187:         - { src: \"/home/koby/.ssh/id_rsa.pub\", dest: \"/root/.ssh/id_rsa.pub\", mode: '0644' }\n188:       when: ssh_zonefile_needed\n189:       tags: [always]\n190: \n191:     - name: S'assurer que le ~/.ssh de root a les bonnes permissions de répertoire\n192:       ansible.builtin.file:\n193:         path: /root/.ssh\n194:         state: directory\n195:         mode: '0700'\n196:         owner: root\n197:         group: root\n198:       when: ssh_zonefile_needed\n199:       tags: [always]\n200: \n201:     - name: Ajouter l'alias ns1 au ~/.ssh/config de root, s'il n'y est pas déjà\n202:       ansible.builtin.blockinfile:\n203:         path: /root/.ssh/config\n204:         create: true\n205:         mode: '0600'\n206:         owner: root\n207:         group: root\n208:         marker: \"# {mark} ANSIBLE MANAGED BLOCK - alias ns1\"\n209:         block: |\n210:           Host {{ vault_ns1_ssh_alias }}\n211:               HostName {{ vault_ns1_dns_host }}\n212:               User admin\n213:               IdentityFile /root/.ssh/id_rsa\n214:               HostKeyAlgorithms +ssh-rsa\n215:               PubkeyAcceptedAlgorithms +ssh-rsa\n216:               IdentitiesOnly yes\n217:               StrictHostKeyChecking accept-new\n218:       when: ssh_zonefile_needed\n219:       tags: [always]\n220: \n221:     # --- Mode ad-hoc : découverte de la zone ns1 pour cert_domain ---\n222:     - name: \"[ad-hoc] Découvrir la zone ns1 hébergeant {{ cert_domain | default('') }}\"\n223:       become: false\n224:       ansible.builtin.command:\n225:         cmd: >-\n226:           ssh {{ vault_ns1_ssh_alias }}\n227:           \"sudo -S {{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh {{ cert_domain }}\"\n228:         stdin: \"{{ vault_ns1_sudo_password }}\"\n229:       register: ns1_zone_lookup\n230:       changed_when: false\n231:       failed_when: false\n232:       no_log: true\n233:       when: cert_domain is defined\n234:       tags: [always]\n235: \n236:     - name: \"[ad-hoc] Échouer si aucune zone ns1 ne contient {{ cert_domain | default('') }}\"\n237:       ansible.builtin.fail:\n238:         msg: >-\n239:           Aucune zone trouvée sur ns1 pour {{ cert_domain }} :\n240:           {{ ns1_zone_lookup.stderr | default('sortie indisponible') }}\n241:       when: cert_domain is defined and ns1_zone_lookup.rc | default(1) != 0\n242:       tags: [always]\n243: \n244:     - name: \"[ad-hoc] Extraire zone/fichier depuis la sortie de find-zone.sh\"\n245:       ansible.builtin.set_fact:\n246:         ns1_zone_parts: \"{{ ns1_zone_lookup.stdout.split('\\t') }}\"\n247:       when: cert_domain is defined and ns1_zone_lookup.rc == 0\n248:       tags: [always]\n249: \n250:     - name: \"[ad-hoc] Construire l'entrée de certificat pour {{ cert_domain | default('') }}\"\n251:       ansible.builtin.set_fact:\n252:         active_certificates: >-\n253:           {{ [{\n254:             'domain': cert_domain,\n255:             'extra_sans': [],\n256:             'dns_backend': 'ssh_zonefile',\n257:             'zone': ns1_zone_parts[0],\n258:             'zone_file': ns1_zone_parts[1],\n259:             'target_host': adhoc_target_host | default('CHANGEME'),\n260:             'webserver': adhoc_webserver | default('nginx'),\n261:             'service_name': adhoc_service_name | default('nginx'),\n262:             'cert_dest_dir': adhoc_cert_dest_dir | default('/etc/nginx/ssl/' + cert_domain),\n263:           }] }}\n264:       when: cert_domain is defined and ns1_zone_lookup.rc == 0\n265:       tags: [always]\n266: \n267:     - name: \"[ad-hoc] Zone découverte pour {{ cert_domain | default('') }}\"\n268:       ansible.builtin.debug:\n269:         msg: \"{{ cert_domain }} -> zone {{ active_certificates[0].zone }} ({{ active_certificates[0].zone_file }})\"\n270:       when: cert_domain is defined\n271:       tags: [always]\n272: \n273:   tasks:\n274:     - name: Émettre/renouveler les certificats — backend rfc2136 (ns1/BIND)\n275:       ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\n276:       loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'rfc2136') | list }}\"\n277:       loop_control:\n278:         loop_var: cert\n279:       vars:\n280:         cert_backend_args: >-\n281:           --dns-rfc2136\n282:           --dns-rfc2136-credentials /root/.secrets/certbot/rfc2136.ini\n283:           --dns-rfc2136-propagation-seconds 30\n284:       tags: [issue]\n285: \n286:     - name: Émettre/renouveler les certificats — backend powerdns (dnsp-mst)\n287:       ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\n288:       loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'powerdns') | list }}\"\n289:       loop_control:\n290:         loop_var: cert\n291:       vars:\n292:         cert_backend_args: >-\n293:           --manual --preferred-challenges dns\n294:           --manual-auth-hook /root/.secrets/certbot/pdns-auth-hook.sh\n295:           --manual-cleanup-hook /root/.secrets/certbot/pdns-cleanup-hook.sh\n296:         cert_env:\n297:           PDNS_API_URL: \"{{ vault_powerdns_api_url }}\"\n298:           PDNS_API_KEY: \"{{ vault_powerdns_api_key }}\"\n299:           PDNS_DNS_HOST: \"{{ vault_powerdns_dns_host }}\"\n300:       tags: [issue]\n301: \n302:     - name: Émettre/renouveler les certificats — backend ssh_zonefile (ns1/BIND, édition manuelle)\n303:       ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\n304:       loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'ssh_zonefile') | list }}\"\n305:       loop_control:\n306:         loop_var: cert\n307:       vars:\n308:         cert_backend_args: >-\n309:           --manual --preferred-challenges dns\n310:           --manual-auth-hook /root/.secrets/certbot/ns1-zonefile-auth-hook.sh\n311:           --manual-cleanup-hook /root/.secrets/certbot/ns1-zonefile-cleanup-hook.sh\n312:         cert_env:\n313:           NS1_SSH_ALIAS: \"{{ vault_ns1_ssh_alias }}\"\n314:           NS1_DNS_HOST: \"{{ vault_ns1_dns_host }}\"\n315:           NS1_SUDO_PASS: \"{{ vault_ns1_sudo_password }}\"\n316:           NS1_ZONE_FILE: \"{{ cert.zone_file }}\"\n317:           NS1_ZONE_NAME: \"{{ cert.zone }}\"\n318:       tags: [issue]\n319: \n320:     - name: Résumé des certificats traités\n321:       ansible.builtin.debug:\n322:         var: certs_deploy_queue\n323:       tags: [issue, deploy]\n324: \n325:     - name: Déployer le certificat et recharger le webserver (uniquement si changé)\n326:       ansible.builtin.include_tasks: tasks/deploy_and_reload_cert.yml\n327:       loop: \"{{ certs_deploy_queue | default([]) | selectattr('changed', 'equalto', true) | list }}\"\n328:       loop_control:\n329:         loop_var: deploy_item\n330:       tags: [deploy]\n331: \nThe above content shows the entire, complete file contents of the requested file.\n"}
