ient.outremer-telecom.fr-error.log warn;\r\n\r\n    # Redirection explicite racine → /centreon/\r\n    location = / {\r\n        return 301 /centreon/;\r\n    }\r\n\r\n    # Location block to forward LoRaWAN traffic to backend server on port 8443\r\n    location /lorawan/data {\r\n        proxy_pass http://172.30.198.49:8443/lorawan/data;\r\n        include nginxconfig.io/proxy.conf;\r\n        \r\n        # Standard proxy headers\r\n        proxy_set_header Host $host;\r\n        proxy_set_header X-Real-IP $remote_addr;\r\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\r\n        proxy_set_header X-Forwarded-Proto https;\r\n        proxy_set_header X-Forwarded-Ssl on;\r\n        \r\n        # Ensure Nginx passes all custom and standard client request headers\r\n        proxy_pass_request_headers on;\r\n        \r\n        # Allow extra large or custom header buffers if needed\r\n        proxy_headers_hash_max_size 1024;\r\n        proxy_headers_hash_bucket_size 128;\r\n    }    \r\n\r\n    # reverse proxy\r\n    location / {\r\n        proxy_pass http://172.30.198.49;\r\n        include    nginxconfig.io/proxy.conf;\r\n        proxy_set_header X-Forwarded-Proto https;\r\n        proxy_set_header X-Forwarded-Ssl   on;\r\n        proxy_redirect http:// https://;\r\n        proxy_headers_hash_max_size 1024;\r\n        proxy_headers_hash_bucket_size 128;\r\n\r\n    }\r\n\r\n    # additional config\r\n    include nginxconfig.io/general.conf;\r\n\r\n}\r\n\r\n# HTTP redirect\r\nserver {\r\n    listen      172.30.198.33:80 reuseport;\r\n    server_name extranetclient.outremer-telecom.fr;\r\n    return      301 https://$host$request_uri;\r\n}\r\n\r\n#HTTPS redirect MAP\r\nserver {\r\n    listen              172.30.198.33:9443 ssl http2 reuseport;\r\n    server_name         extranetclient.outremer-telecom.fr;\r\n\r\n    # SSL (même certificat Let's Encrypt que :443)\r\n    ssl_certificate     /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/full