n;\n\n    # Redirection explicite racine → /centreon-map/\n    location = / {\n        return 301 /centreon-map/;\n    }\n\n    # reverse proxy vers Map (Tomcat HTTPS sur port 9443)\n    location / {\n        proxy_pass                 https://172.30.198.50:9443;\n        proxy_ssl_verify           off;\n\n        include                    nginxconfig.io/proxy.conf;\n        proxy_set_header Host      $http_host;\n        proxy_set_header X-Forwarded-Proto https;\n        proxy_set_header X-Forwarded-Ssl   on;\n        proxy_set_header X-Forwarded-Port  9443;\n\n        proxy_redirect             http:// https://;\n        proxy_headers_hash_max_size   1024;\n        proxy_headers_hash_bucket_size 128;\n    }\n\n    # additional config\n    include nginxconfig.io/general.conf;\n}\nEOF\n\n# Test syntax and reload\nsudo nginx -t && sudo systemctl reload nginx\n'","Cwd":"/home/koby","WaitMsBeforeAsync":5000,"toolAction":"Running command","toolSummary":"Deploy perfected vhost on reverse proxy"}}]}
