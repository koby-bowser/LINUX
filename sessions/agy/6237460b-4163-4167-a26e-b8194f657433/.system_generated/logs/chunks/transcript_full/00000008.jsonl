ec=\"${txt_name%.}.\"                 # nom canonique avec point final\n57: zone=\"${PDNS_ZONE%.}.\"               # zone-id canonique avec point final\n58: api=\"${PDNS_API_URL%/}/api/v1/servers/${server_id}/zones/${zone}\"\n59: \n60: if [ \"$mode\" = add ]; then\n61:   : \"${CERTBOT_VALIDATION:?CERTBOT_VALIDATION (fourni par certbot) requis}\"\n62:   # PowerDNS attend le TXT entre guillemets DANS le champ content.\n63:   body=\"$(printf '{\"rrsets\":[{\"name\":\"%s\",\"type\":\"TXT\",\"ttl\":60,\"changetype\":\"REPLACE\",\"records\":[{\"content\":\"\\\\\"%s\\\\\"\",\"disabled\":false}]}]}' \"$rec\" \"$CERTBOT_VALIDATION\")\"\n64: elif [ \"$mode\" = del ]; then\n65:   body=\"$(printf '{\"rrsets\":[{\"name\":\"%s\",\"type\":\"TXT\",\"changetype\":\"DELETE\"}]}' \"$rec\")\"\n66: else\n67:   echo \"mode inconnu : $mode (attendu add|del)\" >&2\n68:   exit 2\n69: fi\n70: \n71: curl -sS -f -X PATCH \"$api\" \\\n72:   --connect-timeout \"${PDNS_CURL_CONNECT_TIMEOUT:-10}\" \\\n73:   --max-time \"${PDNS_CURL_MAX_TIME:-20}\" \\\n74:   -H \"X-API-Key: ${PDNS_API_KEY}\" \\\n75:   -H \"Content-Type: application/json\" \\\n76:   --data \"$body\" >/dev/null\n77: \n78: if [ \"$mode\" = add ]; then\n79:   # Vérif best-effort sur le master autoritaire (si joignable en :53 depuis ici),\n80:   # puis attente fixe pour la propagation aux secondaires / la vue publique.\n81:   ns=\"$(printf '%s' \"$PDNS_API_URL\" | sed -E 's#^https?://([^:/]+).*#\\1#')\"\n82:   for _ in $(seq 1 12); do\n83:     if command -v dig >/dev/null 2>&1 \\\n84:        && dig +short \"@${ns}\" TXT \"${txt_name}\" 2>/dev/null | grep -qF \"${CERTBOT_VALIDATION}\"; then\n85:       break\n86:     fi\n87:     sleep 5\n88:   done\n89:   sleep \"${PDNS_PROPAGATION_WAIT:-30}\"\n90: fi\n91: \nThe above content shows the entire, complete file contents of the requested file.\n"}
