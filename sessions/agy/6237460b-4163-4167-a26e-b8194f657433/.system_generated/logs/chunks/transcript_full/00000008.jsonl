aphore.md §7). le_target=test reste possible\n281:           sans cette clé (clé livrée en clair, à chiffrer à la main).\n282:       when: le_target != 'test'\n283: \n284:     - name: >-\n285:         Construire l'environnement proxy (uniquement les extra-vars\n286:         HTTP(S)_PROXY/NO_PROXY réellement définies et non vides — certains\n287:         runners (ex. CORP) les exposent en extra-vars, d'autres (ex. PROD) ont\n288:         déjà le proxy en env OS ambiant : ne jamais écraser ce dernier par '')\n289:       ansible.builtin.set_fact:\n290:         le_proxy_env: \"{{ le_proxy_env | default({}) | combine({item.key: item.value}) }}\"\n291:       loop:\n292:         - {key: http_proxy, value: \"{{ HTTP_PROXY | default('') }}\"}\n293:         - {key: https_proxy, value: \"{{ HTTPS_PROXY | default('') }}\"}\n294:         - {key: no_proxy, value: \"{{ NO_PROXY | default('') }}\"}\n295:       loop_control:\n296:         label: \"{{ item.key }}\"\n297:       when: item.value | length > 0\n298: \n299:     - name: Charger la clé API PowerDNS (vault id 2)\n300:       ansible.builtin.include_vars:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
