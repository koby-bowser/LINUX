{"step_index":541,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:11:09Z","content":"Created At: 2026-09-10T17:11:09+04:00\nCompleted At: 2026-09-10T17:11:09+04:00\nFile Path: `file:///home/koby/infra-management-system/playbooks/issue-le-cert.yml`\nTotal Lines: 663\nTotal Bytes: 37471\nShowing lines 50 to 195\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n50: # _acme-doccli.redcaraibe.fr, ET _acme-challenge.doccli.api.sfrcaraibe.fr ->\n51: # _acme-doccli-api.redcaraibe.fr) — jamais le même, sinon les deux challenges\n52: # DNS-01 s'écrasent pendant l'émission (cf. PDNS_TXT_NAME_MAP plus bas).\n53: - name: Émettre / renouveler un certificat public Let's Encrypt (DNS-01 PowerDNS)\n54:   hosts: localhost\n55:   connection: local\n56:   become: false\n57:   gather_facts: false\n58:   vars:\n59:     le_email: \"l.rangon@outremer-telecom.fr\"\n60:     certbot_staging: true\n61:     # Sélection opérateur : test | red | sfr_retractation | lpm | all. Le détail zone/alias\n62:     # CNAME reste dans ce map, l'opérateur ne saisit qu'un token connu (survey\n63:     # Semaphore). Défaut délibérément \"test\" (aucun impact prod) : \"all\" et\n64:     # les 3 marques réelles doivent être choisis EXPLICITEMENT.\n65:     le_target: test\n66:     le_targets_map:\n67:       test:\n68:         # FQDN de test dédié, jamais servi ni déployé sur un frontal — ne\n69:         # touche à aucun cert prod en place. Zone redcaraibe.fr = PowerDNS\n70:         # direct (comme RED), TXT direct sans alias CNAME nécessaire.\n71:         fqdn: test-le-cert.redcaraibe.fr\n72:         pdns_zone: redcaraibe.fr\n73:         pdns_txt_name: \"\"\n74:       red:\n75:         fqdn: retractation.redcaraibe.fr\n76:         pdns_zone: redcaraibe.fr\n77:         pdns_txt_name: \"\"\n78:       sfr_retractation:\n79:         fqdn: retractation.sfrcaraibe.fr\n80:         pdns_zone: redcaraibe.fr\n81:         pdns_txt_name: _acme-sfr.redcaraibe.fr\n82:       lpm:\n83:         fqdn: retractation.lapostemobile.sfrcaraibe.fr\n84:         pdns_zone: redcaraibe.fr\n85:         pdns_txt_name: _acme-lpm.redcaraibe.fr\n86:       api_selfcare:\n87:         # MEP front-controller api.selfcarebusiness.sfrcaraibe.fr (PROD) : même famille\n88:         # que sfr_retractation/lpm — zone sfrcaraibe.fr sur ns1 (BIND legacy), alias CNAME\n89:         # statique déjà posé (_acme-challenge.api.selfcarebusiness.sfrcaraibe.fr ->\n90:         # _acme-apiselfcare.redcaraibe.fr).\n91:         fqdn: api.selfcarebusiness.sfrcaraibe.fr\n92:         pdns_zone: redcaraibe.fr\n93:         pdns_txt_name: _acme-apiselfcare.redcaraibe.fr\n94:       stats_sfrcaraibe:\n95:         # stats.sfrcaraibe.com (Matomo, trp-wextp-stat1, hors IaC) — même famille que\n96:         # sfr_retractation/lpm/api_selfcare : zone sfrcaraibe.com sur ns1 (BIND legacy),\n97:         # alias CNAME statique requis sur ns1 avant toute émission réelle :\n98:         #   _acme-challenge.stats.sfrcaraibe.com -> _acme-stats.redcaraibe.fr\n99:         # Contourne le blocage réseau HTTP-01 constaté sur trp-wextp-stat1 (aucun accès\n100:         # sortant fiable vers l'API ACME depuis cet hôte) : DNS-01 ne requiert aucun accès\n101:         # réseau depuis/vers ce host, seulement depuis le runner qui joue ce playbook.\n102:         # Déploiement du bundle émis : PAS via deploy-tls-bundle/nginx_vhost_php (vhost\n103:         # matomo.conf hors IaC, chemins certbot en dur /etc/letsencrypt/live/...) — action\n104:         # séparée dédiée.\n105:         fqdn: stats.sfrcaraibe.com\n106:         pdns_zone: redcaraibe.fr\n107:         pdns_txt_name: _acme-stats.redcaraibe.fr\n108:       drive_omt:\n109:         # Cible de formation (TP équipe INFRA) : domaine réel déjà servi, zone\n110:         # outremer-telecom.fr déjà hébergée sur le même master PowerDNS que\n111:         # redcaraibe.fr (SOA-EDIT-API actif, cf. scripts/acme/README.md) ->\n112:         # TXT direct, pas d'alias CNAME nécessaire, comme \"red\".\n113:         fqdn: drive.outremer-telecom.fr\n114:         pdns_zone: outremer-telecom.fr\n115:         pdns_txt_name: \"\"\n116:       ipsfdev:\n117:         # Domaine réel servi par un host hors-IaC (92_GBS-LBNG-01, absent de ce\n118:         # repo — même famille que gbs-frontweb-02/drive.outremer-telecom.fr).\n119:         # Zone sfrcaraibe.fr = BIND legacy (pas PowerDNS) -> alias CNAME\n120:         # statique requis sur ns1 (_acme-challenge.ipsfdev.sfrcaraibe.fr ->\n121:         # _acme-ipsfdev.redcaraibe.fr), comme pour \"sfr_retractation\"/\"lpm\". Émission\n122:         # uniquement ici : le déploiement sur GBS-LBNG-01 est hors périmètre\n123:         # de ce playbook (host non géré par ce repo).\n124:         fqdn: ipsfdev.sfrcaraibe.fr\n125:         pdns_zone: redcaraibe.fr\n126:         pdns_txt_name: _acme-ipsfdev.redcaraibe.fr\n127:       identity:\n128:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus.\n129:         fqdn: identity.sfrcaraibe.fr\n130:         pdns_zone: redcaraibe.fr\n131:         pdns_txt_name: _acme-identity.redcaraibe.fr\n132:       des:\n133:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus.\n134:         fqdn: des.sfrcaraibe.fr\n135:         pdns_zone: redcaraibe.fr\n136:         pdns_txt_name: _acme-des.redcaraibe.fr\n137:       webapp:\n138:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus (zone sfrcaraibe.fr = BIND\n139:         # legacy, alias CNAME statique requis sur ns1 avant toute émission réelle :\n140:         # _acme-challenge.webapp.sfrcaraibe.fr -> _acme-webapp.redcaraibe.fr). Onboarding\n141:         # PROD webapp.sfrcaraibe.fr sur trp-wextp-afe1, cert dédié distinct du legacy\n142:         # (cf. host_vars/trp-wextp-afe1/webapp.yml, vhost_ssl_cert_path).\n143:         fqdn: webapp.sfrcaraibe.fr\n144:         pdns_zone: redcaraibe.fr\n145:         pdns_txt_name: _acme-webapp.redcaraibe.fr\n146:       doccli:\n147:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus (zone sfrcaraibe.fr = BIND\n148:         # legacy, alias CNAME statique requis sur ns1 avant toute émission réelle :\n149:         # _acme-challenge.doccli.sfrcaraibe.fr -> _acme-doccli.redcaraibe.fr). Onboarding\n150:         # PROD doccli.sfrcaraibe.fr sur trp-wextp-afe1, cert dédié distinct du legacy\n151:         # (cf. host_vars/trp-wextp-afe1/doccli.yml, vhost_ssl_cert_path).\n152:         fqdn: doccli.sfrcaraibe.fr\n153:         pdns_zone: redcaraibe.fr\n154:         pdns_txt_name: _acme-doccli.redcaraibe.fr\n155:         # doccli.api.sfrcaraibe.fr est servi par LE MÊME bloc nginx que doccli.sfrcaraibe.fr\n156:         # (vhost_extra_server_names, cf. host_vars/trp-wextp-afe1/doccli.yml) — donc LE MÊME\n157:         # cert (vhost_ssl_cert_path). Sans ce SAN, le navigateur reçoit le cert de\n158:         # doccli.sfrcaraibe.fr en visitant doccli.api.sfrcaraibe.fr -> NET::ERR_CERT_\n159:         # COMMON_NAME_INVALID (constaté le 03/08/26, juste après la bascule live). Ce nom a\n160:         # besoin de SON PROPRE alias CNAME sur ns1 (distinct de celui de doccli.sfrcaraibe.fr,\n161:         # sinon les deux challenges DNS-01 s'écraseraient l'un l'autre pendant l'émission —\n162:         # cf. commentaire PDNS_TXT_NAME_MAP ci-dessous) :\n163:         #   _acme-challenge.doccli.api.sfrcaraibe.fr -> _acme-doccli-api.redcaraibe.fr\n164:         extra_domains:\n165:           - fqdn: doccli.api.sfrcaraibe.fr\n166:             pdns_txt_name: _acme-doccli-api.redcaraibe.fr\n167:       ios:\n168:         # Même host/zone/contrainte que \"ios\" ci-dessus.\n169:         fqdn: ios.outremer-telecom.fr\n170:         pdns_zone: outremer-telecom.fr\n171:         pdns_txt_name: \"\"\n172:       aota:\n173:         # Même host/zone/contrainte que \"aota\" ci-dessus.\n174:         fqdn: aota.outremer-telecom.fr\n175:         pdns_zone: outremer-telecom.fr\n176:         pdns_txt_name: \"\"\n177:       postfix:\n178:         # Même host/zone/contrainte que ios/aota — MX/SMTP-TLS mtq-mailsrvp-01,\n179:         # pas un vhost nginx, déploiement hors périmètre de ce playbook.\n180:         fqdn: postfix.outremer-telecom.fr\n181:         pdns_zone: outremer-telecom.fr\n182:         pdns_txt_name: \"\"\n183:       onetask:\n184:         # FQDN public Altice/OMT, zone outremer-telecom.fr hébergée sur le master\n185:         # PowerDNS th2-dnsp-mst1 (SOA-EDIT-API actif) -> TXT direct, pas d'alias\n186:         # CNAME nécessaire (cf. scripts/acme/README.md).\n187:         fqdn: onetask.outremer-telecom.fr\n188:         pdns_zone: outremer-telecom.fr\n189:         pdns_txt_name: \"\"\n190:       andesite:\n191:         # Correctif 02/09/2026 : l'hypothèse initiale (zone only.fr sur le même\n192:         # master PowerDNS que outremer-telecom.fr/redcaraibe.fr, TXT direct)\n193:         # était fausse — un run staging a échoué avec un 404 PowerDNS sur\n194:         # PATCH .../zones/only.fr. (zone absente de PowerDNS). only.fr est en\n195:         # BIND legacy sur ns1, malgré un nom d'hôte NS partagé avec\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
