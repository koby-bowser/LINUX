resh_interval', _('Refresh interval'));\r\n$form->addElement('text', 'refresh_status_interval', _('Status refresh interval'), ['size' => 5]);\r\n$form->addElement('text', 'refresh_graph_interval', _('Graph refresh interval'), ['size' => 5]);\r\n\r\n// Server Map NG\r\n$form->addElement('text', 'server_address_ng', _('MAP Engine server address'), ['size' => 30]);\r\n$form->addElement(\r\n    'button',\r\n    'test_server_address_ng',\r\n    _('Test connection to server'),\r\n    ['class' => 'btc bt_success', 'onClick' => 'javascript:testServerAddressNg()']\r\n);\r\n\r\n// Internal Server Address\r\n$form->addElement('text', 'internal_server_address_ng', _('MAP server address as seen by Central'), ['size' => 30]);\r\n$form->addElement(\r\n    'button',\r\n    'test_internal_server_address_ng',\r\n    _('Test connection to server'),\r\n    ['class' => 'btc bt_success', 'onClick' => 'javascript:testInternalServerAddressNg()']\r\n);\r\n\r\n$isServerUsingNg[] = $form->createElement('radio', 'server_using_ng', null, _('Yes'), '1');\r\n$isServerUsingNg[] = $form->createElement('radio', 'server_using_ng', null, _('No'), '0');\r\n$form->addGroup($isServerUsingNg, 'server_using_ng', _('MAP Engine server'), '&nbsp;');\r\n\n\n</SYSTEM_MESSAGE>"}
