{"step_index":465,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:06:49Z","content":"Created At: 2026-09-10T17:06:49+04:00\nCompleted At: 2026-09-10T17:06:49+04:00\nFile Path: `file:///home/koby/.ansible/playbooks/tasks/issue_and_queue_cert.yml`\nTotal Lines: 51\nTotal Bytes: 2223\nShowing lines 1 to 51\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # Tâches partagées d'émission d'un certificat pour un backend DNS donné.\n3: # Attend en entrée :\n4: #   cert             : un élément de group_vars/all/certificates.yml\n5: #   cert_backend_args: flags certbot spécifiques au backend (rfc2136/powerdns)\n6: #   cert_env          : (optionnel) variables d'environnement à passer à certbot\n7: # Alimente la liste certs_deploy_queue (agrégée sur toute la durée du play).\n8: #\n9: # Tags explicites sur chaque tâche (plutôt que de compter sur l'héritage\n10: # depuis l'include_tasks parent) : avec include_tasks + loop, l'héritage de\n11: # tag ne propageait pas de façon fiable aux tâches internes dans nos tests.\n12: \n13: - name: \"[{{ cert.domain }}] Relever le numéro de série actuel (avant émission), si le certificat existe déjà\"\n14:   ansible.builtin.command: \"openssl x509 -noout -serial -in /etc/letsencrypt/live/{{ cert.domain }}/cert.pem\"\n15:   register: serial_before\n16:   changed_when: false\n17:   failed_when: false\n18:   tags: [issue]\n19: \n20: - name: \"[{{ cert.domain }}] certbot certonly\"\n21:   ansible.builtin.command: >-\n22:     certbot certonly --non-interactive --agree-tos --expand\n23:     -m {{ letsencrypt_email }}\n24:     {{ '--test-cert' if letsencrypt_staging | bool else '' }}\n25:     {{ cert_backend_args }}\n26:     --cert-name {{ cert.domain }}\n27:     -d {{ cert.domain }}\n28:     {{ (cert.extra_sans | default([])) | map('regex_replace', '^(.*)$', '-d \\\\1') | join(' ') }}\n29:   environment: \"{{ cert_env | default({}) }}\"\n30:   register: certbot_run\n31:   changed_when: \"'not yet due for renewal' not in certbot_run.stdout\"\n32:   tags: [issue]\n33: \n34: - name: \"[{{ cert.domain }}] Relever le numéro de série (après émission)\"\n35:   ansible.builtin.command: \"openssl x509 -noout -serial -in /etc/letsencrypt/live/{{ cert.domain }}/cert.pem\"\n36:   register: serial_after\n37:   changed_when: false\n38:   tags: [issue]\n39: \n40: - name: \"[{{ cert.domain }}] Ajouter à la file de déploiement\"\n41:   ansible.builtin.set_fact:\n42:     certs_deploy_queue: >-\n43:       {{ (certs_deploy_queue | default([])) + [{\n44:         'domain': cert.domain,\n45:         'changed': (serial_before.stdout | default('') != serial_after.stdout),\n46:         'target_host': cert.target_host,\n47:         'service_name': cert.service_name,\n48:         'cert_dest_dir': cert.cert_dest_dir,\n49:       }] }}\n50:   tags: [issue]\n51: \nThe above content shows the entire, complete file contents of the requested file.\n"}
