{"step_index":467,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:06:52Z","content":"Created At: 2026-09-10T17:06:52+04:00\nCompleted At: 2026-09-10T17:06:52+04:00\nFile Path: `file:///home/koby/.ansible/playbooks/tasks/deploy_and_reload_cert.yml`\nTotal Lines: 39\nTotal Bytes: 1499\nShowing lines 1 to 39\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # Déploie un certificat déjà émis vers son serveur cible et recharge le\n3: # webserver. Attend en entrée : deploy_item (un élément de certs_deploy_queue).\n4: # delegate_to est défini par l'include qui boucle dessus ; become est géré ici.\n5: \n6: - name: \"[{{ deploy_item.domain }}] Déployer le certificat et recharger le service\"\n7:   become: true\n8:   delegate_to: \"{{ deploy_item.target_host }}\"\n9:   tags: [deploy]\n10:   block:\n11:     - name: \"[{{ deploy_item.domain }}] Créer le répertoire de destination du certificat\"\n12:       ansible.builtin.file:\n13:         path: \"{{ deploy_item.cert_dest_dir }}\"\n14:         state: directory\n15:         mode: '0750'\n16:         owner: root\n17:         group: root\n18: \n19:     - name: \"[{{ deploy_item.domain }}] Déployer fullchain.pem\"\n20:       ansible.builtin.copy:\n21:         content: \"{{ lookup('file', '/etc/letsencrypt/live/' + deploy_item.domain + '/fullchain.pem') }}\"\n22:         dest: \"{{ deploy_item.cert_dest_dir }}/fullchain.pem\"\n23:         mode: '0644'\n24:         owner: root\n25:         group: root\n26: \n27:     - name: \"[{{ deploy_item.domain }}] Déployer privkey.pem\"\n28:       ansible.builtin.copy:\n29:         content: \"{{ lookup('file', '/etc/letsencrypt/live/' + deploy_item.domain + '/privkey.pem') }}\"\n30:         dest: \"{{ deploy_item.cert_dest_dir }}/privkey.pem\"\n31:         mode: '0600'\n32:         owner: root\n33:         group: root\n34: \n35:     - name: \"[{{ deploy_item.domain }}] Recharger {{ deploy_item.service_name }}\"\n36:       ansible.builtin.service:\n37:         name: \"{{ deploy_item.service_name }}\"\n38:         state: reloaded\n39: \nThe above content shows the entire, complete file contents of the requested file.\n"}
