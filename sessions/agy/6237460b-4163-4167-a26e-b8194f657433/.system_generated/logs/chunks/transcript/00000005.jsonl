{"step_index":461,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:06:36Z","content":"Created At: 2026-09-10T17:06:36+04:00\nCompleted At: 2026-09-10T17:06:43+04:00\nFile Path: `file:///home/koby/.ansible/playbooks/issue-deploy-certs.yml`\nTotal Lines: 331\nTotal Bytes: 14340\nShowing lines 1 to 331\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # Émet/renouvelle des certificats Let's Encrypt par challenge DNS-01 pour les\n3: # domaines listés dans group_vars/all/certificates.yml, puis les déploie sur\n4: # le serveur qui héberge chaque domaine (nginx/apache), avec reload\n5: # UNIQUEMENT si le certificat a réellement changé (comparaison de numéro de\n6: # série avant/après émission — pas de coupure de service inutile).\n7: #\n8: # Deux backends DNS supportés (un par domaine, voir certificates.yml) :\n9: #   - rfc2136  : ns1 (BIND), via le plugin officiel certbot-dns-rfc2136\n10: #   - powerdns : dnsp-mst (PowerDNS), via l'API REST + hooks certbot --manual\n11: #                (pas de plugin apt/pip fiable disponible pour PowerDNS —\n12: #                l'API REST officielle est plus stable qu'un plugin tiers)\n13: #\n14: # Prérequis avant le premier run :\n15: #   1. Remplir group_vars/all/certificates.yml (domaine -> backend/hôte cible)\n16: #   2. Créer group_vars/all/vault.yml chiffré à partir de vault.yml.example :\n17: #        ansible-vault create group_vars/all/vault.yml\n18: #   3. SSH par clé déjà déployé sur chaque target_host\n19: #      (cf. playbooks/deploy-ssh-key.yml)\n20: #\n21: # Usage :\n22: #   ansible-playbook playbooks/issue-deploy-certs.yml --ask-vault-pass\n23: #\n24: # Ne traiter qu'un seul domaine du catalogue (ex. premier test) :\n25: #   ansible-playbook playbooks/issue-deploy-certs.yml --ask-vault-pass \\\n26: #     -e certs_filter=outremer-telecom.fr\n27: #\n28: # Mode ad-hoc — n'importe quel domaine hébergé sur ns1, SANS l'ajouter à\n29: # certificates.yml : la zone \n<truncated 12326 bytes>\n91:       vars:\n292:         cert_backend_args: >-\n293:           --manual --preferred-challenges dns\n294:           --manual-auth-hook /root/.secrets/certbot/pdns-auth-hook.sh\n295:           --manual-cleanup-hook /root/.secrets/certbot/pdns-cleanup-hook.sh\n296:         cert_env:\n297:           PDNS_API_URL: \"{{ vault_powerdns_api_url }}\"\n298:           PDNS_API_KEY: \"{{ vault_powerdns_api_key }}\"\n299:           PDNS_DNS_HOST: \"{{ vault_powerdns_dns_host }}\"\n300:       tags: [issue]\n301: \n302:     - name: Émettre/renouveler les certificats — backend ssh_zonefile (ns1/BIND, édition manuelle)\n303:       ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\n304:       loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'ssh_zonefile') | list }}\"\n305:       loop_control:\n306:         loop_var: cert\n307:       vars:\n308:         cert_backend_args: >-\n309:           --manual --preferred-challenges dns\n310:           --manual-auth-hook /root/.secrets/certbot/ns1-zonefile-auth-hook.sh\n311:           --manual-cleanup-hook /root/.secrets/certbot/ns1-zonefile-cleanup-hook.sh\n312:         cert_env:\n313:           NS1_SSH_ALIAS: \"{{ vault_ns1_ssh_alias }}\"\n314:           NS1_DNS_HOST: \"{{ vault_ns1_dns_host }}\"\n315:           NS1_SUDO_PASS: \"{{ vault_ns1_sudo_password }}\"\n316:           NS1_ZONE_FILE: \"{{ cert.zone_file }}\"\n317:           NS1_ZONE_NAME: \"{{ cert.zone }}\"\n318:       tags: [issue]\n319: \n320:     - name: Résumé des certificats traités\n321:       ansible.builtin.debug:\n322:         var: certs_deploy_queue\n323:       tags: [issue, deploy]\n324: \n325:     - name: Déployer le certificat et recharger le webserver (uniquement si changé)\n326:       ansible.builtin.include_tasks: tasks/deploy_and_reload_c