ustom and standard client request headers\n        proxy_pass_request_headers on;\n        \n        # Allow extra large or custom header buffers if needed\n        proxy_headers_hash_max_size 1024;\n        proxy\n<truncated 973 bytes>\nain.pem;\n    ssl_certificate_key /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/privkey.pem;\n\n    # security\n    include             nginxconfig.io/security.conf;\n\n    # logging (nouveaux fichiers dédiés — pour ne pas polluer les logs du :443)\n    access_log          /var/log/nginx/extranetclient.outremer-telecom.fr-9443-access.log;\n    error_log           /var/log/nginx/extranetclient.outremer-telecom.fr-9443-error.log warn;\n\n    # Redirection explicite racine → /centreon-map/\n    location = / {\n        return 301 /centreon-map/;\n    }\n\n    # reverse proxy vers Map (Tomcat HTTPS sur port 9443)\n    location / {\n        proxy_pass                 https://172.30.198.50:9443;\n        proxy_ssl_verify           off;\n\n        include                    nginxconfig.io/proxy.conf;\n        proxy_set_header Host      $http_host;\n        proxy_set_header X-Forwarded-Proto https;\n        proxy_set_header X-Forwarded-Ssl   on;\n        proxy_set_header X-Forwarded-Port  9443;\n\n        proxy_redirect             http:// https://;\n        proxy_headers_hash_max_size   1024;\n        proxy_headers_hash_bucket_size 128;\n    }\n\n    # additional config\n    include nginxconfig.io/general.conf;\n}\nEOF\n\n# 3. Test syntax\nsudo nginx -t\n\n# 4. If syntax is OK, reload nginx\nif [ $? -eq 0 ]; then\n    echo \"Reloading Nginx...\"\n    sudo systemctl reload nginx\n    echo \"Nginx reloaded successfully!\"\nelse\n    echo \"Syntax check failed! Restoring backup...\"\n    sudo cp -a /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf.bak.* \\\n               /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf\nfi\n'\nTask logs are available at: file:///home/koby/.gemini/antigravity