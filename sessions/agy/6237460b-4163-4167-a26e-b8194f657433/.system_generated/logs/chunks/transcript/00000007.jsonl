ui pourrait mettre en cache une réponse négative).\n28: for _ in $(seq 1 30); do\n29:   found=\"$(dig +short TXT \"${record_name}\" @\"${PDNS_DNS_HOST}\" | tr -d '\"')\"\n30:   if [ \"${found}\" = \"${CERTBOT_VALIDATION}\" ]; then\n31:     exit 0\n32:   fi\n33:   sleep 2\n34: done\n35: \n36: echo \"Timeout en attendant la propagation du TXT ${record_name} sur ${PDNS_DNS_HOST}\" >&2\n37: exit 1\n38: \nThe above content shows the entire, complete file contents of the requested file.\n"}
