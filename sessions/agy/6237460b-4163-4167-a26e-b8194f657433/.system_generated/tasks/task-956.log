ombined\nreq = urllib.request.Request(\"https://172.30.198.50:9443/centreon-map/\", headers={\"Host\": \"map.extranetclient.outremer-telecom.fr:9443\", **headers_to_test})\ntry:\n    resp = urllib.request.urlopen(req, context=ctx)\n    print(\"All headers:\", resp.status)\nexcept urllib.error.HTTPError as e:\n    print(\"All headers:\", e.code)\n\n# Test one by one if all headers failed\nfor k, v in headers_to_test.items():\n    req = urllib.request.Request(\"https://172.30.198.50:9443/centreon-map/\", headers={\"Host\": \"map.extranetclient.outremer-telecom.fr:9443\", k: v})\n    try:\n        resp = urllib.request.urlopen(req, context=ctx)\n        print(f\"Header {k}: {resp.status}\")\n    except urllib.error.HTTPError as e:\n        print(f\"Header {k}: {e.code}\")\n'\\'''","Cwd":"/home/koby","WaitMsBeforeAsync":5000,"toolAction":"Running command","toolSummary":"Test each proxy header against Tomcat"}}]}
