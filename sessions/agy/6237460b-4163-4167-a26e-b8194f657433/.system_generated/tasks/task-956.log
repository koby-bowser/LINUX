     map.extranetclient.outremer-telecom.fr extranetclient.outremer-telecom.fr;/server_name         map.extranetclient.outremer-telecom.fr extranetclient.outremer-telecom.fr 109.62.64.18;/\\\" /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf\\n\\n# Add listen 109.62.64.18:9443 if not present\\nif ! grep -q \\\"109.62.64.18:9443\\\" /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf; then\\n    sudo sed -i \\\"/listen              172.30.198.33:9443/a \\\\    listen              109.62.64.18:9443 ssl http2;\\\" /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf\\nfi\\n\\n# 3. Test syntax and reload\\nsudo nginx -t && sudo systemctl reload nginx\\n\\necho -e \\\"\\\\n=== Test curl on 109.62.64.18:9443 locally on reverse proxy ===\\\"\\ncurl -k -i -m 3 https://109.62.64.18:9443/centreon-map/ | head -n 12\\n'\"","Cwd":"\"/home/koby\"","WaitMsBeforeAsync":"5000","toolAction":"\"Running command\"","toolSummary":"\"Configure 109.62.64.18:9443 on reverse proxy\""}}]}
