apply the new configuration.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"~/.ansible/kssh -u superuser 172.30.198.33 '\n# 1. Backup existing file\nsudo cp -a /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf \\\n           /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf.bak.$(date +%F_%H%M%S)\n\n# 2. Prepare new file in /tmp\ncat << '\\''EOF'\\'' | sudo tee /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf > /dev/null\nserver {\n    listen              172.30.198.33:443 ssl http2 reuseport;\n    server_name         extranetclient.outremer-telecom.fr;\n\n    # SSL\n    ssl_certificate /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/fullchain.pem; # managed by Certbot\n    ssl_certificate_key /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/privkey.pem; # managed by Certbot\n\n    # security\n    include             nginxconfig.io/security.conf;\n\n    # logging\n    access_log          /var/log/nginx/extranetclient.outremer-telecom.fr-access.log;\n    error_log           /var/log/nginx/extranetclient.outremer-telecom.fr-error.log warn;\n\n    # Redirection explicite racine → /centreon/\n    location = / {\n        return 301 /centreon/;\n    }\n\n    # Location block to forward LoRaWAN traffic to backend server on port 8443\n    location /lorawan/data {\n        proxy_pass http://172.30.198.49:8443/lorawan/data;\n        include nginxconfig.io/proxy.conf;\n        \n        # Standard proxy headers\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto https;\n        proxy_set_header X-Forwarded-Ssl on;\n        \n        # Ensure Nginx passes all custom and standard client request headers\n        proxy_pass_request_headers on;\n        \n        # Allow extra large or custom header buffers if needed\n        proxy_headers_hash_max_size 1024;\n        proxy_headers_hash_bucket_size 128;\n    }    \n\n    # reverse proxy\n    location / {\n        proxy_pass http://172.30.198.49;\n        include    nginxconfig.io/proxy.conf;\n        proxy_set_header X-Forwarded-Proto https;\n        proxy_set_header X-Forwarded-Ssl   on;\n        proxy_redirect http:// https://;\n        proxy_headers_hash_max_size 1024;\n        proxy_headers_hash_bucket_size 128;\n\n    }\n\n    # additional config\n    include nginxconfig.io/general.conf;\n\n}\n\n# HTTP redirect\nserver {\n    listen      172.30.198.33:80 reuseport;\n    server_name extranetclient.outremer-telecom.fr;\n    return      301 https://$host$request_uri;\n}\n\n#HTTPS redirect MAP\nserver {\n    listen              172.30.198.33:9443 ssl http2 reuseport;\n    server_name         map.extranetclient.outremer-telecom.fr extranetclient.outremer-telecom.fr;\n\n    # SSL (même certificat Let'\\''s Encrypt que :443)\n    ssl_certificate     /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/fullchain.pem;\n    ssl_certificate_key /etc/letsencrypt/live/extranetclient.outremer-telecom.fr/privkey.pem;\n\n    # security\n    include             nginxconfig.io/security.conf;\n\n    # logging (nouveaux fichiers dédiés — pour ne pas polluer les logs du :443)\n    access_log          /var/log/nginx/extranetclient.outremer-telecom.fr-9443-access.log;\n    error_log           /var/log/nginx/extranetclient.outremer-telecom.fr-9443-error.log warn;\n\n    # Redirection explicite racine → /centreon-map/\n    location = / {\n        return 301 /centreon-map/;\n    }\n\n    # reverse proxy vers Map (Tomcat HTTPS sur port 9443)\n    location / {\n        proxy_pass                 https://172.30.198.50:9443;\n        proxy_ssl_verify           off;\n\n        include                    nginxconfig.io/proxy.conf;\n        proxy_set_header Host      $http_host;\n        proxy_set_header X-Forwarded-Proto https;\n        proxy_set_header X-Forwarded-Ssl   on;\n        proxy_set_header X-Forwarded-Port  9443;\n\n        proxy_redirect             http:// https://;\n        proxy_headers_hash_max_size   1024;\n        proxy_headers_hash_bucket_size 128;\n    }\n\n    # additional config\n    include nginxconfig.io/general.conf;\n}\nEOF\n\n# 3. Test syntax\nsudo nginx -t\n\n# 4. If syntax is OK, reload nginx\nif [ $? -eq 0 ]; then\n    echo \"Reloading Nginx...\"\n    sudo systemctl reload nginx\n    echo \"Nginx reloaded successfully!\"\nelse\n    echo \"Syntax check failed! Restoring backup...\"\n    sudo cp -a /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf.bak.* \\\n               /etc/nginx/sites-available/02-extranetclient.outremer-telecom.fr.conf\nfi\n'","Cwd":"/home/koby","WaitMsBeforeAsync":5000,"toolAction":"Running command","toolSummary":"Update Nginx vhost on 172.30.198.33"}}]}
