ct du legacy\n142:         # (cf. host_vars/trp-wextp-afe1/webapp.yml, vhost_ssl_cert_path).\n143:         fqdn: webapp.sfrcaraibe.fr\n144:         pdns_zone: redcaraibe.fr\n145:         pdns_txt_name: _acme-webapp.redcaraibe.fr\n146:       doccli:\n147:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus (zone sfrcaraibe.fr = BIND\n148:         # legacy, alias CNAME statique requis sur ns1 avant toute émission réelle :\n149:         # _acme-challenge.doccli.sfrcaraibe.fr -> _acme-doccli.redcaraibe.fr). Onboarding\n150:         # PROD doccli.sfrcaraibe.fr sur trp-wextp-afe1, cert dédié distinct du legacy\n151:         # (cf. host_vars/trp-wextp-afe1/doccli.yml, vhost_ssl_cert_path).\n152:         fqdn: doccli.sfrcaraibe.fr\n153:         pdns_zone: redcaraibe.fr\n154:         pdns_txt_name: _acme-doccli.redcaraibe.fr\n155:         # doccli.api.sfrcaraibe.fr est servi par LE MÊME bloc nginx que doccli.sfrcaraibe.fr\n156:         # (vhost_extra_server_names, cf. host_vars/trp-wextp-afe1/doccli.yml) — donc LE MÊME\n157:         # cert (vhost_ssl_cert_path). Sans ce SAN, le navigateur reçoit le cert de\n158:         # doccli.sfrcaraibe.fr en visitant doccli.api.sfrcaraibe.fr -> NET::ERR_CERT_\n159:         # COMMON_NAME_INVALID (constaté le 03/08/26, juste après la bascule live). Ce nom a\n160:         # besoin de SON PROPRE alias CNAME sur ns1 (distinct de celui de doccli.sfrcaraibe.fr,\n161:         # sinon les deux challenges DNS-01 s'écraseraient l'un l'autre pendant l'émission —\n162:         # cf. commentaire PDNS_TXT_NAME_MAP ci-dessous) :\n163:         #   _acme-challenge.doccli.api.sfrcaraibe.fr -> _acme-doccli-api.redcaraibe.fr\n164:         extra_domains:\n165:           - fqdn: doccli.api.sfrcaraibe.fr\n166:             pdns_txt_name: _acme-doccli-api.redcaraibe.fr\n167:       ios:\n168:         # Même host/zone/contrainte que \"ios\" ci-dessus.\n169:         fqdn: ios.outremer-telecom.fr\n170:         pdns_zone: outremer-telecom.fr\n171:         pd