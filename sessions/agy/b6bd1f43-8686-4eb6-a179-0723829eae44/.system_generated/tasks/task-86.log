d:\n75:         fqdn: retractation.redcaraibe.fr\n76:         pdns_zone: redcaraibe.fr\n77:         pdns_txt_name: \"\"\n78:       sfr_retractation:\n79:         fqdn: retractation.sfrcaraibe.fr\n80:         pdns_zone: redcaraibe.fr\n81:         pdns_txt_name: _acme-sfr.redcaraibe.fr\n82:       lpm:\n83:         fqdn: retractation.lapostemobile.sfrcaraibe.fr\n84:         pdns_zone: redcaraibe.fr\n85:         pdns_txt_name: _acme-lpm.redcaraibe.fr\n86:       api_selfcare:\n87:         # MEP front-controller api.selfcarebusiness.sfrcaraibe.fr (PROD) : même famille\n88:         # que sfr_retractation/lpm — zone sfrcaraibe.fr sur ns1 (BIND legacy), alias CNAME\n89:         # statique déjà posé (_acme-challenge.api.selfcarebusiness.sfrcaraibe.fr ->\n90:         # _acme-apiselfcare.redcaraibe.fr).\n91:         fqdn: api.selfcarebusiness.sfrcaraibe.fr\n92:         pdns_zone: redcaraibe.fr\n93:         pdns_txt_name: _acme-apiselfcare.redcaraibe.fr\n94:       stats_sfrcaraibe:\n95:         # stats.sfrcaraibe.com (Matomo, trp-wextp-stat1, hors IaC) — même famille que\n96:         # sfr_retractation/lpm/api_selfcare : zone sfrcaraibe.com sur ns1 (BIND legacy),\n97:         # alias CNAME statique requis sur ns1 avant toute émission réelle :\n98:         #   _acme-challenge.stats.sfrcaraibe.com -> _acme-stats.redcaraibe.fr\n99:         # Contourne le blocage réseau HTTP-01 constaté sur trp-wextp-stat1 (aucun accès\n100:         # sortant fiable vers l'API ACME depuis cet hôte) : DNS-01 ne requiert aucun accès\n101:         # réseau depuis/vers ce host, seulement depuis le runner qui joue ce playbook.\n102:         # Déploiement du bundle émis : PAS via deploy-tls-bundle/nginx_vhost_php (vhost\n103:         # matomo.conf hors IaC, chemins certbot en dur /etc/letsencrypt/live/...) — action\n104:         # séparée dédiée.\n105:         fqdn: stats.sfrcaraibe.com\n106:         pdns_zone: redcaraibe.fr\n107:         pdns_txt_name: _acme-stats.redcaraibe.fr\n108:       drive_omt:\n10