   service_name: apache2\n33:     cert_dest_dir: /etc/apache2/ssl/sfrcaraibe.fr\n34: \n35:   - domain: andesite.only.fr\n36:     extra_sans: []\n37:     dns_backend: ssh_zonefile\n38:     zone: only.fr\n39:     zone_file: /var/named/only.fr\n40:     target_host: CHANGEME\n41:     webserver: nginx\n42:     service_name: nginx\n43:     cert_dest_dir: /etc/nginx/ssl/andesite.only.fr\n44: \n45:   - domain: diamond.only.fr\n46:     extra_sans: []\n47:     dns_backend: ssh_zonefile\n48:     zone: only.fr\n49:     zone_file: /var/named/only.fr\n50:     target_host: CHANGEME\n51:     webserver: nginx\n52:     service_name: nginx\n53:     cert_dest_dir: /etc/nginx/ssl/diamond.only.fr\n54: \n55:   - domain: epdg.epc.mnc002.mcc340.pub.3gppnetwork.org\n56:     extra_sans: []\n57:     dns_backend: powerdns\n58:     target_host: CHANGEME\n59:     webserver: nginx\n60:     service_name: nginx\n61:     cert_dest_dir: /etc/nginx/ssl/epdg.epc.mnc002.mcc340.pub.3gppnetwork.org\n62: \n63: \nThe above content shows the entire, complete file contents of the requested file.\n"}
