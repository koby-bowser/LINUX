{"step_index":255,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-02T08:03:43Z","content":"Created At: 2026-10-02T12:03:43+04:00\nCompleted At: 2026-10-02T12:03:43+04:00\nFile Path: `file:///home/koby/LINUX/playbooks/files/certbot-hooks/ns1-zonefile-auth-hook.sh`\nTotal Lines: 77\nTotal Bytes: 3538\nShowing lines 1 to 77\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env bash\n2: # Hook d'authentification DNS-01 pour certbot --manual — backend ns1/BIND,\n3: # édition directe du fichier de zone via SSH (pas de RFC2136 disponible).\n4: #\n5: # Certbot appelle ce script avec CERTBOT_DOMAIN et CERTBOT_VALIDATION.\n6: # Variables d'environnement attendues (jamais écrites en fichier) :\n7: #   NS1_SSH_ALIAS   : alias SSH (voir ~/.ssh/config, ex. \"ns1\")\n8: #   NS1_DNS_HOST    : IP/hostname DNS de ns1 pour les requêtes dig (ex. 172.16.75.250)\n9: #   NS1_SUDO_PASS   : mot de passe sudo de l'utilisateur SSH sur ns1\n10: #   NS1_ZONE_FILE   : chemin du fichier de zone, ex. /var/named/only.fr\n11: #   NS1_ZONE_NAME   : nom de la zone, ex. only.fr\n12: set -euo pipefail\n13: \n14: : \"${NS1_SSH_ALIAS:?NS1_SSH_ALIAS non défini}\"\n15: : \"${NS1_DNS_HOST:?NS1_DNS_HOST non défini}\"\n16: : \"${NS1_SUDO_PASS:?NS1_SUDO_PASS non défini}\"\n17: : \"${NS1_ZONE_FILE:?NS1_ZONE_FILE non défini}\"\n18: : \"${NS1_ZONE_NAME:?NS1_ZONE_NAME non défini}\"\n19: : \"${CERTBOT_DOMAIN:?CERTBOT_DOMAIN non défini}\"\n20: : \"${CERTBOT_VALIDATION:?CERTBOT_VALIDATION non défini}\"\n21: \n22: if [ \"${CERTBOT_DOMAIN}\" = \"${NS1_ZONE_NAME}\" ]; then\n23:   label=\"_acme-challenge\"\n24: else\n25:   relative=\"${CERTBOT_DOMAIN%.${NS1_ZONE_NAME}}\"\n26:   label=\"_acme-challenge.${relative}\"\n27: fi\n28: \n29: printf '%s\\n' \"${NS1_SUDO_PASS}\" | ssh \"${NS1_SSH_ALIAS}\" \\\n30:   \"sudo -S ${NS1_ADMIN_HOME:-/home/admin}/acme-zone-update.sh add '${label}' '${NS1_ZONE_FILE}' '${NS1_ZONE_NAME}' '${CERTBOT_VALIDATION}'\" \\\n31:   2>/dev/null\n32: \n33: # Attendre la propagation. NE PAS se contenter d'interroger le maître\n34: # interne (NS1_DNS_HOST) : il a la donnée immédiatement par définition\n35: # (c'est la source), ça ne prouve rien sur ce que voit Let's Encrypt, qui\n36: # interroge les secondaires PUBLICS (ns1/ns2.outremer-telecom.fr). Le port\n37: # 53 public n'est pas joignable depuis ce réseau d'entreprise (pare-feu) —\n38: # on vérifie donc via DNS-over-HTTPS (HTTPS classique, port 443).\n39: #\n40: # Un seul résolveur qui répond correctement UNE fois ne suffit pas : cet\n41: # ISP a une infra régionale multi-territoires (Martinique, Guadeloupe,\n42: # Réunion, Guyane, Mayotte...), probablement plusieurs instances physiques\n43: # derrière ns1/ns2 dont la convergence n'est pas parfaitement synchrone —\n44: # constaté en test réel (un domaine validé correctement, un autre juste\n45: # après a échoué avec l'ancienne valeur résiduelle malgré une confirmation\n46: # DoH positive). On exige donc : deux résolveurs publics indépendants\n47: # d'accord (Google + Cloudflare), sur plusieurs passages consécutifs, plus\n48: # une marge de sécurité avant de rendre la main à certbot.\n49: check_both_resolvers() {\n50:   g=\"$(curl -s \"https://dns.google/resolve?name=${label}.${NS1_ZONE_NAME}.&type=TXT\" \\\n51:     | jq -r '.Answer[]?.data // empty' | tr -d '\"')\"\n52:   c=\"$(curl -s -H 'accept: application/dns-json' \\\n53:     \"https://cloudflare-dns.com/dns-query?name=${label}.${NS1_ZONE_NAME}.&type=TXT\" \\\n54:     | jq -r '.Answer[]?.data // empty' | tr -d '\"')\"\n55:   [ \"${g}\" = \"${CERTBOT_VALIDATION}\" ] && [ \"${c}\" = \"${CERTBOT_VALIDATION}\" ]\n56: }\n57: \n58: required_consecutive=3\n59: consecutive_ok=0\n60: for i in $(seq 1 40); do\n61:   if check_both_resolvers; then\n62:     consecutive_ok=$((consecutive_ok + 1))\n63:     if [ \"${consecutive_ok}\" -ge \"${required_consecutive}\" ]; then\n64:       # Marge supplémentaire pour laisser converger d'éventuels nœuds\n65:       # secondaires additionnels que ni Google ni Cloudflare n'ont interrogés.\n66:       sleep 15\n67:       exit 0\n68:     fi\n69:   else\n70:     consecutive_ok=0\n71:   fi\n72:   sleep 5\n73: done\n74: \n75: echo \"Timeout en attendant la propagation publique convergente (DoH, double résolveur) du TXT ${label}.${NS1_ZONE_NAME}.\" >&2\n76: exit 1\n77: \nThe above content shows the entire, complete file contents of the requested file.\n"}
