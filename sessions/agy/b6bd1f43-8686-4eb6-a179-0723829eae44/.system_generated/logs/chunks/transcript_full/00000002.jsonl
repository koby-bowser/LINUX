{"step_index":171,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T11:11:25Z","content":"Created At: 2026-09-28T15:11:25+04:00\nCompleted At: 2026-09-28T15:11:25+04:00\n\nThe command exited with code 0.\nOutput:\n<truncated 1 lines>\n+      become: false\r\n+      ansible.builtin.command: >-\r\n+        scp {{ playbook_dir }}/files/ns1-hooks/acme-zone-update.sh\r\n+        {{ vault_ns1_ssh_alias }}:{{ vault_ns1_admin_home | default('/home/admin') }}/acme-zone-update.sh\r\n+      changed_when: true\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    - name: Rendre le script distant exécutable sur ns1\r\n+      become: false\r\n+      ansible.builtin.command: >-\r\n+        ssh {{ vault_ns1_ssh_alias }} chmod +x {{ vault_ns1_admin_home | default('/home/admin') }}/acme-zone-update.sh\r\n+      changed_when: true\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    - name: Déployer le script de découverte de zone sur ns1 (mode ad-hoc)\r\n+      become: false\r\n+      ansible.builtin.command: >-\r\n+        scp {{ playbook_dir }}/files/ns1-hooks/find-zone.sh\r\n+        {{ vault_ns1_ssh_alias }}:{{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh\r\n+      changed_when: true\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    - name: Rendre le script de découverte de zone exécutable sur ns1\r\n+      become: false\r\n+      ansible.builtin.command: >-\r\n+        ssh {{ vault_ns1_ssh_alias }} chmod +x {{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh\r\n+      changed_when: true\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    # certbot (plus loin dans ce playbook) tourne en root et invoque nos\r\n+    # hooks --manual, qui font \"ssh ${NS1_SSH_ALIAS}\" — il faut donc que\r\n+    # root ait AUSSI la clé et l'alias ns1, pas seulement koby.\r\n+    - name: Provisionner le ~/.ssh de root avec la clé et l'alias ns1 (pour les hooks certbot)\r\n+      ansible.builtin.copy:\r\n+        src: \"{{ item.src }}\"\r\n+        dest: \"{{ item.dest }}\"\r\n+        mode: \"{{ item.mode }}\"\r\n+        owner: root\r\n+        group: root\r\n+        remote_src: true\r\n+      loop:\r\n+        - { src: \"/home/koby/.ssh/id_rsa\", dest: \"/root/.ssh/id_rsa\", mode: '0600' }\r\n+        - { src: \"/home/koby/.ssh/id_rsa.pub\", dest: \"/root/.ssh/id_rsa.pub\", mode: '0644' }\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    - name: S'assurer que le ~/.ssh de root a les bonnes permissions de répertoire\r\n+      ansible.builtin.file:\r\n+        path: /root/.ssh\r\n+        state: directory\r\n+        mode: '0700'\r\n+        owner: root\r\n+        group: root\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    - name: Ajouter l'alias ns1 au ~/.ssh/config de root, s'il n'y est pas déjà\r\n+      ansible.builtin.blockinfile:\r\n+        path: /root/.ssh/config\r\n+        create: true\r\n+        mode: '0600'\r\n+        owner: root\r\n+        group: root\r\n+        marker: \"# {mark} ANSIBLE MANAGED BLOCK - alias ns1\"\r\n+        block: |\r\n+          Host {{ vault_ns1_ssh_alias }}\r\n+              HostName {{ vault_ns1_dns_host }}\r\n+              User admin\r\n+              IdentityFile /root/.ssh/id_rsa\r\n+              HostKeyAlgorithms +ssh-rsa\r\n+              PubkeyAcceptedAlgorithms +ssh-rsa\r\n+              IdentitiesOnly yes\r\n+              StrictHostKeyChecking accept-new\r\n+      when: ssh_zonefile_needed\r\n+      tags: [always]\r\n+\r\n+    # --- Mode ad-hoc : découverte de la zone ns1 pour cert_domain ---\r\n+    - name: \"[ad-hoc] Découvrir la zone ns1 hébergeant {{ cert_domain | default('') }}\"\r\n+      become: false\r\n+      ansible.builtin.command:\r\n+        cmd: >-\r\n+          ssh {{ vault_ns1_ssh_alias }}\r\n+          \"sudo -S {{ vault_ns1_admin_home | default('/home/admin') }}/find-zone.sh {{ cert_domain }}\"\r\n+        stdin: \"{{ vault_ns1_sudo_password }}\"\r\n+      register: ns1_zone_lookup\r\n+      changed_when: false\r\n+      failed_when: false\r\n+      no_log: true\r\n+      when: cert_domain is defined\r\n+      tags: [always]\r\n+\r\n+    - name: \"[ad-hoc] Échouer si aucune zone ns1 ne contient {{ cert_domain | default('') }}\"\r\n+      ansible.builtin.fail:\r\n+        msg: >-\r\n+          Aucune zone trouvée sur ns1 pour {{ cert_domain }} :\r\n+          {{ ns1_zone_lookup.stderr | default('sortie indisponible') }}\r\n+      when: cert_domain is defined and ns1_zone_lookup.rc | default(1) != 0\r\n+      tags: [always]\r\n+\r\n+    - name: \"[ad-hoc] Extraire zone/fichier depuis la sortie de find-zone.sh\"\r\n+      ansible.builtin.set_fact:\r\n+        ns1_zone_parts: \"{{ ns1_zone_lookup.stdout.split('\\t') }}\"\r\n+      when: cert_domain is defined and ns1_zone_lookup.rc == 0\r\n+      tags: [always]\r\n+\r\n+    - name: \"[ad-hoc] Construire l'entrée de certificat pour {{ cert_domain | default('') }}\"\r\n+      ansible.builtin.set_fact:\r\n+        active_certificates: >-\r\n+          {{ [{\r\n+            'domain': cert_domain,\r\n+            'extra_sans': [],\r\n+            'dns_backend': 'ssh_zonefile',\r\n+            'zone': ns1_zone_parts[0],\r\n+            'zone_file': ns1_zone_parts[1],\r\n+            'target_host': adhoc_target_host | default('CHANGEME'),\r\n+            'webserver': adhoc_webserver | default('nginx'),\r\n+            'service_name': adhoc_service_name | default('nginx'),\r\n+            'cert_dest_dir': adhoc_cert_dest_dir | default('/etc/nginx/ssl/' + cert_domain),\r\n+          }] }}\r\n+      when: cert_domain is defined and ns1_zone_lookup.rc == 0\r\n+      tags: [always]\r\n+\r\n+    - name: \"[ad-hoc] Zone découverte pour {{ cert_domain | default('') }}\"\r\n+      ansible.builtin.debug:\r\n+        msg: \"{{ cert_domain }} -> zone {{ active_certificates[0].zone }} ({{ active_certificates[0].zone_file }})\"\r\n+      when: cert_domain is defined\r\n+      tags: [always]\r\n+\r\n+  tasks:\r\n+    - name: Émettre/renouveler les certificats — backend rfc2136 (ns1/BIND)\r\n+      ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\r\n+      loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'rfc2136') | list }}\"\r\n+      loop_control:\r\n+        loop_var: cert\r\n+      vars:\r\n+        cert_backend_args: >-\r\n+          --dns-rfc2136\r\n+          --dns-rfc2136-credentials /root/.secrets/certbot/rfc2136.ini\r\n+          --dns-rfc2136-propagation-seconds 30\r\n+      tags: [issue]\r\n+\r\n+    - name: Émettre/renouveler les certificats — backend powerdns (dnsp-mst)\r\n+      ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\r\n+      loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'powerdns') | list }}\"\r\n+      loop_control:\r\n+        loop_var: cert\r\n+      vars:\r\n+        cert_backend_args: >-\r\n+          --manual --preferred-challenges dns\r\n+          --manual-auth-hook /root/.secrets/certbot/pdns-auth-hook.sh\r\n+          --manual-cleanup-hook /root/.secrets/certbot/pdns-cleanup-hook.sh\r\n+        cert_env:\r\n+          PDNS_API_URL: \"{{ vault_powerdns_api_url }}\"\r\n+          PDNS_API_KEY: \"{{ vault_powerdns_api_key }}\"\r\n+          PDNS_DNS_HOST: \"{{ vault_powerdns_dns_host }}\"\r\n+      tags: [issue]\r\n+\r\n+    - name: Émettre/renouveler les certificats — backend ssh_zonefile (ns1/BIND, édition manuelle)\r\n+      ansible.builtin.include_tasks: tasks/issue_and_queue_cert.yml\r\n+      loop: \"{{ active_certificates | selectattr('dns_backend', 'equalto', 'ssh_zonefile') | list }}\"\r\n+      loop_control:\r\n+        loop_var: cert\r\n+      vars:\r\n+        cert_backend_args: >-\r\n+          --manual --preferred-challenges dns\r\n+          --manual-auth-hook /root/.secrets/certbot/ns1-zonefile-auth-hook.sh\r\n+          --manual-cleanup-hook /root/.secrets/certbot/ns1-zonefile-cleanup-hook.sh\r\n+        cert_env:\r\n+          NS1_SSH_ALIAS: \"{{ vault_ns1_ssh_alias }}\"\r\n+          NS1_DNS_HOST: \"{{ vault_ns1_dns_host }}\"\r\n+          NS1_SUDO_PASS: \"{{ vault_ns1_sudo_password }}\"\r\n+          NS1_ZONE_FILE: \"{{ cert.zone_file }}\"\r\n+          NS1_ZONE_NAME: \"{{ cert.zone }}\"\r\n+      tags: [issue]\r\n+\r\n+    - name: Résumé des certificats traités\r\n+      ansible.builtin.debug:\r\n+        var: certs_deploy_queue\r\n+      tags: [issue, deploy]\r\n+\r\n+    - name: Déployer le certificat et recharger le webserver (uniquement si changé)\r\n+      ansible.builtin.include_tasks: tasks/deploy_and_reload_cert.yml\r\n+      loop: \"{{ certs_deploy_queue | default([]) | selectattr('changed', 'equalto', true) | list }}\"\r\n+      loop_control:\r\n+        loop_var: deploy_item\r\n+      tags: [deploy]\r\n\n"}
