{"step_index":133,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T11:02:40Z","content":"Created At: 2026-09-28T15:02:40+04:00\nCompleted At: 2026-09-28T15:02:40+04:00\nFile Path: `file:///home/koby/LINUX/playbooks/files/certbot-hooks/pdns-auth-hook.sh`\nTotal Lines: 74\nTotal Bytes: 2377\nShowing lines 1 to 74\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env bash\n2: # Hook d'authentification DNS-01 pour certbot --manual — backend PowerDNS (th2-dnsp-mst1).\n3: # Utilise SSH passwordless vers superuser@172.30.198.162:30 et pdnsutil.\n4: set -euo pipefail\n5: \n6: : \"${CERTBOT_DOMAIN:?CERTBOT_DOMAIN non défini}\"\n7: : \"${CERTBOT_VALIDATION:?CERTBOT_VALIDATION non défini}\"\n8: \n9: # Déterminer la zone PowerDNS et le label relatif\n10: if [[ \"${CERTBOT_DOMAIN}\" =~ outremer-telecom\\.fr$ ]]; then\n11:   ZONE=\"outremer-telecom.fr\"\n12: elif [[ \"${CERTBOT_DOMAIN}\" =~ redcaraibe\\.fr$ ]]; then\n13:   ZONE=\"redcaraibe.fr\"\n14: elif [[ \"${CERTBOT_DOMAIN}\" =~ sfrcaraibe\\.fr$ ]]; then\n15:   ZONE=\"sfrcaraibe.fr\"\n16: elif [[ \"${CERTBOT_DOMAIN}\" =~ only\\.fr$ ]]; then\n17:   ZONE=\"only.fr\"\n18: else\n19:   ZONE=\"${CERTBOT_DOMAIN}\"\n20: fi\n21: \n22: if [ \"${CERTBOT_DOMAIN}\" = \"${ZONE}\" ]; then\n23:   LABEL=\"_acme-challenge\"\n24: else\n25:   RELATIVE=\"${CERTBOT_DOMAIN%.${ZONE}}\"\n26:   LABEL=\"_acme-challenge.${RELATIVE%.}\"\n27: fi\n28: \n29: PDNS_HOST=\"${PDNS_DNS_HOST:-172.30.198.162}\"\n30: SSH_USER=\"superuser\"\n31: SSH_PORT=\"30\"\n32: \n33: # 1. Écriture du TXT et bump serial sur le master PowerDNS via pdnsutil\n34: ssh -p \"${SSH_PORT}\" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \"${SSH_USER}@${PDNS_HOST}\" \\\n35:   \"sudo pdnsutil replace-rrset '${ZONE}' '${LABEL}' TXT 60 '\\\"${CERTBOT_VALIDATION}\\\"' && sudo pdnsutil increase-serial '${ZONE}'\"\n36: \n37: # 2. Vérification de la propagation\n38: FULL_RECORD=\"${LABEL}.${ZONE}\"\n39: \n40: check_both_resolvers() {\n41:   local g c\n42:   g=\"$(curl -s \"https://dns.google/resolve?name=${FULL_RECORD}.&type=TXT\" \\\n43:     | jq -r '.Answer[]?.data // empty' 2>/dev/null | tr -d '\"')\"\n44:   c=\"$(curl -s -H 'accept: application/dns-json' \\\n45:     \"https://cloudflare-dns.com/dns-query?name=${FULL_RECORD}.&type=TXT\" \\\n46:     | jq -r '.Answer[]?.data // empty' 2>/dev/null | tr -d '\"')\"\n47:   [ \"${g}\" = \"${CERTBOT_VALIDATION}\" ] && [ \"${c}\" = \"${CERTBOT_VALIDATION}\" ]\n48: }\n49: \n50: required_consecutive=2\n51: consecutive_ok=0\n52: for i in $(seq 1 30); do\n53:   if check_both_resolvers; then\n54:     consecutive_ok=$((consecutive_ok + 1))\n55:     if [ \"${consecutive_ok}\" -ge \"${required_consecutive}\" ]; then\n56:       sleep 5\n57:       exit 0\n58:     fi\n59:   else\n60:     consecutive_ok=0\n61:   fi\n62:   sleep 4\n63: done\n64: \n65: # Repli : vérification directe sur le master autoritaire\n66: local_found=\"$(dig +short TXT \"${FULL_RECORD}\" @\"${PDNS_HOST}\" 2>/dev/null | tr -d '\"')\"\n67: if [ \"${local_found}\" = \"${CERTBOT_VALIDATION}\" ]; then\n68:   sleep 20\n69:   exit 0\n70: fi\n71: \n72: echo \"Timeout en attendant la propagation du TXT ${FULL_RECORD}\" >&2\n73: exit 1\n74: \nThe above content shows the entire, complete file contents of the requested file.\n"}
