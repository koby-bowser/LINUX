{"step_index":114,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T10:48:26Z","content":"Created At: 2026-09-28T14:48:26+04:00\nCompleted At: 2026-09-28T14:48:26+04:00\nFile Path: `file:///home/koby/infra-management-system/playbooks/issue-le-cert.yml`\nTotal Lines: 693\nTotal Bytes: 39095\nShowing lines 1 to 693\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # Émet / renouvelle un certificat PUBLIC Let's Encrypt par DNS-01 (API PowerDNS),\n3: # depuis un runner Semaphore (CORP ou PROD, selon lequel joint l'API PowerDNS —\n4: # cf. playbooks/check-le-runner.yml pour valider avant de choisir) — remplace\n5: # l'émission manuelle depuis le poste décrite dans scripts/acme/README.md\n6: # (même hook, mêmes zones/alias).\n7: #\n8: # PÉRIMÈTRE : vhosts publics `.fr` (retractation SFR/RED/LPM ; formation\n9: # drive_omt ; ipsfdev/identity/des.sfrcaraibe.fr, servis par un host hors-IaC\n10: # — 92_GBS-LBNG-01 — émission seulement, déploiement hors périmètre). Le `:80`\n11: # entrant étant fermé depuis Internet, on émet par DNS-01 (aucun port entrant\n12: # requis).\n13: #\n14: # Ce playbook NE TOUCHE AUCUN HÔTE DE PROD : il tourne en localhost sur le\n15: # runner (émission uniquement, écriture dans son propre workspace). Le dépôt\n16: # du bundle sur les frontaux reste une action SÉPARÉE et validée\n17: # (playbooks/deploy-tls-bundle.yml, template 38).\n18: #\n19: # Si exécuté sur le runner CORP (token repo en lecture seule, pas d'accès aux\n20: # frontaux) : le bundle produit reste dans le workspace du job, affiché en\n21: # sortie pour être recopié et committé DEPUIS LE POSTE (branche + MR).\n22: #\n23: # Idempotent : `--keep-until-expiring` ne réémet que si le cert n'existe pas ou\n24: # expire dans moins de 30 j -> rejouer ce même playbook = renouvellement.\n25: #\n26: #   # test SANS TOUCHER À LA PROD (FQDN dédié, jamais servi/déployé) :\n27: #   ansible-playbook -i inventories/corp playbooks/issue-le-cert.yml \\\n28: #     -e le_target=test -e certbot_staging=true\n29: #\n30: #   # émission / renouvellement réel (DOMAINE PROD RÉEL, cf. avertissement ci-dessous) :\n31: #   ansible-playbook -i inventories/corp playbooks/issue-le-cert.yml \\\n32: #     -e le_target=red -e certbot_staging=false\n33: #\n34: # Jouer playbooks/check-le-runner.yml AVANT (joignabilité PowerDNS/ACME, vault).\n35: #\n36: # ⚠ le_target=red|sfr_retractation|lpm|api_selfcare|drive_omt|ipsfdev|identity|des cible un FQDN PROD\n37: # RÉEL déjà en service. Une émission DNS-01 pose un TXT dans la zone PowerDNS\n38: # de ce domaine — ne JAMAIS lancer ces cibles pour un simple test de flux.\n39: # Utiliser le_target=test (FQDN dédié, jamais déployé) pour valider la\n40: # chaîne complète sans aucun risque sur la prod en place. Le défaut\n41: # ci-dessous est délibérément \"test\", pas un domaine réel.\n42: #\n43: # ⚠ ipsfdev/identity/des : le CNAME statique _acme-challenge.<fqdn> ->\n44: # _acme-<key>.redcaraibe.fr doit être posé sur ns1 (BIND legacy) AVANT toute\n45: # émission réelle (sinon NXDOMAIN sur le challenge DNS-01) — cf. le même\n46: # alias déjà en place pour \"sfr_retractation\"/\"lpm\".\n47: #\n48: # ⚠ doccli : cible multi-SAN (fqdn + extra_domains). Chaque nom a besoin de SON\n49: # PROPRE CNAME distinct sur ns1 (_acme-challenge.doccli.sfrcaraibe.fr ->\n50: # _acme-doccli.redcaraibe.fr, ET _acme-challenge.doccli.api.sfrcaraibe.fr ->\n51: # _acme-doccli-api.redcaraibe.fr) — jamais le même, sinon les deux challenges\n52: # DNS-01 s'écrasent pendant l'émission (cf. PDNS_TXT_NAME_MAP plus bas).\n53: - name: Émettre / renouveler un certificat public Let's Encrypt (DNS-01 PowerDNS)\n54:   hosts: localhost\n55:   connection: local\n56:   become: false\n57:   gather_facts: false\n58:   vars:\n59:     le_email: \"l.rangon@outremer-telecom.fr\"\n60:     certbot_staging: true\n61:     # Sélection opérateur : test | red | sfr_retractation | lpm | all. Le détail zone/alias\n62:     # CNAME reste dans ce map, l'opérateur ne saisit qu'un token connu (survey\n63:     # Semaphore). Défaut délibérément \"test\" (aucun impact prod) : \"all\" et\n64:     # les 3 marques réelles doivent être choisis EXPLICITEMENT.\n65:     le_target: test\n66:     le_targets_map:\n67:       test:\n68:         # FQDN de test dédié, jamais servi ni déployé sur un frontal — ne\n69:         # touche à aucun cert prod en place. Zone redcaraibe.fr = PowerDNS\n70:         # direct (comme RED), TXT direct sans alias CNAME nécessaire.\n71:         fqdn: test-le-cert.redcaraibe.fr\n72:         pdns_zone: redcaraibe.fr\n73:         pdns_txt_name: \"\"\n74:       red:\n75:         fqdn: retractation.redcaraibe.fr\n76:         pdns_zone: redcaraibe.fr\n77:         pdns_txt_name: \"\"\n78:       sfr_retractation:\n79:         fqdn: retractation.sfrcaraibe.fr\n80:         pdns_zone: redcaraibe.fr\n81:         pdns_txt_name: _acme-sfr.redcaraibe.fr\n82:       lpm:\n83:         fqdn: retractation.lapostemobile.sfrcaraibe.fr\n84:         pdns_zone: redcaraibe.fr\n85:         pdns_txt_name: _acme-lpm.redcaraibe.fr\n86:       api_selfcare:\n87:         # MEP front-controller api.selfcarebusiness.sfrcaraibe.fr (PROD) : même famille\n88:         # que sfr_retractation/lpm — zone sfrcaraibe.fr sur ns1 (BIND legacy), alias CNAME\n89:         # statique déjà posé (_acme-challenge.api.selfcarebusiness.sfrcaraibe.fr ->\n90:         # _acme-apiselfcare.redcaraibe.fr).\n91:         fqdn: api.selfcarebusiness.sfrcaraibe.fr\n92:         pdns_zone: redcaraibe.fr\n93:         pdns_txt_name: _acme-apiselfcare.redcaraibe.fr\n94:       stats_sfrcaraibe:\n95:         # stats.sfrcaraibe.com (Matomo, trp-wextp-stat1, hors IaC) — même famille que\n96:         # sfr_retractation/lpm/api_selfcare : zone sfrcaraibe.com sur ns1 (BIND legacy),\n97:         # alias CNAME statique requis sur ns1 avant toute émission réelle :\n98:         #   _acme-challenge.stats.sfrcaraibe.com -> _acme-stats.redcaraibe.fr\n99:         # Contourne le blocage réseau HTTP-01 constaté sur trp-wextp-stat1 (aucun accès\n100:         # sortant fiable vers l'API ACME depuis cet hôte) : DNS-01 ne requiert aucun accès\n101:         # réseau depuis/vers ce host, seulement depuis le runner qui joue ce playbook.\n102:         # Déploiement du bundle émis : PAS via deploy-tls-bundle/nginx_vhost_php (vhost\n103:         # matomo.conf hors IaC, chemins certbot en dur /etc/letsencrypt/live/...) — action\n104:         # séparée dédiée.\n105:         fqdn: stats.sfrcaraibe.com\n106:         pdns_zone: redcaraibe.fr\n107:         pdns_txt_name: _acme-stats.redcaraibe.fr\n108:       drive_omt:\n109:         # Cible de formation (TP équipe INFRA) : domaine réel déjà servi, zone\n110:         # outremer-telecom.fr déjà hébergée sur le même master PowerDNS que\n111:         # redcaraibe.fr (SOA-EDIT-API actif, cf. scripts/acme/README.md) ->\n112:         # TXT direct, pas d'alias CNAME nécessaire, comme \"red\".\n113:         fqdn: drive.outremer-telecom.fr\n114:         pdns_zone: outremer-telecom.fr\n115:         pdns_txt_name: \"\"\n116:       ipsfdev:\n117:         # Domaine réel servi par un host hors-IaC (92_GBS-LBNG-01, absent de ce\n118:         # repo — même famille que gbs-frontweb-02/drive.outremer-telecom.fr).\n119:         # Zone sfrcaraibe.fr = BIND legacy (pas PowerDNS) -> alias CNAME\n120:         # statique requis sur ns1 (_acme-challenge.ipsfdev.sfrcaraibe.fr ->\n121:         # _acme-ipsfdev.redcaraibe.fr), comme pour \"sfr_retractation\"/\"lpm\". Émission\n122:         # uniquement ici : le déploiement sur GBS-LBNG-01 est hors périmètre\n123:         # de ce playbook (host non géré par ce repo).\n124:         fqdn: ipsfdev.sfrcaraibe.fr\n125:         pdns_zone: redcaraibe.fr\n126:         pdns_txt_name: _acme-ipsfdev.redcaraibe.fr\n127:       identity:\n128:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus.\n129:         fqdn: identity.sfrcaraibe.fr\n130:         pdns_zone: redcaraibe.fr\n131:         pdns_txt_name: _acme-identity.redcaraibe.fr\n132:       des:\n133:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus.\n134:         fqdn: des.sfrcaraibe.fr\n135:         pdns_zone: redcaraibe.fr\n136:         pdns_txt_name: _acme-des.redcaraibe.fr\n137:       webapp:\n138:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus (zone sfrcaraibe.fr = BIND\n139:         # legacy, alias CNAME statique requis sur ns1 avant toute émission réelle :\n140:         # _acme-challenge.webapp.sfrcaraibe.fr -> _acme-webapp.redcaraibe.fr). Onboarding\n141:         # PROD webapp.sfrcaraibe.fr sur trp-wextp-afe1, cert dédié distinct du legacy\n142:         # (cf. host_vars/trp-wextp-afe1/webapp.yml, vhost_ssl_cert_path).\n143:         fqdn: webapp.sfrcaraibe.fr\n144:         pdns_zone: redcaraibe.fr\n145:         pdns_txt_name: _acme-webapp.redcaraibe.fr\n146:       doccli:\n147:         # Même host/zone/contrainte que \"ipsfdev\" ci-dessus (zone sfrcaraibe.fr = BIND\n148:         # legacy, alias CNAME statique requis sur ns1 avant toute émission réelle :\n149:         # _acme-challenge.doccli.sfrcaraibe.fr -> _acme-doccli.redcaraibe.fr). Onboarding\n150:         # PROD doccli.sfrcaraibe.fr sur trp-wextp-afe1, cert dédié distinct du legacy\n151:         # (cf. host_vars/trp-wextp-afe1/doccli.yml, vhost_ssl_cert_path).\n152:         fqdn: doccli.sfrcaraibe.fr\n153:         pdns_zone: redcaraibe.fr\n154:         pdns_txt_name: _acme-doccli.redcaraibe.fr\n155:         # doccli.api.sfrcaraibe.fr est servi par LE MÊME bloc nginx que doccli.sfrcaraibe.fr\n156:         # (vhost_extra_server_names, cf. host_vars/trp-wextp-afe1/doccli.yml) — donc LE MÊME\n157:         # cert (vhost_ssl_cert_path). Sans ce SAN, le navigateur reçoit le cert de\n158:         # doccli.sfrcaraibe.fr en visitant doccli.api.sfrcaraibe.fr -> NET::ERR_CERT_\n159:         # COMMON_NAME_INVALID (constaté le 03/08/26, juste après la bascule live). Ce nom a\n160:         # besoin de SON PROPRE alias CNAME sur ns1 (distinct de celui de doccli.sfrcaraibe.fr,\n161:         # sinon les deux challenges DNS-01 s'écraseraient l'un l'autre pendant l'émission —\n162:         # cf. commentaire PDNS_TXT_NAME_MAP ci-dessous) :\n163:         #   _acme-challenge.doccli.api.sfrcaraibe.fr -> _acme-doccli-api.redcaraibe.fr\n164:         extra_domains:\n165:           - fqdn: doccli.api.sfrcaraibe.fr\n166:             pdns_txt_name: _acme-doccli-api.redcaraibe.fr\n167:       ios:\n168:         # Même host/zone/contrainte que \"ios\" ci-dessus.\n169:         fqdn: ios.outremer-telecom.fr\n170:         pdns_zone: outremer-telecom.fr\n171:         pdns_txt_name: \"\"\n172:       aota:\n173:         # Même host/zone/contrainte que \"aota\" ci-dessus.\n174:         fqdn: aota.outremer-telecom.fr\n175:         pdns_zone: outremer-telecom.fr\n176:         pdns_txt_name: \"\"\n177:       postfix:\n178:         # Même host/zone/contrainte que ios/aota — MX/SMTP-TLS mtq-mailsrvp-01,\n179:         # pas un vhost nginx, déploiement hors périmètre de ce playbook.\n180:         fqdn: postfix.outremer-telecom.fr\n181:         pdns_zone: outremer-telecom.fr\n182:         pdns_txt_name: \"\"\n183:       onetask:\n184:         # FQDN public Altice/OMT, zone outremer-telecom.fr hébergée sur le master\n185:         # PowerDNS th2-dnsp-mst1 (SOA-EDIT-API actif) -> TXT direct, pas d'alias\n186:         # CNAME nécessaire (cf. scripts/acme/README.md).\n187:         fqdn: onetask.outremer-telecom.fr\n188:         pdns_zone: outremer-telecom.fr\n189:         pdns_txt_name: \"\"\n190:       andesite:\n191:         # Correctif 02/09/2026 : l'hypothèse initiale (zone only.fr sur le même\n192:         # master PowerDNS que outremer-telecom.fr/redcaraibe.fr, TXT direct)\n193:         # était fausse — un run staging a échoué avec un 404 PowerDNS sur\n194:         # PATCH .../zones/only.fr. (zone absente de PowerDNS). only.fr est en\n195:         # BIND legacy sur ns1, malgré un nom d'hôte NS partagé avec\n196:         # outremer-telecom.fr — même famille que sfrcaraibe.fr/sfrcaraibe.com\n197:         # (cf. sfr_retractation/lpm/api_selfcare/ipsfdev/identity/des/webapp/\n198:         # doccli ci-dessus). Alias CNAME statique posé sur ns1 (02/09/2026) :\n199:         #   _acme-challenge.andesite.only.fr -> _acme-andesite.redcaraibe.fr\n200:         # Déploiement du bundle sur l'hôte servant andesite.only.fr : hors\n201:         # périmètre de ce playbook.\n202:         fqdn: andesite.only.fr\n203:         pdns_zone: redcaraibe.fr\n204:         pdns_txt_name: _acme-andesite.redcaraibe.fr\n205:       vvggpe:\n206:         # VVG Guadeloupe (gpe-stwdp-vvg1, hors-IaC).\n207:         # Zone sfrcaraibe.fr = BIND legacy (pas PowerDNS) -> alias CNAME\n208:         # statique requis sur ns1 (_acme-challenge.vvggpe.sfrcaraibe.fr ->\n209:         # _acme-vvggpe.redcaraibe.fr), comme pour sfr_retractation/lpm/webapp/doccli.\n210:         # Déploiement du bundle sur gpe-stwdp-vvg1 : hors périmètre de ce playbook\n211:         # (déploiement manuel).\n212:         fqdn: vvggpe.sfrcaraibe.fr\n213:         pdns_zone: redcaraibe.fr\n214:         pdns_txt_name: _acme-vvggpe.redcaraibe.fr\n215:       vvgguy:\n216:         # VVG Guyane (guy-stwdp-vvg1, hors-IaC).\n217:         # Zone sfrcaraibe.fr = BIND legacy (pas PowerDNS) -> alias CNAME\n218:         # statique requis sur ns1 (_acme-challenge.vvgguy.sfrcaraibe.fr ->\n219:         # _acme-vvgguy.redcaraibe.fr), comme pour vvggpe/sfr_retractation/lpm/webapp/doccli.\n220:         # Déploiement du bundle sur guy-stwdp-vvg1 : hors périmètre de ce playbook\n221:         # (déploiement manuel).\n222:         fqdn: vvgguy.sfrcaraibe.fr\n223:         pdns_zone: redcaraibe.fr\n224:         pdns_txt_name: _acme-vvgguy.redcaraibe.fr\n225:       vvgmtq:\n226:         # VVG Martinique (mtq-stwdp-vvg1, hors-IaC).\n227:         # Zone sfrcaraibe.fr = BIND legacy (pas PowerDNS) -> alias CNAME\n228:         # statique requis sur ns1 (_acme-challenge.vvgmtq.sfrcaraibe.fr ->\n229:         # _acme-vvgmtq.redcaraibe.fr), comme pour vvggpe/sfr_retractation/lpm/webapp/doccli.\n230:         # Déploiement du bundle sur mtq-stwdp-vvg1 : hors périmètre de ce playbook\n231:         # (déploiement manuel).\n232:         fqdn: vvgmtq.sfrcaraibe.fr\n233:         pdns_zone: redcaraibe.fr\n234:         pdns_txt_name: _acme-vvgmtq.redcaraibe.fr\n235:     # \"all\" ne couvre QUE les 3 marques réelles (jamais \"test\", qui doit\n236:     # rester un choix explicite et jamais un élément d'un run groupé).\n237:     le_selected: >-\n238:       {{ ([le_targets_map.red, le_targets_map.sfr_retractation, le_targets_map.lpm]) if le_target == 'all'\n239:          else [ le_targets_map[le_target] ] }}\n240:     pdns_api_url: \"http://172.30.198.162:8081\"\n241:     # Scratch dans le workspace du job (ne touche à rien hors du clone éphémère).\n242:     le_venv: \"{{ playbook_dir }}/../.le-venv\"\n243:     le_certbot_home: \"{{ playbook_dir }}/../.le-certbot\"\n244:     # Répertoire d'état certbot séparé entre staging et réel : certbot ne sait\n245:     # pas, via --keep-until-expiring, qu'un certificat existant a été émis par\n246:     # la CA staging plutôt que la CA réelle — il ne regarde que la date\n247:     # d'expiration. Sans cette séparation, un run réel après un run staging\n248:     # trouve \"not yet due for renewal\" et NE RÉÉMET JAMAIS le vrai certificat\n249:     # (constaté le 03/07/2026 sur drive_omt : task 301 avec\n250:     # certbot_staging=false a livré... le certificat staging de la task 300).\n251:     # Suffixe explicite des DEUX côtés (staging ET réel) plutôt que\n252:     # \"réel = chemin historique non suffixé\" : l'ancien répertoire non\n253:     # suffixé contient déjà des certs staging contaminés par ce bug (avant le\n254:     # fix) — le laisser comme chemin \"réel\" aurait reproduit le même piège.\n255:     le_certbot_state_dir: \"{{ le_certbot_home }}-{{ 'staging' if certbot_staging | bool else 'real' }}\"\n256:     le_bundle_root: \"{{ playbook_dir }}/../files/tls\"\n257:     # Bundle CA système (inclut le CA interne du proxy corp inspectant le TLS).\n258:     # Requis par la lib Python \"requests\" (certbot), qui ignore le magasin\n259:     # système par défaut — cf. commentaire sur la tâche \"Lancer certbot certonly\".\n260:     le_ca_bundle: /etc/ssl/certs/ca-certificates.crt\n261:     # ── Versement automatique du bundle dans GitLab (API REST v4) ─────────────\n262:     # Supprime le copier-coller manuel des blocs base64 depuis les logs Semaphore\n263:     # (source d'erreurs de transcription : constaté le 06/08/2026 sur\n264:     # stats.sfrcaraibe.com, 2 tentatives corrompues sur la clé privée).\n265:     # Le clone git du runner est en lecture seule, mais un PAT est un canal\n266:     # INDÉPENDANT de ce clone — même principe que playbooks/generate-idemia-csr.yml.\n267:     # Mettre à false pour revenir au flux manuel (affichage base64 + instructions).\n268:     le_commit_to_gitlab: true\n269:     le_gitlab_url: \"https://gitsi.intranet.local\"\n270:     le_gitlab_project_id: \"144\"\n271:     # Branche CIBLE. Le playbook n'y pousse jamais en direct : `main` est protégée\n272:     # (push_access_levels = « No one », relevé le 06/08/2026), donc le bundle passe\n273:     # par une branche de travail le-cert/<fqdn>-<horodatage> + une MR mergée par API\n274:     # — la seule voie qui aboutisse, et elle respecte la protection.\n275:     le_gitlab_branch: main\n276:     # false = la MR est ouverte mais laissée à merger à la main (revue humaine).\n277:     le_gitlab_auto_merge: true\n278:     # Le runner clone déjà gitsi en HTTPS : la CA interne est dans son magasin système,\n279:     # et ansible.builtin.uri lit ce magasin (contrairement à certbot/requests, cf. la\n280:     # tâche certonly). Laissé à true — à ne passer à false que si un run réel échoue\n281:     # sur la validation TLS (generate-idemia-csr.yml, lui, désactive la validation).\n282:     le_gitlab_validate_certs: true\n283:   tasks:\n284:     - name: Vérifier que le_target est une clé connue\n285:       ansible.builtin.assert:\n286:         that: le_target in (le_targets_map.keys() | list) + ['all']\n287:         fail_msg: \"le_target={{ le_target }} inconnu (attendu : {{ (le_targets_map.keys() | list + ['all']) | join(', ') }})\"\n288: \n289:     - name: >-\n290:         Vérifier si le vault-id \"default\" est chargé par ce process ansible-playbook\n291:         (clé Vault Password attachée au template Semaphore) — cf. plugin\n292:         lookup_plugins/le_vault_available.py. Remplace l'ancienne détection via\n293:         ANSIBLE_VAULT_PASSWORD_FILE (constaté le 02/07/2026 : jamais exposé par\n294:         Semaphore ni en env ni en fichier, cf. docs/certs-publics-semaphore.md §7).\n295:       ansible.builtin.set_fact:\n296:         le_vault_available: \"{{ lookup('le_vault_available', 'default') }}\"\n297: \n298:     - name: >-\n299:         Échouer AVANT tout appel PowerDNS/ACME si la clé Vault Password n'est\n300:         pas attachée au template et que la cible est un domaine réel — sans ce\n301:         garde-fou, le run émettait quand même le certificat puis livrait la clé\n302:         privée EN CLAIR (suffixe .A_CHIFFRER), consommant au passage un essai\n303:         ACME pour rien sur un domaine prod réel (retractation.*.fr).\n304:       ansible.builtin.assert:\n305:         that: le_vault_available\n306:         fail_msg: >-\n307:           Aucun secret vault chargé sur ce runner — la clé Vault Password\n308:           (vault id 2) n'est probablement pas attachée au template Semaphore.\n309:           Attacher cette clé au template AVANT de relancer (cf.\n310:           docs/certs-publics-semaphore.md §7). le_target=test reste possible\n311:           sans cette clé (clé livrée en clair, à chiffrer à la main).\n312:       when: le_target != 'test'\n313: \n314:     - name: >-\n315:         Construire l'environnement proxy (uniquement les extra-vars\n316:         HTTP(S)_PROXY/NO_PROXY réellement définies et non vides — certains\n317:         runners (ex. CORP) les exposent en extra-vars, d'autres (ex. PROD) ont\n318:         déjà le proxy en env OS ambiant : ne jamais écraser ce dernier par '')\n319:       ansible.builtin.set_fact:\n320:         le_proxy_env: \"{{ le_proxy_env | default({}) | combine({item.key: item.value}) }}\"\n321:       loop:\n322:         - {key: http_proxy, value: \"{{ HTTP_PROXY | default('') }}\"}\n323:         - {key: https_proxy, value: \"{{ HTTPS_PROXY | default('') }}\"}\n324:         - {key: no_proxy, value: \"{{ NO_PROXY | default('') }}\"}\n325:       loop_control:\n326:         label: \"{{ item.key }}\"\n327:       when: item.value | length > 0\n328: \n329:     - name: Charger la clé API PowerDNS (vault id 2)\n330:       ansible.builtin.include_vars:\n331:         file: \"{{ playbook_dir }}/../scripts/acme/pdns_api_vault.yml\"\n332:       no_log: true\n333: \n334:     - name: >-\n335:         Diagnostic — lire un éventuel log certbot laissé par une exécution\n336:         précédente dans ce même workspace (Semaphore réutilise le répertoire\n337:         par template) ; purement informatif, ne bloque jamais le run\n338:       ansible.builtin.slurp:\n339:         src: \"{{ le_certbot_state_dir }}/logs/letsencrypt.log\"\n340:       register: _le_prev_log\n341:       failed_when: false\n342: \n343:     - name: Afficher les 60 dernières lignes du log précédent (clé API masquée)\n344:       ansible.builtin.debug:\n345:         msg: >-\n346:           {{ (_le_prev_log.content | b64decode).split('\\n')[-60:]\n347:              | map('replace', pdns_api_key, '***REDACTED***') | list }}\n348:       when: _le_prev_log.content is defined\n349: \n350:     - name: Vérifier la présence du bundle CA système (le_ca_bundle)\n351:       ansible.builtin.stat:\n352:         path: \"{{ le_ca_bundle }}\"\n353:       register: _le_ca_bundle_stat\n354: \n355:     - name: Échouer clairement si le bundle CA est introuvable\n356:       ansible.builtin.assert:\n357:         that: _le_ca_bundle_stat.stat.exists\n358:         fail_msg: >-\n359:           {{ le_ca_bundle }} introuvable sur ce runner — ajuster le_ca_bundle\n360:           (nécessaire pour que certbot fasse confiance au CA interne du proxy\n361:           corp inspectant le TLS ; sinon SSLError \"self-signed certificate\").\n362: \n363:     - name: Vérifier la présence de certbot sur le runner\n364:       # \"command -v\" est un builtin shell : ansible.builtin.command (execve direct,\n365:       # sans shell) ne peut pas le lancer -> module shell requis. \"|| true\" évite un\n366:       # rc non-nul quand certbot est absent (cas normal, géré par le fallback venv).\n367:       ansible.builtin.shell: command -v certbot || true\n368:       register: _le_certbot_system\n369:       changed_when: false\n370: \n371:     - name: Créer un venv certbot dans le workspace (si absent du runner)\n372:       ansible.builtin.command: python3 -m venv \"{{ le_venv }}\"\n373:       args:\n374:         creates: \"{{ le_venv }}/bin/certbot\"\n375:       when: _le_certbot_system.stdout | trim | length == 0\n376: \n377:     - name: Installer certbot dans le venv (via proxy si nécessaire)\n378:       ansible.builtin.pip:\n379:         name: certbot\n380:         virtualenv: \"{{ le_venv }}\"\n381:       environment: \"{{ le_proxy_env | default({}) }}\"\n382:       when: _le_certbot_system.stdout | trim | length == 0\n383: \n384:     - name: Fixer le binaire certbot à utiliser\n385:       ansible.builtin.set_fact:\n386:         le_certbot_bin: >-\n387:           {{ (_le_certbot_system.stdout | trim) if (_le_certbot_system.stdout | trim | length > 0)\n388:              else (le_venv ~ '/bin/certbot') }}\n389: \n390:     - name: Émettre / renouveler chaque certificat (DNS-01, hook PowerDNS)\n391:       block:\n392:         - name: Lancer certbot certonly\n393:           ansible.builtin.command:\n394:             cmd: >-\n395:               {{ le_certbot_bin }} certonly\n396:               --manual --preferred-challenges dns-01\n397:               --manual-auth-hook \"{{ playbook_dir }}/../scripts/acme/certbot-pdns-hook.sh add\"\n398:               --manual-cleanup-hook \"{{ playbook_dir }}/../scripts/acme/certbot-pdns-hook.sh del\"\n399:               -d {{ ([item] + (item.extra_domains | default([]))) | map(attribute='fqdn') | join(' -d ') }}\n400:               --non-interactive --agree-tos -m {{ le_email }}\n401:               --keep-until-expiring\n402:               {{ '--staging' if certbot_staging | bool else '' }}\n403:               --config-dir {{ le_certbot_state_dir }} --work-dir {{ le_certbot_state_dir }}/work\n404:               --logs-dir {{ le_certbot_state_dir }}/logs\n405:           loop: \"{{ le_selected }}\"\n406:           loop_control:\n407:             label: \"{{ item.fqdn }}\"\n408:           # PDNS_* pour le hook (pas d'équivalent ambiant) + proxy éventuel pour les\n409:           # appels ACME de certbot lui-même (cf. le_proxy_env plus haut). Le hook\n410:           # certbot-pdns-hook.sh atteint PowerDNS EN DIRECT : NO_PROXY doit couvrir\n411:           # 172.30.0.0/16 (sinon le curl du hook serait à tort proxifié).\n412:           # REQUESTS_CA_BUNDLE : la lib Python \"requests\" (utilisée par certbot)\n413:           # ne fait confiance qu'à son propre magasin CA embarqué (certifi), PAS\n414:           # au magasin système — contrairement à ansible.builtin.uri (module_utils\n415:           # maison, qui trouve le CA interne du proxy corp inspectant le TLS).\n416:           # Sans ça : SSLError \"self-signed certificate in certificate chain\".\n417:           # PDNS_TXT_NAME_MAP (multi-SAN, ex. doccli + doccli.api) : certbot rappelle le\n418:           # hook UNE FOIS PAR DOMAINE (-d) avec un CERTBOT_DOMAIN différent à chaque fois,\n419:           # dans la MÊME invocation d'\"environment:\" — un seul PDNS_TXT_NAME statique\n420:           # écraserait le TXT du domaine précédent avant que Let's Encrypt n'ait pu le\n421:           # valider. Le hook lit ce mapping JSON {fqdn: txt_name} et retombe sur\n422:           # PDNS_TXT_NAME (puis le défaut _acme-challenge.<domaine>) si absent — aucun\n423:           # changement pour les targets à un seul fqdn.\n424:           environment: >-\n425:             {{ le_proxy_env | default({}) | combine({\n426:                  'PDNS_API_URL': pdns_api_url,\n427:                  'PDNS_API_KEY': pdns_api_key,\n428:                  'PDNS_ZONE': item.pdns_zone,\n429:                  'PDNS_TXT_NAME': item.pdns_txt_name,\n430:                  'PDNS_TXT_NAME_MAP': (([{'fqdn': item.fqdn, 'pdns_txt_name': item.pdns_txt_name}] + (item.extra_domains | default([]))) | items2dict(key_name='fqdn', value_name='pdns_txt_name')) | to_json,\n431:                  'REQUESTS_CA_BUNDLE': le_ca_bundle,\n432:                  'SSL_CERT_FILE': le_ca_bundle,\n433:                }) }}\n434:           register: _le_issue\n435:           changed_when: \"'not yet due for renewal' not in _le_issue.stdout\"\n436:           # PAS de no_log ici : le module command ne renvoie jamais le contenu\n437:           # de \"environment:\" dans son résultat (seulement cmd/stdout/stderr/rc),\n438:           # donc PDNS_API_KEY n'y transite pas. Nécessaire pour diagnostiquer un\n439:           # échec certbot/hook — la clé reste protégée par les no_log sur les\n440:           # tâches qui la chargent/manipulent explicitement (vault, encrypt).\n441:       rescue:\n442:         - name: Afficher l'erreur d'émission (clé API PowerDNS masquée par précaution)\n443:           ansible.builtin.debug:\n444:             msg:\n445:               - \"fqdn={{ ansible_failed_result.item.fqdn | default('?') }} rc={{ ansible_failed_result.rc | default('?') }}\"\n446:               - \"stdout: {{ (ansible_failed_result.stdout | default('')) | replace(pdns_api_key, '***REDACTED***') }}\"\n447:               - \"stderr: {{ (ansible_failed_result.stderr | default('')) | replace(pdns_api_key, '***REDACTED***') }}\"\n448:         - name: Remonter l'échec\n449:           ansible.builtin.fail:\n450:             msg: \"Émission Let's Encrypt échouée — voir le détail (masqué) ci-dessus.\"\n451: \n452:     - name: Créer le répertoire du bundle dans le workspace (files/tls/<fqdn>/)\n453:       ansible.builtin.file:\n454:         path: \"{{ le_bundle_root }}/{{ item.fqdn }}\"\n455:         state: directory\n456:         mode: \"0755\"\n457:       loop: \"{{ le_selected }}\"\n458:       loop_control:\n459:         label: \"{{ item.fqdn }}\"\n460: \n461:     - name: Copier la chaîne de certificats (publique, en clair)\n462:       ansible.builtin.copy:\n463:         src: \"{{ le_certbot_state_dir }}/live/{{ item.fqdn }}/fullchain.pem\"\n464:         dest: \"{{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_certificate_chain.pem\"\n465:         remote_src: true\n466:         mode: \"0644\"\n467:       loop: \"{{ le_selected }}\"\n468:       loop_control:\n469:         label: \"{{ item.fqdn }}\"\n470: \n471:     - name: >-\n472:         Chiffrer la clé privée avec le vault-id déjà chargé par ansible-playbook\n473:         (plugin le_vault_encrypt_file) — écrite en base64 dans un fichier\n474:         temporaire, PAS directement en clair : Ansible déchiffre automatiquement\n475:         toute chaîne reconnue comme $ANSIBLE_VAULT;... dès qu'un secret\n476:         correspondant est chargé (comportement natif pour les variables !vault\n477:         inline), ce qui annule silencieusement le chiffrement si le texte\n478:         chiffré transite tel quel par le module arg \"content:\" (constaté le\n479:         03/07/2026 sur DEUX mécanismes distincts : ici à l'écriture, et plus\n480:         bas à la lecture via lookup('file', ...) — chacun avec son propre\n481:         contournement)\n482:       ansible.builtin.copy:\n483:         content: \"LE_B64:{{ (lookup('le_vault_encrypt_file', le_certbot_state_dir ~ '/live/' ~ item.fqdn ~ '/privkey.pem', vault_id='default')) | b64encode }}\"\n484:         dest: \"{{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem.b64tmp\"\n485:         mode: \"0600\"\n486:       loop: \"{{ le_selected }}\"\n487:       loop_control:\n488:         label: \"{{ item.fqdn }}\"\n489:       when: le_vault_available\n490: \n491:     - name: >-\n492:         Décoder le base64 en shell (fichier vers fichier, ne repasse jamais par\n493:         le templating Ansible donc jamais par l'auto-déchiffrement vault) —\n494:         retire d'abord les 7 octets du préfixe littéral \"LE_B64:\" (tail -c,\n495:         pas sed 's/^.../ dont l'ancre ^ ne matchait pas de façon fiable ici)\n496:       ansible.builtin.shell: >-\n497:         tail -c +8\n498:         {{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem.b64tmp\n499:         | base64 -d\n500:         > {{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem\n501:       loop: \"{{ le_selected }}\"\n502:       loop_control:\n503:         label: \"{{ item.fqdn }}\"\n504:       when: le_vault_available\n505:       changed_when: true\n506: \n507:     - name: Retirer le fichier temporaire base64 (scratch)\n508:       ansible.builtin.file:\n509:         path: \"{{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem.b64tmp\"\n510:         state: absent\n511:       loop: \"{{ le_selected }}\"\n512:       loop_control:\n513:         label: \"{{ item.fqdn }}\"\n514:       when: le_vault_available\n515: \n516:     - name: >-\n517:         Repli si aucun secret vault n'est chargé — uniquement pour\n518:         le_target=test (les domaines réels ont déjà fait échouer le run plus\n519:         haut, avant tout appel PowerDNS/ACME) : clé copiée EN CLAIR, à chiffrer\n520:         manuellement depuis le poste avant tout commit\n521:       ansible.builtin.copy:\n522:         src: \"{{ le_certbot_state_dir }}/live/{{ item.fqdn }}/privkey.pem\"\n523:         dest: \"{{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem.A_CHIFFRER\"\n524:         remote_src: true\n525:         mode: \"0600\"\n526:       loop: \"{{ le_selected }}\"\n527:       loop_control:\n528:         label: \"{{ item.fqdn }}\"\n529:       when: not le_vault_available\n530:       no_log: true\n531: \n532:     # ── Versement automatique du bundle dans GitLab (chemin nominal) ───────────\n533:     # Remplace le copier-coller manuel des blocs base64 depuis les logs Semaphore.\n534:     # Les tâches d'affichage base64 plus bas deviennent le FILET DE SECOURS : elles\n535:     # ne s'exécutent que si ce bloc a été sauté (staging / test / désactivé) ou a\n536:     # échoué (rescue ci-dessous) — voir leur `when:`.\n537:     - name: Verser le bundle dans GitLab via l'API REST v4 (branche → MR → merge)\n538:       when:\n539:         # Jamais de cert staging sur main : il n'est reconnu par aucun navigateur.\n540:         - not (certbot_staging | bool)\n541:         # Jamais de clé EN CLAIR sur main : sans vault, le bundle porte le suffixe\n542:         # .A_CHIFFRER (cf. tâche de repli juste au-dessus).\n543:         - le_vault_available\n544:         - le_commit_to_gitlab | bool\n545:       block:\n546:         - name: Vérifier la présence du vault contenant le PAT GitLab\n547:           ansible.builtin.stat:\n548:             path: \"{{ playbook_dir }}/../scripts/acme/gitlab_api_vault.yml\"\n549:           register: _le_gl_vault_stat\n550: \n551:         - name: Échouer clairement si le vault du PAT GitLab est absent\n552:           ansible.builtin.assert:\n553:             that: _le_gl_vault_stat.stat.exists\n554:             fail_msg: >-\n555:               scripts/acme/gitlab_api_vault.yml introuvable — le commit automatique ne\n556:               peut pas fonctionner. Le créer une fois depuis le poste : renseigner\n557:               scripts/acme/gitlab_api_vault.SECRETS-PLAINTEXT.yml (PAT GitLab scope api)\n558:               puis `ansible-vault encrypt --output scripts/acme/gitlab_api_vault.yml\n559:               scripts/acme/gitlab_api_vault.SECRETS-PLAINTEXT.yml`, et committer le\n560:               fichier chiffré. En attendant, le bundle reste récupérable à la main via\n561:               l'affichage base64 ci-dessous.\n562: \n563:         - name: Charger le PAT GitLab (vault id 2)\n564:           ansible.builtin.include_vars:\n565:             file: \"{{ playbook_dir }}/../scripts/acme/gitlab_api_vault.yml\"\n566:           no_log: true\n567: \n568:         - name: Verser le bundle de chaque FQDN\n569:           ansible.builtin.include_tasks: tasks/commit-le-bundle-gitlab.yml\n570:           loop: \"{{ le_selected }}\"\n571:           loop_control:\n572:             loop_var: le_item\n573:             label: \"{{ le_item.fqdn }}\"\n574: \n575:         - name: Marquer le versement automatique comme réussi\n576:           # Consommé par le `when:` des tâches d'affichage base64 (filet de secours).\n577:           ansible.builtin.set_fact:\n578:             le_gitlab_commit_ok: true\n579:       rescue:\n580:         - name: Signaler l'échec du versement automatique et basculer sur le mode manuel\n581:           ansible.builtin.debug:\n582:             msg:\n583:               - \"⚠ Versement automatique dans GitLab ÉCHOUÉ — repli sur la récupération manuelle.\"\n584:               - \"Cause : {{ ansible_failed_result.msg | default('voir la tâche en échec ci-dessus') }}\"\n585:               - \"Le certificat lui-même a bien été émis : rien à réémettre, le bundle est\"\n586:               - \"récupérable via les blocs base64 affichés ci-dessous (procédure :\"\n587:               - \"docs/certs-publics-semaphore.md §4).\"\n588: \n589:     - name: >-\n590:         Encoder la chaîne de certificats en base64 (via shell)\n591:       ansible.builtin.shell: \"base64 -w0 {{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_certificate_chain.pem\"\n592:       register: _le_chain_b64\n593:       changed_when: false\n594:       loop: \"{{ le_selected }}\"\n595:       loop_control:\n596:         label: \"{{ item.fqdn }}\"\n597: \n598:     - name: >-\n599:         Encoder la clé privée en base64 (via shell, PAS via lookup('file', ...) —\n600:         celui-ci déchiffre silencieusement à la lecture tout contenu reconnu comme\n601:         vault-chiffré dès qu'un secret correspondant est chargé, cf. commentaire\n602:         de la tâche \"Chiffrer\" plus haut)\n603:       ansible.builtin.shell: >-\n604:         base64 -w0\n605:         {{ le_bundle_root }}/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}\n606:       register: _le_key_b64\n607:       changed_when: false\n608:       loop: \"{{ le_selected }}\"\n609:       loop_control:\n610:         label: \"{{ item.fqdn }}\"\n611: \n612:     - name: >-\n613:         FILET DE SECOURS — afficher le bundle en base64 pour récupération DEPUIS LE\n614:         POSTE. Ne s'exécute QUE si le commit automatique dans GitLab a été sauté\n615:         (staging, le_target=test sans vault, le_commit_to_gitlab=false) ou a échoué ;\n616:         Semaphore n'a pas de mécanisme d'artefact téléchargeable, les logs du job sont\n617:         alors l'unique canal de sortie disponible sur ce runner\n618:       ansible.builtin.debug:\n619:         msg:\n620:           - \"-----BEGIN FILE: {{ item.fqdn }}_certificate_chain.pem-----\"\n621:           - \"{{ _le_chain_b64.results[idx].stdout }}\"\n622:           - \"-----END FILE-----\"\n623:           - \"-----BEGIN FILE: {{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}-----\"\n624:           - \"{{ _le_key_b64.results[idx].stdout }}\"\n625:           - \"-----END FILE-----\"\n626:       loop: \"{{ le_selected }}\"\n627:       loop_control:\n628:         label: \"{{ item.fqdn }}\"\n629:         index_var: idx\n630:       when: not (le_gitlab_commit_ok | default(false) | bool)\n631: \n632:     - name: Instructions de récupération du bundle (à exécuter DEPUIS LE POSTE)\n633:       when: not (le_gitlab_commit_ok | default(false) | bool)\n634:       ansible.builtin.debug:\n635:         msg:\n636:           - \"{{ 'Clé privée chiffrée (vault id 2) — déchiffrable uniquement avec le mot de passe vault, que la plupart des lecteurs ne détiennent pas (normal et voulu).' if le_vault_available\n637:                 else \\\"ATTENTION : clé privée copiée EN CLAIR (suffixe .A_CHIFFRER) — chiffrer avec 'ansible-vault encrypt' AVANT tout commit.\\\" }}\"\n638:           - \"Prérequis poste : git installé (PowerShell, Git Bash ou WSL, peu importe){{ ' ; mot de passe vault id 2 pour manipuler la clé (voir ansible-vault view/decrypt dans docs/certs-publics-semaphore.md).' if le_vault_available else '.' }}\"\n639:           - \"0. Si pas déjà cloné :\"\n640:           - \"   git clone https://gitsi.intranet.local/omt/infra/management/infra-management-system.git\"\n641:           - \"   cd infra-management-system\"\n642:           - \"   Sinon, mettre à jour le clone existant :\"\n643:           - \"   git checkout main && git -c http.sslBackend=openssl pull\"\n644:           - \"Depuis la racine de ce clone à jour du repo infra-management-system :\"\n645:           - \"1. Créer une branche dédiée :\"\n646:           - \"   git checkout -b feat/renew-{{ item.fqdn }}\"\n647:           - \"2. Créer le répertoire de destination (s'il n'existe pas déjà) :\"\n648:           - \"   mkdir -p files/tls/{{ item.fqdn }}\"\n649:           - \"3. Dans la sortie du job ci-dessus, copier chaque bloc base64 (entre BEGIN FILE et END FILE,\"\n650:           - \"   sans les lignes de marqueur) dans un fichier temporaire — PEU IMPORTE où (ex. à la racine\"\n651:           - \"   du clone), ce sont des fichiers de travail à jeter ensuite :\"\n652:           - \"   chain.b64  <- bloc {{ item.fqdn }}_certificate_chain.pem\"\n653:           - \"   key.b64    <- bloc {{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}\"\n654:           - \"4. Décoder VERS le fichier de destination final (redirection obligatoire — un `base64 -d`\"\n655:           - \"   sans `>` ne fait qu'afficher le résultat à l'écran, il n'écrit RIEN sur disque) :\"\n656:           - \"   Windows (natif, sans WSL) :\"\n657:           - \"     certutil -decode chain.b64 files\\\\tls\\\\{{ item.fqdn }}\\\\{{ item.fqdn }}_certificate_chain.pem\"\n658:           - \"     certutil -decode key.b64   files\\\\tls\\\\{{ item.fqdn }}\\\\{{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}\"\n659:           - \"   WSL / Linux / Mac :\"\n660:           - \"     base64 -d chain.b64 > files/tls/{{ item.fqdn }}/{{ item.fqdn }}_certificate_chain.pem\"\n661:           - \"     base64 -d key.b64   > files/tls/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}\"\n662:           - \"5. Vérifier AVANT de committer :\"\n663:           - \"   head -c 25 files/tls/{{ item.fqdn }}/{{ item.fqdn }}_private_key.pem{{ '' if le_vault_available else '.A_CHIFFRER' }}\"\n664:           - \"   -> doit afficher '$ANSIBLE_VAULT;1.1;AES256' (sinon le fichier contient encore du base64\"\n665:           - \"      non décodé ou la clé en clair — ne pas committer)\"\n666:           - \"   openssl x509 -noout -issuer -enddate -in files/tls/{{ item.fqdn }}/{{ item.fqdn }}_certificate_chain.pem\"\n667:           - \"   -> vérifier l'issuer : '(STAGING)' si certbot_staging=true, 'Let's Encrypt' (sans STAGING) sinon\"\n668:           - \"6. Supprimer les fichiers temporaires chain.b64 / key.b64 (jamais versionnés).\"\n669:           - \"7. Committer et pousser :\"\n670:           - \"   git add files/tls/{{ item.fqdn }}/\"\n671:           - \"   git commit -m 'feat(le): émission/renouvellement {{ item.fqdn }}'\"\n672:           - \"   git -c http.sslBackend=openssl push -u origin feat/renew-{{ item.fqdn }} ; ouvrir la MR\"\n673:           - \"8. Merger sur main (l'inventaire Semaphore suit main).\"\n674:           - \"Puis déployer sur le frontal via le template Semaphore 'Deploy TLS bundle' (tpl 38) — action séparée, validée.\"\n675:       loop: \"{{ le_selected }}\"\n676:       loop_control:\n677:         label: \"{{ item.fqdn }}\"\n678: \n679:     - name: Bundle versé automatiquement — étape suivante\n680:       ansible.builtin.debug:\n681:         msg:\n682:           - \"✅ Bundle sur {{ le_gitlab_branch }} : files/tls/{{ item.fqdn }}/\"\n683:           - \"   (chaîne en clair + clé chiffrée ansible-vault, relue et vérifiée après merge)\"\n684:           - \"Aucune manipulation manuelle nécessaire — l'inventaire Semaphore suit {{ le_gitlab_branch }},\"\n685:           - \"le bundle est donc déjà disponible pour le déploiement.\"\n686:           - \"Étape suivante : déployer sur l'hôte cible — action SÉPARÉE et validée\"\n687:           - \"(template 'Deploy TLS bundle' tpl 38 pour un frontal géré par le repo, ou le\"\n688:           - \"playbook de dépôt dédié pour un hôte hors-IaC), puis reload nginx (jamais restart).\"\n689:       loop: \"{{ le_selected }}\"\n690:       loop_control:\n691:         label: \"{{ item.fqdn }}\"\n692:       when: le_gitlab_commit_ok | default(false) | bool\n693: \nThe above content shows the entire, complete file contents of the requested file.\n"}
