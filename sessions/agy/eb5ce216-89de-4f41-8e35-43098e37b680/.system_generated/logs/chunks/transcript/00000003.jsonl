  print('ORIGINAL:', repr(s))\\n    print('MASKED  :', repr(sanitize_notes(s)))\\n    print()\\n\\\"\"","Cwd":"\"/home/koby/.ansible\"","WaitMsBeforeAsync":"3000","toolAction":"\"Running command\"","toolSummary":"\"Test password masking logic\""}}]}
