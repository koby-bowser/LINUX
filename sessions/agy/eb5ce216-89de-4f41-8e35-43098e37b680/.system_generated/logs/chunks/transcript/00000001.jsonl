{"step_index":136,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-09T12:05:01Z","content":"Created At: 2026-09-09T16:05:01+04:00\nCompleted At: 2026-09-09T16:05:01+04:00\n\nThe command exited with code 0.\nOutput:\n<truncated 13 lines>\n#\r\n# Modèle de connexion attendu (calqué sur l'usage manuel réel) :\r\n#   - connexion SSH initiale en tant qu'utilisateur non-root (ex. superuser)\r\n#   - élévation root via sudo, AVEC LE MÊME mot de passe que la connexion SSH\r\n#     (ex. \"sudo -i\" côté humain). Ansible reproduit ça avec `become: true` +\r\n#     `ansible_become_password` : chaque tâche marquée become s'exécute via\r\n#     sudo non-interactif — résultat identique à un \"sudo -i\" manuel, sans\r\n#     shell interactif.\r\n#\r\n# Usage :\r\n#   ansible-playbook -i \"<host>,\" playbooks/deploy-ssh-key.yml -e @/chemin/vars.yml\r\n#\r\n# vars.yml (temporaire, JAMAIS versionné) — un seul mot de passe suffit,\r\n# réutilisé pour la connexion SSH et pour sudo (voir ansible_become_password\r\n# ci-dessous) :\r\n#   ansible_user: <utilisateur_non_root>\r\n#   ansible_password: '<mot_de_passe>'\r\n#   ansible_port: <port>\r\n#\r\n# Vérification \"sans mot de passe\" : à faire dans une invocation SÉPARÉE,\r\n# sans ansible_password ni --ask-pass (voir commentaire en bas de fichier).\r\n# Les extra-vars ont la priorité la plus haute dans Ansible et resteraient\r\n# actives pour tout second play de ce même fichier — la vérification ne\r\n# prouverait donc rien si elle était ici.\r\n\r\n- name: Déployer la clé publique locale et sécuriser l'accès SSH par clé\r\n  hosts: all\r\n  gather_facts: true\r\n  become: true\r\n  become_method: ansible.builtin.sudo\r\n  vars:\r\n    local_pubkey_path: \"{{ lookup('env', 'HOME') }}/.ssh/id_ed25519.pub\"\r\n    ansible_ssh_common_args: \"-o StrictHostKeyChecking=accept-new\"\r\n    ansible_become_password: \"{{ ansible_password }}\"\r\n    ssh_service_name: \"{{ 'ssh' if ansible_facts['os_family'] == 'Debian' else 'sshd' }}\"\r\n\r\n  tasks:\r\n    - name: Vérifier que la clé publique locale existe\r\n      ansible.builtin.stat:\r\n        path: \"{{ local_pubkey_path }}\"\r\n      delegate_to: localhost\r\n      become: false\r\n      ru\n<truncated 4210 bytes>\n ses permissions/propriétaire ne sont pas\r\n          modifiés par ce playbook ; vérifiez manuellement qu'il reste\r\n          root:root et non accessible en écriture aux utilisateurs normaux.\r\n      when: (resolved_authorized_keys_path | dirname) != (remote_user_home ~ '/.ssh')\r\n\r\n    - name: Déployer la clé publique dans le fichier authorized_keys effectif\r\n      ansible.posix.authorized_key:\r\n        user: \"{{ ansible_user }}\"\r\n        state: present\r\n        key: \"{{ lookup('file', local_pubkey_path) }}\"\r\n        path: \"{{ resolved_authorized_keys_path }}\"\r\n        manage_dir: false\r\n\r\n    - name: Forcer les permissions correctes sur authorized_keys (600, bon propriétaire)\r\n      ansible.builtin.file:\r\n        path: \"{{ resolved_authorized_keys_path }}\"\r\n        owner: \"{{ ansible_user }}\"\r\n        group: \"{{ remote_user_gid }}\"\r\n        mode: '0600'\r\n\r\n    # --- Activer PubkeyAuthentication si nécessaire, avec validation stricte ---\r\n    - name: Activer PubkeyAuthentication dans sshd_config si elle est désactivée\r\n      ansible.builtin.lineinfile:\r\n        path: /etc/ssh/sshd_config\r\n        regexp: '^#?\\s*PubkeyAuthentication\\s+'\r\n        line: 'PubkeyAuthentication yes'\r\n        validate: '/usr/sbin/sshd -t -f %s'\r\n      when: not (pubkey_auth_enabled | bool)\r\n      notify: Recharger sshd\r\n\r\n    - name: Résumé de l'état SSH sur {{ inventory_hostname }}\r\n      ansible.builtin.debug:\r\n        msg:\r\n          - \"Fichier authorized_keys utilisé : {{ resolved_authorized_keys_path }}\"\r\n          - \"PubkeyAuthentication était activée avant ce run : {{ pubkey_auth_enabled }}\"\r\n\r\n  handlers:\r\n    - name: Recharger sshd\r\n      ansible.builtin.service:\r\n        name: \"{{ ssh_service_name }}\"\r\n        state: reloaded\r\n\r\n# Vérification \"sans mot de passe\" (invocation séparée, sans ansible_password) :\r\n#   ansible all -i \"<host>,\" -e ansible_user=<user> -e ansible_port=<port> \\\r\n#     -e 'ansible_ssh_common_args=\"-o BatchMode=yes -o PreferredAuthentications=publickey\"' \\\r\n#     -m command -a whoami\r\n\n","truncated_fields":["content"]}
