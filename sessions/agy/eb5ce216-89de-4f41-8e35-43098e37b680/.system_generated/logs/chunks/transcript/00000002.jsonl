mkeys(IP_REGEX.findall(combined)))\\n        \\n        # Extract port\\n        port = None\\n        port_match = PORT_REGEX.search(f'{url} {notes}')\\n        if port_match:\\n            port = port_match.group(1) or port_match.group(2)\\n        \\n        servers.append({\\n            'title': title,\\n \n<truncated 537 bytes>","Cwd":"\"/home/koby/.ansible\"","WaitMsBeforeAsync":"3000","toolAction":"\"Running command\"","toolSummary":"\"Test recursive parser function\""}}],"truncated_fields":["tool_calls"]}
