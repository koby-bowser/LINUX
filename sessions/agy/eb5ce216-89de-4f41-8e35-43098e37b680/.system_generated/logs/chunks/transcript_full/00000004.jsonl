            print(stderr.strip(), file=sys.stderr)\n        sys.exit(2)\n\n    # Parse XML with password masking enabled\n    servers = extract_servers_from_xml(stdout, mask_secrets=not args.reveal_secrets)\n\n    # Create destination directories\n    os.makedirs(os.path.dirname(os.path.abspath(args.output_yaml)), exist_ok=True)\n    os.makedirs(os.path.dirname(os.path.abspath(args.output_json)), exist_ok=True)\n\n    # Write JSON cache\n    payload = {\n        'metadata': {\n            'generated_at': datetime.now(timezone.utc).isoformat(),\n            'source_db': args.db,\n            'total_servers': len(servers),\n            'total_with_ip': sum(1 for s in servers if s['primary_ip'])\n        },\n        'servers': servers\n    }\n    with open(args.output_json, 'w') as f:\n        json.dump(payload, f, indent=2)\n\n    # Write Ansible Inventory YAML\n    inv_data = generate_ansible_inventory(servers)\n    with open(args.output_yaml, 'w') as f:\n        f.write(\"# Ansible Inventory generated automatically from KeePass database\\n\")\n        f.write(f\"# Source: {args.db}\\n\")\n        f.write(f\"# Total Servers: {len(servers)} | Updated: {datetime.now(timezone.utc).isoformat()}\\n\\n\")\n        yaml.dump(inv_data, f, default_flow_style=False, sort_keys=False)\n\n    print(f\"[OK] Successfully built server pool: {len(servers)} total entries ({payload['metadata']['total_with_ip']} with IP addresses).\")\n    print(f\"     Ansible Inventory : {args.output_yaml}\")\n    print(f\"     Search Cache      : {args.output_json}\")\n\n    # If a search was requested alongside sync:\n    if args.search:\n        matches = search_pool(servers, args.search)\n        if args.json_output:\n            print(json.dumps(matches, indent=2))\n        else:\n            print_search_results(matches, args.search)\n\n\ndef print_search_results(matches, query):\n    C_RESET = \"\\033[0m\"\n    C_GREEN = \"\\033[0;32m\"\n    C_YELLOW = \"\\033[0;33m\"\n    C_BLUE = \"\\033[0;34m\"\n    C_BOLD = \"\\033[1m\"\n    C_CYAN = \"\\033[0;36m\"\n\n    print(f\"\\n{C_BOLD}=== [Search Results for '{query}': {len(matches)} match(es)] ==={C_RESET}\\n\")\n    if not matches:\n        print(f\"  {C_YELLOW}No matching servers found.{C_RESET}\\n\")\n        return\n\n    for idx, s in enumerate(matches, 1):\n        ips_str = \", \".join(s['ips']) if s['ips'] else \"No IP\"\n        user_str = s['username'] if s['username'] else \"None\"\n        port_str = f\"Port: {s['port']}\" if s['port'] else \"\"\n        proto_str = f\"[{s['protocol'].upper()}]\"\n\n        print(f\"  {C_BOLD}{idx:2d}. {C_GREEN}{s['title']}{C_RESET} {C_CYAN}{proto_str}{C_RESET}\")\n        print(f\"      {C_BOLD}IP(s)   :{C_RESET} {C_YELLOW}{ips_str}{C_RESET} {port_str}\")\n        print(f\"      {C_BOLD}User    :{C_RESET} {user_str}\")\n        print(f\"      {C_BOLD}Group   :{C_RESET} {C_BLUE}{s['group']}{C_RESET}\")\n        if s.get('notes'):\n            # Shorten notes for clean display\n            clean_notes = \" \".join(s['notes'].split())[:120]\n            print(f\"      {C_BOLD}Notes   :{C_RESET} {clean_notes}\")\n        print()\n\n\nif __name__ == '__main__':\n    main()\nEOF\nchmod +x /home/koby/.ansible/scripts/build_kdbx_pool.py\n","Cwd":"/home/koby/.ansible","WaitMsBeforeAsync":3000,"toolAction":"Running command","toolSummary":"Update build_kdbx_pool.py with password sanitization"}}]}
