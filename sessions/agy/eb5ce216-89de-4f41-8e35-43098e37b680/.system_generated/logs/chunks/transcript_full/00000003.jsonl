   SYNC=true\n            shift\n            ;;\n        --db)\n            DB_PATH=\"$2\"\n            shift 2\n            ;;\n        -j|--json)\n            JSON_OUT=true\n            shift\n            ;;\n        *)\n            SEARCH_TERM=\"$1\"\n            shift\n            ;;\n    esac\ndone\n\nif [ \"$SYNC\" = true ] || [ ! -f \"$POOL_JSON\" ]; then\n    echo -e \"${C_BOLD}=== [Synchronizing Server Pool from KeePass] ===${C_RESET}\"\n    read -s -p \"Enter KeePass Master Password: \" MASTER_PASS\n    echo \"\"\n    \n    EXTRA_ARGS=()\n    if [ -n \"$DB_PATH\" ]; then\n        EXTRA_ARGS+=(\"--db\" \"$DB_PATH\")\n    fi\n    if [ -n \"$SEARCH_TERM\" ]; then\n        EXTRA_ARGS+=(\"--search\" \"$SEARCH_TERM\")\n    fi\n    if [ \"$JSON_OUT\" = true ]; then\n        EXTRA_ARGS+=(\"--json-output\")\n    fi\n\n    echo \"$MASTER_PASS\" | \"$PARSER\" \"${EXTRA_ARGS[@]}\" --sync\n    unset MASTER_PASS\n    exit 0\nfi\n\n# Fast search using cached pool\nCMD=(\"$PARSER\" \"--search\" \"$SEARCH_TERM\")\nif [ \"$JSON_OUT\" = true ]; then\n    CMD+=(\"--json-output\")\nfi\n\n\"${CMD[@]}\"\nEOF\nchmod +x /home/koby/.ansible/scripts/search-servers.sh\nln -sf /home/koby/.ansible/scripts/search-servers.sh /home/koby/.ansible/search-servers.sh\nln -sf /home/koby/.ansible/playbooks/kdbx-pool.yml /home/koby/.ansible/playbooks/search-servers.yml\n","Cwd":"/home/koby/.ansible","WaitMsBeforeAsync":3000,"toolAction":"Running command","toolSummary":"Create search-servers.sh CLI wrapper"}}]}
