{"step_index":99,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-17T07:06:37Z","content":"Created At: 2026-09-17T11:06:37+04:00\nCompleted At: 2026-09-17T11:06:37+04:00\nFile Path: `file:///home/koby/LINUX/scripts/kssh.py`\nTotal Lines: 154\nTotal Bytes: 5930\nShowing lines 1 to 35\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: kssh: Smart SSH connector using the KeePass server pool.\n4: Resolves hostname/IP, port, user, key, and password automatically.\n5: \"\"\"\n6: \n7: import sys\n8: import os\n9: import json\n10: import subprocess\n11: \n12: POOL_JSON = os.path.expanduser(\"~/.ansible/inventory/server_pool.json\")\n13: PRIV_KEY = os.path.expanduser(\"~/.ssh/id_ed25519\")\n14: \n15: def main():\n16:     args = sys.argv[1:]\n17:     if not args or '-h' in args or '--help' in args:\n18:         print(\"\\033[1mUsage:\\033[0m kssh [-u <USER>] <SERVER_NAME_OR_IP> [SSH_OPTIONS / REMOTE_COMMAND]\")\n19:         print(\"Examples: kssh mtq-mailsrvp-01\")\n20:         print(\"          kssh -u superuser trp-wextp-fe1\")\n21:         print(\"          kssh trp-wextp-fe1 uptime\")\n22:         print(\"          kssh 172.30.231.177\")\n23:         sys.exit(0)\n24: \n25:     if not os.path.isfile(POOL_JSON):\n26:         print(f\"\\033[0;31m[ERROR] Server pool not found at {POOL_JSON}.\\033[0m\")\n27:         print(\"Run: ansible-playbook ~/.ansible/playbooks/kdbx-pool.yml -e 'action=sync' to build it.\")\n28:         sys.exit(1)\n29: \n30:     preferred_user = None\n31:     if '-u' in args:\n32:         idx = args.index('-u')\n33:         if idx + 1 < len(args):\n34:             preferred_user = args[idx + 1]\n35:             args = args[:idx] + args[idx + 2:]\nThe above content does NOT show the entire file contents