.yml\r\n#\r\n\r\n==> /home/koby/LINUX/playbooks/issue-deploy-certs.yml <==\r\n---\r\n# Émet/renouvelle des certificats Let's Encrypt par challenge DNS-01 pour les\r\n# domaines listés dans group_vars/all/certificates.yml, puis les déploie sur\r\n# le serveur qui héberge chaque domaine (nginx/apache), avec reload\r\n# UNIQUEMENT si le certificat a réellement changé (comparaison de numéro de\r\n# série avant/après émission — pas de coupure de service inutile).\r\n#\r\n# Deux backends DNS supportés (un par domaine, voir certificates.yml) :\r\n#   - rfc2136  : ns1 (BIND), via le plugin officiel certbot-dns-rfc2136\r\n#   - powerdns : dnsp-mst (PowerDNS), via l'API REST + hooks certbot --manual\r\n#                (pas de plugin apt/pip fiable disponible pour PowerDNS —\r\n#                l'API REST officielle est plus stable qu'un plugin tiers)\r\n#\r\n# Prérequis avant le premier run :\r\n#   1. Remplir group_vars/all/certificates.yml (domaine -> backend/hôte cible)\r\n\r\n==> /home/koby/LINUX/playbooks/kdbx-pool.yml <==\r\n---\r\n- name: KeePass Server Pool Manager & Search\r\n  hosts: localhost\r\n  connection: local\r\n  gather_facts: false\r\n  vars:\r\n    default_db_path: \"{{ lookup('env', 'HOME') }}/Documents/keePassXC/OMT_PFS.SYSTEME.ALL.kdbx\"\r\n    fallback_db_path: \"{{ lookup('env', 'HOME') }}/Downloads/OMT_PFS.SYSTEME.ALL.kdbx\"\r\n    kdbx_path: \"{{ kdbx_file | default(default_db_path if default_db_stat.stat.exists else fallback_db_path) }}\"\r\n    pool_json_path: \"{{ playbook_dir }}/../inventory/server_pool.json\"\r\n    pool_yaml_path: \"{{ playbook_dir }}/../inventory/server_pool.yml\"\r\n    parser_script: \"{{ playbook_dir }}/../scripts/build_kdbx_pool.py\"\r\n    target_search: \"{{ search | default(term | default('')) }}\"\r\n\r\n  tasks:\r\n\r\n==> /home/koby/LINUX/playbooks/search-servers.yml <==\r\n---\r\n- name: KeePass Server Pool Manager & Search\r\n  hosts: localhost\r\n  connection: local\r\n  gather_facts: false\r\n  vars:\r\n    default_db_path: \"{{ lookup('env', 'HOME') }}/Documents/keePassXC/OMT_PFS.SYSTEME.ALL.kdbx\"\r\n    fallback_db_path: \"{{ lookup('env', 'HOME') }}/Downloads/OMT_PFS.SYSTEME.ALL.kdbx\"\r\n    kdbx_path: \"{{ kdbx_file | default(default_db_path if default_db_stat.stat.exists else fallback_db_path) }}\"\r\n    pool_json_path: \"{{ playbook_dir }}/../inventory/server_pool.json\"\r\n    pool_yaml_path: \"{{ playbook_dir }}/../inventory/server_pool.yml\"\r\n    parser_script: \"{{ playbook_dir }}/../scripts/build_kdbx_pool.py\"\r\n    target_search: \"{{ search | default(term | default('')) }}\"\r\n\r\n  tasks:\r\n\n"}
