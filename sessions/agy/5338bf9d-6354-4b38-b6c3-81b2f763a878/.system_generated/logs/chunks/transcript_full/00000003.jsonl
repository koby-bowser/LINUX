{"step_index":257,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-08T11:00:28Z","content":"Created At: 2026-09-08T15:00:28+04:00\nCompleted At: 2026-09-08T15:00:28+04:00\nFile Path: `file:///home/koby/infra-management-system/playbooks/check-distro-kernel.yml`\nTotal Lines: 117\nTotal Bytes: 6666\nShowing lines 1 to 117\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: # ==============================================================================\n3: # Playbook: Check Linux Distribution and Kernel Version\n4: # ==============================================================================\n5: # Gathers and displays operating system distribution name, version, release,\n6: # and kernel version across infrastructure servers (such as those targeted by\n7: # ping.yml in inventories/dev/hosts.yml).\n8: #\n9: # Robustness & Error Handling:\n10: # - Uses `ignore_unreachable: true` and `ignore_errors: true` on fact gathering\n11: #   so that unreachable nodes (e.g. trp-wextd-rdb1 with missing SSH keys) or\n12: #   nodes with execution issues do not abort the playbook.\n13: # - Extracts concise error messages without noisy multiline SSH login banners.\n14: # - Outputs individual host system information and a consolidated summary table\n15: #   with accurate status reporting (ONLINE, UNREACHABLE, FAILED, NO DATA)\n16: #   and summary metrics.\n17: #\n18: # Execution Examples:\n19: #   # Run against dev inventory:\n20: #   ANSIBLE_STDOUT_CALLBACK=default ANSIBLE_CALLBACK_RESULT_FORMAT=yaml \\\n21: #     ansible-playbook -i inventories/dev/hosts.yml playbooks/check-distro-kernel.yml\n22: #\n23: #   # Target a single server or group:\n24: #   ANSIBLE_STDOUT_CALLBACK=default ANSIBLE_CALLBACK_RESULT_FORMAT=yaml \\\n25: #     ansible-playbook -i inventories/dev/hosts.yml playbooks/check-distro-kernel.yml \\\n26: #     -e target_hosts=trp-wextd-be1\n27: # ==============================================================================\n28: \n29: - name: Infra Management - Check Linux Distribution and Kernel Version\n30:   hosts: \"{{ target_hosts | default('all') }}\"\n31:   gather_facts: false\n32:   ignore_unreachable: true\n33: \n34:   tasks:\n35:     - name: Gather distribution, kernel, and system facts\n36:       ansible.builtin.setup:\n37:         filter:\n38:           - 'ansible_distribution*'\n39:           - 'ansible_kernel*'\n40:           - 'ansible_os_family'\n41:           - 'ansible_architecture'\n42:           - 'ansible_hostname'\n43:           - 'ansible_nodename'\n44:       ignore_unreachable: true\n45:       ignore_errors: true\n46:       register: setup_result\n47: \n48:     - name: Display Host OS and Kernel Information\n49:       vars:\n50:         facts: \"{{ ansible_facts | default({}) }}\"\n51:         is_unreach: \"{{ setup_result is defined and setup_result.unreachable | default(false) }}\"\n52:         is_failed: \"{{ setup_result is defined and setup_result.failed | default(false) }}\"\n53:         has_facts: \"{{ 'distribution' in facts }}\"\n54:         distro_name: \"{{ facts.get('distribution', '') }}\"\n55:         distro_ver: \"{{ facts.get('distribution_version', '') }}\"\n56:         distro_rel: \"{{ facts.get('distribution_release', '') }}\"\n57:         distro_str: \"{{ (distro_name ~ ' ' ~ distro_ver ~ (' (' ~ distro_rel ~ ')' if distro_rel else '')) if distro_name else 'N/A' }}\"\n58:         err_msg: \"{{ ((setup_result.msg | default('Unknown failure') | string).splitlines() | reject('match', '^\\\\s*$') | list | last) | default('Unknown failure') }}\"\n59:       ansible.builtin.debug:\n60:         msg: >-\n61:           {{\n62:             [\n63:               \"================ System Information ================\",\n64:               \"Host               : \" ~ inventory_hostname,\n65:               \"Hostname           : \" ~ facts.get('nodename', 'N/A'),\n66:               \"OS Family          : \" ~ facts.get('os_family', 'N/A'),\n67:               \"Distribution       : \" ~ distro_str,\n68:               \"Kernel Version     : \" ~ facts.get('kernel', 'N/A'),\n69:               \"Architecture       : \" ~ facts.get('architecture', 'N/A'),\n70:               \"Status             : \" ~ ('UNREACHABLE' if is_unreach else ('FAILED' if is_failed else ('ONLINE' if has_facts else 'NO DATA')))\n71:             ] + ([\n72:               \"Error              : \" ~ err_msg\n73:             ] if (is_unreach or is_failed) else []) + [\n74:               \"=====================================================\"\n75:             ]\n76:           }}\n77:       ignore_unreachable: true\n78:       ignore_errors: true\n79: \n80:     - name: Display Summary Table of All Infrastructure Nodes\n81:       ansible.builtin.debug:\n82:         msg: |\n83:           ----------------------------------------------------------------------------------------------------------------------------------\n84:           {{ '%-24s' | format('HOST') }} | {{ '%-12s' | format('STATUS') }} | {{ '%-38s' | format('DISTRIBUTION') }} | {{ '%-26s' | format('KERNEL') }}\n85:           ----------------------------------------------------------------------------------------------------------------------------------\n86:           {% set ns = namespace(online=0, unreachable=0, failed=0, no_data=0) %}\n87:           {% for h in ansible_play_hosts_all | sort %}\n88:           {% set hv = hostvars[h] %}\n89:           {% set is_unreach = (hv.setup_result is defined and hv.setup_result.unreachable | default(false)) %}\n90:           {% set is_failed = (hv.setup_result is defined and hv.setup_result.failed | default(false)) %}\n91:           {% set af = hv.ansible_facts | default({}) %}\n92:           {% if is_unreach %}\n93:           {% set ns.unreachable = ns.unreachable + 1 %}\n94:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('UNREACHABLE') }} | {{ '%-38s' | format('N/A (unreachable)') }} | {{ '%-26s' | format('N/A') }}\n95:           {% elif is_failed %}\n96:           {% set ns.failed = ns.failed + 1 %}\n97:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('FAILED') }} | {{ '%-38s' | format('N/A (setup failed)') }} | {{ '%-26s' | format('N/A') }}\n98:           {% elif not af or 'distribution' not in af %}\n99:           {% set ns.no_data = ns.no_data + 1 %}\n100:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('NO DATA') }} | {{ '%-38s' | format('N/A (no facts)') }} | {{ '%-26s' | format('N/A') }}\n101:           {% else %}\n102:           {% set ns.online = ns.online + 1 %}\n103:           {% set d_name = af.get('distribution', 'Unknown') %}\n104:           {% set d_ver = af.get('distribution_version', '') %}\n105:           {% set d_rel = af.get('distribution_release', '') %}\n106:           {% set d_str = d_name ~ ' ' ~ d_ver ~ (' (' ~ d_rel ~ ')' if d_rel else '') %}\n107:           {% set k_ver = af.get('kernel', 'Unknown') %}\n108:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('ONLINE') }} | {{ '%-38s' | format(d_str) }} | {{ '%-26s' | format(k_ver) }}\n109:           {% endif %}\n110:           {% endfor %}\n111:           ----------------------------------------------------------------------------------------------------------------------------------\n112:           Summary: Total: {{ ansible_play_hosts_all | length }} | Online: {{ ns.online }} | Unreachable: {{ ns.unreachable }} | Failed: {{ ns.failed }}{% if ns.no_data > 0 %} | No Data: {{ ns.no_data }}{% endif %}\n113: \n114:           ----------------------------------------------------------------------------------------------------------------------------------\n115:       run_once: true\n116:       delegate_to: localhost\n117: \nThe above content shows the entire, complete file contents of the requested file.\n"}
