{"step_index":579,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-17T12:28:57Z","content":"Created At: 2026-09-17T16:28:57+04:00\nCompleted At: 2026-09-17T16:28:57+04:00\nFile Path: `file:///home/koby/LINUX/playbooks/kdbx-pool.yml`\nTotal Lines: 110\nTotal Bytes: 4136\nShowing lines 1 to 110\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: - name: KeePass Server Pool Manager & Search\n3:   hosts: localhost\n4:   connection: local\n5:   gather_facts: false\n6:   vars:\n7:     default_db_path: \"{{ lookup('env', 'HOME') }}/Documents/keePassXC/OMT_PFS.SYSTEME.ALL.kdbx\"\n8:     fallback_db_path: \"{{ lookup('env', 'HOME') }}/Downloads/OMT_PFS.SYSTEME.ALL.kdbx\"\n9:     kdbx_path: \"{{ kdbx_file | default(default_db_path if default_db_stat.stat.exists else fallback_db_path) }}\"\n10:     pool_json_path: \"{{ playbook_dir }}/../inventory/server_pool.json\"\n11:     pool_yaml_path: \"{{ playbook_dir }}/../inventory/server_pool.yml\"\n12:     parser_script: \"{{ playbook_dir }}/../scripts/build_kdbx_pool.py\"\n13:     target_search: \"{{ search | default(term | default('')) }}\"\n14: \n15:   tasks:\n16:     - name: Check default KeePass DB existence\n17:       ansible.builtin.stat:\n18:         path: \"{{ default_db_path }}\"\n19:       register: default_db_stat\n20: \n21:     - name: Check server pool cache existence\n22:       ansible.builtin.stat:\n23:         path: \"{{ pool_json_path }}\"\n24:       register: pool_cache_stat\n25: \n26:     - name: Determine if pool synchronization is required\n27:       ansible.builtin.set_fact:\n28:         needs_sync: \"{{ (action | default('')) == 'sync' or not pool_cache_stat.stat.exists }}\"\n29: \n30:     - name: Prompt for KeePass database password if pool needs sync\n31:       ansible.builtin.pause:\n32:         prompt: \"Enter KeePass Master Password for {{ kdbx_path }}\"\n33:         echo: false\n34:       register: prompt_password\n35:       when: needs_sync and (kdbx_password is not defined or kdbx_password | length == 0)\n36: \n37:     - name: Set resolved KeePass password\n38:       ansible.builtin.set_fact:\n39:         resolved_password: \"{{ kdbx_password | default(prompt_password.user_input | default('')) }}\"\n40:       no_log: true\n41:       when: needs_sync\n42: \n43:     - name: Synchronize server pool from KeePass database\n44:       ansible.builtin.command:\n45:         argv:\n46:           - \"{{ parser_script }}\"\n47:           - \"--db\"\n48:           - \"{{ kdbx_path }}\"\n49:           - \"--output-yaml\"\n50:           - \"{{ pool_yaml_path }}\"\n51:           - \"--output-json\"\n52:           - \"{{ pool_json_path }}\"\n53:           - \"--sync\"\n54:           - \"--no-color\"\n55:         stdin: \"{{ resolved_password }}\"\n56:       register: sync_output\n57:       when: needs_sync\n58:       no_log: false\n59:       changed_when: true\n60: \n61:     - name: Display synchronization summary\n62:       ansible.builtin.debug:\n63:         msg: \"{{ sync_output.stdout_lines }}\"\n64:       when: needs_sync and sync_output.stdout_lines is defined\n65: \n66:     - name: Search server pool for query\n67:       ansible.builtin.command:\n68:         argv:\n69:           - \"{{ parser_script }}\"\n70:           - \"--output-json\"\n71:           - \"{{ pool_json_path }}\"\n72:           - \"--search\"\n73:           - \"{{ target_search }}\"\n74:           - \"--no-color\"\n75:       register: search_output\n76:       when: target_search | length > 0\n77:       changed_when: false\n78: \n79:     - name: Display search results\n80:       ansible.builtin.debug:\n81:         msg: \"{{ search_output.stdout_lines }}\"\n82:       when: target_search | length > 0 and search_output.stdout_lines is defined\n83: \n84:     - name: Show pool overview when no search query is specified\n85:       when: target_search | length == 0\n86:       block:\n87:         - name: Read pool metadata\n88:           ansible.builtin.slurp:\n89:             src: \"{{ pool_json_path }}\"\n90:           register: pool_raw\n91: \n92:         - name: Parse pool metadata\n93:           ansible.builtin.set_fact:\n94:             pool_data: \"{{ pool_raw.content | b64decode | from_json }}\"\n95: \n96:         - name: Display pool summary and usage guide\n97:           ansible.builtin.debug:\n98:             msg:\n99:               - \"=== KeePass Server Pool Overview ===\"\n100:               - \"Source DB       : {{ pool_data.metadata.source_db }}\"\n101:               - \"Total Servers   : {{ pool_data.metadata.total_servers }}\"\n102:               - \"Servers with IP : {{ pool_data.metadata.total_with_ip }}\"\n103:               - \"Last Synced     : {{ pool_data.metadata.generated_at }}\"\n104:               - \"Ansible Inventory: {{ pool_yaml_path }}\"\n105:               - \"\"\n106:               - \"To search for any server, run:\"\n107:               - \"  ansible-playbook playbooks/kdbx-pool.yml -e 'search=<search_term>'\"\n108:               - \"To resync after modifying your .kdbx:\"\n109:               - \"  ansible-playbook playbooks/kdbx-pool.yml -e 'action=sync'\"\n110: \nThe above content shows the entire, complete file contents of the requested file.\n"}
