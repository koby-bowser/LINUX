nes\n39:                | select('match', '^authorizedkeysfile ')\n40:                | list | first | default('authorizedkeysfile .ssh/authorized_keys')\n41:                ).split()[1:])[0] }}\n42: \n43:     - name: Create automation user\n44:       ansible.builtin.user:\n45:         name: \"{{ target_user }}\"\n46:         comment: \"Ansible Automation User\"\n47:         shell: /bin/bash\n48:         create_home: true\n49:         state: present\n50: \n51:     - name: Add automation user to sudo group\n52:       ansible.builtin.user:\n53:         name: \"{{ target_user }}\"\n54:         groups: sudo\n55:         append: true\n56: \n57:     - name: Add automation user to sshd AllowGroups if configured\n58:       ansible.builtin.user:\n59:         name: \"{{ target_user }}\"\n60:         groups: \"{{ item }}\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
