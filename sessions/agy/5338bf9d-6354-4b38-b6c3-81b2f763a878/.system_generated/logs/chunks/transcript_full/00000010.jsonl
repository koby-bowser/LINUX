ody)\n        pass_targets = list(set([p.strip() for p in passes if not p.strip().startswith(\\\"$\\\")]))\n        \n        if server_names:\n            servers.append({\n                \\\"conf\\\": os.path.basename(filepath),\n                \\\"domains\\\": server_names,\n                \\\"root\\\": doc_root,\n                \\\"targets\\\": pass_targets\n            })\n    return servers\n\nall_servers = []\nfor p in sorted(glob.glob(\\\"/etc/nginx/sites-enabled/*\\\")):\n    if os.path.isfile(p):\n        all_servers.extend(parse_nginx_file(p))\n\nprint(f\\\"Total server blocks with domains: {len(all_servers)}\\\")\nfor s in all_servers[:10]:\n    print(s[\\\"conf\\\"], \\\"->\\\", s[\\\"domains\\\"], \\\"root:\\\", s[\\\"root\\\"], \\\"targets:\\\", s[\\\"targets\\\"])\n\"'","Cwd":"/home/koby/LINUX","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing brace-depth nginx parser on fe1","toolSummary":"Test brace-depth parser"}}]}
