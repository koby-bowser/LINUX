          Specify alternative .kdbx path (default: Documents/keePassXC/OMT_PFS.SYSTEME.ALL.kdbx)\n36:     -j, --json             Output raw JSON for scripting/automation\n37:     -h, --help             Show this help message\n38: \n39:\n<truncated 17 bytes>\ns:${C_RESET}\n40:     $(basename \"$0\") 172.30.231\n41:     $(basename \"$0\") -r mtq-mailsrvp-01\n42:     $(basename \"$0\") mail\n43:     $(basename \"$0\") --sync\n44: USAGE\n45:     exit 0\n46: }\n47: \n48: if [[ $# -eq 0 ]]; then\n49:     usage\n50: fi\n51: \n52: SYNC=false\n53: JSON_OUT=false\n54: REVEAL=false\n55: DB_PATH=\"\"\n56: SEARCH_TERM=\"\"\n57: \n58: while [[ $# -gt 0 ]]; do\n59:     case \"$1\" in\n60:         -h|--help)\n61:             usage\n62:             ;;\n63:         --sync)\n64:             SYNC=true\n65:             shift\n66:             ;;\n67:         --db)\n68:             DB_PATH=\"$2\"\n69:             shift 2\n70:             ;;\n71:         -j|--json)\n72:             JSON_OUT=true\n73:             shift\n74:             ;;\n75:         -r|--reveal)\n76:             REVEAL=true\n77:             shift\n78:             ;;\n79:         *)\n80:             SEARCH_TERM=\"$1\"\n81:             shift\n82:             ;;\n83:     esac\n84: done\n85: \n86: if [ \"$SYNC\" = true ] || [ ! -f \"$POOL_JSON\" ]; then\n87:     echo -e \"${C_BOLD}=== [Synchronizing Server Pool from KeePass] ===${C_RESET}\"\n88:     read -s -p \"Enter KeePass Master Password: \" MASTER_PASS\n89:     echo \"\"\n90:     \n91:     EXTRA_ARGS=()\n92:     if [ -n \"$DB_PATH\" ]; then\n93:         EXTRA_ARGS+=(\"--db\" \"$DB_PATH\")\n94:     fi\n95:     if [ -n \"$SEARCH_TERM\" ]; then\n96:         EXTRA_ARGS+=(\"--search\" \"$SEARCH_TERM\")\n97:     fi\n98:     if [ \"$JSON_OUT\" = true ]; then\n99:         EXTRA_ARGS+=(\"--json-output\")\n100:     fi\n101:     if [ \"$REVEAL\" = true ]; then\n102:         EXTRA_ARGS+=(\"--reveal-secrets\")\n103:     fi\n104: \n105:     echo \"$MASTER_PASS\" | \"$PARSER\" \"${EXTRA_ARGS[@]}\" --sync\n106:     unset MASTER_PASS\n107:     exit 0\n108: fi\n109: \n110: # Fast search using cached pool\n111: CMD=(\"$PARSER\" \"--search\" \"$SEARCH_TERM\")\n112: if [ \"$JSON_OUT\" = true ]; then\n113:     CMD+=(\"--json-output\")\n114: fi\n115: if [ \"$REVEAL\" = true ]; then\n116:     CMD+=(\"--reveal-secrets\")\n117: fi\n118: \n119: \"${CMD[@]}\"\n120: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
