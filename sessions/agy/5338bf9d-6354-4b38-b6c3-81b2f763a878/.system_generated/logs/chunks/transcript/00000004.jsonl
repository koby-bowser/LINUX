present on <REMOTE_HOST> with passwordless SSH.\n39:     2. If missing, connects via admin user to create '${TARGET_USER}', dynamically\n40:        respects sshd AllowGroups & AuthorizedKeysFile, installs your Debian Trixie\n41:        ed25\n<truncated 7022 bytes>\n_sudo tee -a \"\\$RESOLVED_PATH\" >/dev/null\n219:     fi\n220:     run_sudo chmod 600 \"\\$RESOLVED_PATH\"\n221:     run_sudo chown \"\\$TARGET:\\$TARGET_GID\" \"\\$RESOLVED_PATH\" 2>/dev/null || run_sudo chown root:root \"\\$RESOLVED_PATH\"\n222: fi\n223: \n224: echo \"Remote bootstrap completed successfully.\"\n225: REMOTE_SCRIPT\n226:     )\n227: \n228:     if [ -n \"$ADMIN_PASS\" ]; then\n229:         sshpass -p \"$ADMIN_PASS\" ssh -p \"${SSH_PORT}\" -o \"StrictHostKeyChecking=accept-new\" \"${ADMIN_USER}@${REMOTE_HOST}\" \"bash -s\" <<< \"${BOOTSTRAP_PAYLOAD}\"\n230:         unset ADMIN_PASS\n231:     else\n232:         ssh -p \"${SSH_PORT}\" -o \"StrictHostKeyChecking=accept-new\" \"${ADMIN_USER}@${REMOTE_HOST}\" \"bash -s\" <<< \"${BOOTSTRAP_PAYLOAD}\"\n233:     fi\n234: \n235:     # Re-verify passwordless connectivity\n236:     echo -e \"\\n${C_BOLD}=== [Verifying Passwordless SSH Connection] ===${C_RESET}\"\n237:     if ssh \"${SSH_TEST_OPTS[@]}\" \"${TARGET_USER}@${REMOTE_HOST}\" \"id -u ${TARGET_USER}\" >/dev/null 2>&1; then\n238:         echo -e \"${C_GREEN}[OK] Verified! Passwordless SSH login successful as '${TARGET_USER}'.${C_RESET}\"\n239:     else\n240:         echo -e \"${C_RED}[ERROR] Failed to establish passwordless SSH connection as '${TARGET_USER}'. Check remote sshd logs.${C_RESET}\" >&2\n241:         exit 1\n242:     fi\n243: fi\n244: \n245: # 3. Execute Ansible Playbook\n246: echo -e \"\\n${C_BOLD}=== [Step 2: Executing Ansible Playbook] ===${C_RESET}\"\n247: echo -e \"Running: ${C_BLUE}ansible-playbook -i \\\"${REMOTE_HOST},\\\" playbooks/copy-to-tmp.yml -u ${TARGET_USER} -e \\\"src_file=${FILE_PATH}\\\"${C_RESET}\\n\"\n248: \n249: cd \"${ANSIBLE_DIR}\"\n250: ansible-playbook \\\n251:     -i \"${REMOTE_HOST},\" \\\n252:     \"${PLAYBOOK}\" \\\n253:     -u \"${TARGET_USER}\" \\\n254:     --private-key \"${PRIVKEY_PATH}\" \\\n255:     -e \"ansible_port=${SSH_PORT}\" \\\n256:     -e \"src_file=${FILE_PATH}\"\n257: \n258: echo -e \"\\n${C_GREEN}${C_BOLD}[SUCCESS] Transfer completed successfully to /tmp on ${REMOTE_HOST}!${C_RESET}\"\n259: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
