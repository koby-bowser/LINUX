s/dev/hosts.yml playbooks/check-distro-kernel.yml \\\n26: #     -e target_hosts=trp-wextd-be1\n27: # ==============================================================================\n28: \n29: - name: In\n<truncated 3597 bytes>\n           {% if is_unreach %}\n93:           {% set ns.unreachable = ns.unreachable + 1 %}\n94:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('UNREACHABLE') }} | {{ '%-38s' | format('N/A (unreachable)') }} | {{ '%-26s' | format('N/A') }}\n95:           {% elif is_failed %}\n96:           {% set ns.failed = ns.failed + 1 %}\n97:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('FAILED') }} | {{ '%-38s' | format('N/A (setup failed)') }} | {{ '%-26s' | format('N/A') }}\n98:           {% elif not af or 'distribution' not in af %}\n99:           {% set ns.no_data = ns.no_data + 1 %}\n100:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('NO DATA') }} | {{ '%-38s' | format('N/A (no facts)') }} | {{ '%-26s' | format('N/A') }}\n101:           {% else %}\n102:           {% set ns.online = ns.online + 1 %}\n103:           {% set d_name = af.get('distribution', 'Unknown') %}\n104:           {% set d_ver = af.get('distribution_version', '') %}\n105:           {% set d_rel = af.get('distribution_release', '') %}\n106:           {% set d_str = d_name ~ ' ' ~ d_ver ~ (' (' ~ d_rel ~ ')' if d_rel else '') %}\n107:           {% set k_ver = af.get('kernel', 'Unknown') %}\n108:           {{ '%-24s' | format(h) }} | {{ '%-12s' | format('ONLINE') }} | {{ '%-38s' | format(d_str) }} | {{ '%-26s' | format(k_ver) }}\n109:           {% endif %}\n110:           {% endfor %}\n111:           ----------------------------------------------------------------------------------------------------------------------------------\n112:           Summary: Total: {{ ansible_play_hosts_all | length }} | Online: {{ ns.online }} | Unreachable: {{ ns.unreachable }} | Failed: {{ ns.failed }}{% if ns.no_data > 0 %} | No Data: {{ ns.no_data }}{% endif %}\n113: