{"step_index":116,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-07T14:02:42Z","content":"Created At: 2026-09-07T18:02:42+04:00\nCompleted At: 2026-09-07T18:02:42+04:00\nFile Path: `file:///home/koby/infra-management-system/roles/bootstrap_spui_runner/tasks/main.yml`\nTotal Lines: 75\nTotal Bytes: 2393\nShowing lines 1 to 75\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: ---\n2: - name: Assert spui_runner_pubkey is set\n3:   ansible.builtin.assert:\n4:     that:\n5:       - spui_runner_pubkey is defined\n6:       - spui_runner_pubkey | length > 0\n7:       - spui_runner_pubkey is match('^(ssh-(rsa|ed25519|dss)|ecdsa-sha2-).*')\n8:     fail_msg: \"Variable 'spui_runner_pubkey' must contain the runner public key (ssh-ed25519/rsa/...).\"\n9: \n10: - name: Ensure SSH access group exists\n11:   ansible.builtin.group:\n12:     name: \"{{ spui_runner_group }}\"\n13:     state: present\n14:     system: false\n15: \n16: - name: Ensure spui-runner user exists in SSH group\n17:   ansible.builtin.user:\n18:     name: \"{{ spui_runner_user }}\"\n19:     shell: \"{{ spui_runner_shell }}\"\n20:     create_home: true\n21:     groups: \"{{ spui_runner_group }}\"\n22:     append: true\n23:     state: present\n24: \n25: - name: Allow passwordless sudo for spui-runner\n26:   ansible.builtin.copy:\n27:     dest: \"{{ spui_runner_sudoers_file }}\"\n28:     content: \"{{ spui_runner_user }} ALL=(ALL) NOPASSWD:ALL\\n\"\n29:     owner: root\n30:     group: root\n31:     mode: \"0440\"\n32:     validate: /usr/sbin/visudo -cf %s\n33: \n34: - name: Ensure centralized authorized_keys directory exists\n35:   ansible.builtin.file:\n36:     path: \"{{ spui_runner_authorized_keys_dir }}\"\n37:     state: directory\n38:     owner: root\n39:     group: root\n40:     mode: \"0755\"\n41: \n42: - name: Install runner public key in centralized authorized_keys\n43:   ansible.builtin.copy:\n44:     dest: \"{{ spui_runner_authorized_keys_dir }}/{{ spui_runner_user }}\"\n45:     content: \"{{ spui_runner_pubkey }}\\n\"\n46:     owner: root\n47:     group: root\n48:     mode: \"0644\"\n49: \n50: - name: Detect existing AllowGroups directive in sshd_config\n51:   ansible.builtin.shell:\n52:     cmd: \"grep -E '^[[:space:]]*AllowGroups[[:space:]]+' {{ sshd_config_path }} || true\"\n53:   register: _allowgroups_check\n54:   changed_when: false\n55:   check_mode: false\n56: \n57: - name: Append SSH access group to existing AllowGroups directive (if missing)\n58:   ansible.builtin.replace:\n59:     path: \"{{ sshd_config_path }}\"\n60:     regexp: '^([[:space:]]*AllowGroups[[:space:]]+(?!.*\\b{{ spui_runner_group }}\\b).*)$'\n61:     replace: '\\1 {{ spui_runner_group }}'\n62:     validate: /usr/sbin/sshd -t -f %s\n63:   when: _allowgroups_check.stdout | length > 0\n64:   notify: Reload sshd\n65: \n66: - name: Add AllowGroups directive at EOF (if absent)\n67:   ansible.builtin.lineinfile:\n68:     path: \"{{ sshd_config_path }}\"\n69:     line: \"AllowGroups {{ spui_runner_group }}\"\n70:     state: present\n71:     insertafter: EOF\n72:     validate: /usr/sbin/sshd -t -f %s\n73:   when: _allowgroups_check.stdout | length == 0\n74:   notify: Reload sshd\n75: \nThe above content shows the entire, complete file contents of the requested file.\n"}
