t labelDoYouWantToSaveChanges = 'Do you want to save the changes?';\nexport const labelDoYouWantToResolveErrors =\n  'Do you want to resolve the errors?';\nexport const labelAND = 'AND';\nexport const labelIsEqualTo = 'is equal to';\nexport const labelIsDifferentFrom = 'is different from';\nexport const labelContains = 'contains';\nexport const labelDoesNotContains = 'does not contain';\nexport const labelPropertyName = 'Property name';\nexport const labelValueSearched = 'Value searched';\nexport const labelPropertyUsed = 'Property used';\nexport const labelIndexUsed = 'Index used';\nexport const labelWhichResultPropertyDoYouWantToFilterOn =\n  'Which result property do you want to filter on?';\nexport const labelWhichResultPropertyDoYouWantToUse =\n  'Which result property do you want to use for your condition?';\nexport const labelWhichResultKeyDoYouWantToUse =\n  'Which result key do you want to use for your condition?';\nexport const labelResultPropertyFiltered = 'Result property filtered';\nexport const labelResultPropertyUsed = 'Result property used';\nexport const labelResultKeyUsed = 'Result key used';\nexport const labelCancelAdvancedSourceConfiguration =\n  'Cancel the advanced source configuration?';\nexport const labelAdvancedSourceConfiguration = 'Advanced source configuration';\nexport const labelExportAndReloadPollersConfiguration =\n  \"Export and reload pollers' configuration\";\nexport const labelUpdateExistingHosts =\n  'Update existing hosts (applicable for mappers of type Macro, Template, Host group, Host category, Host Severity, Monitoring)';\nexport const labelAddAsNewHost = 'Add as new host';\nexport const labelUpdateExistingHostsConfiguration =\n  \"Update existing host's configuration\";\nexport const labelDoNotApplyTheDefaultTemplate =\n  'Do not discover hosts for which mappers apply no template';\nexport const labelToolTipDoNotApplyTheDefaultTemplate =\n  'If the box is unchecked, the default template ( {{defaultTemplate}} ) will be appl