spatch<SetStateAction<HTMLElement | null>>;\n}\n\nexport const useViewportIntersection = (\n  options?: IntersectionObserverInit\n): ViewportIntersectionState => {\n  const [entry, setEntry] = useState<IntersectionObserverEntry | null>(null);\n  const [element, setElement] = useState<HTMLElement | null>(null);\n\n  const observer = useRef<IntersectionObserver | null>(null);\n\n  useEffect(() => {\n    if (observer.current) {\n      observer.current.disconnect();\n    }\n\n    observer.current = new window.IntersectionObserver(\n      ([newEntry]) => setEntry(newEntry),\n      options\n    );\n\n    if (element) {\n      observer.current.observe(element);\n    }\n\n    return (): void => {\n      observer.current?.disconnect();\n    };\n  }, [element]);\n\n  return {\n    isInViewport: entry?.isIntersecting ?? true,\n    setElement\n  };\n};\n","import { FormikErrors, FormikValues } from 'formik';\nimport { isEmpty } from 'ramda';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Button, Grid, useTheme } from '@mui/material';\n\nconst useStyles = makeStyles()({\n  actionButtons: {\n    alignItems: 'center',\n    display: 'grid',\n    grid: 'auto / auto auto',\n    justifyContent: 'flex-end'\n  }\n});\n\ninterface Props {\n  dirty: boolean;\n  errors: FormikErrors<FormikValues>;\n  labelCancel: string;\n  labelSave: string;\n  onCancel: () => void;\n  submitForm: () => void;\n}\n\nconst ActionButtons = ({\n  labelCancel,\n  labelSave,\n  dirty,\n  errors,\n  submitForm,\n  onCancel\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  const theme = useTheme();\n\n  return (\n    <Grid item style={{ padding: theme.spacing(0, 1, 1) }}>\n      <div className={classes.actionButtons}>\n        <Button color=\"primary\" type=\"button\" onClick={onCancel}>\n          {labelCancel}\n        </Button>\n        <Button\n          aria-label={labelSave}\n          color=\"primary\"\n          disabled={!isEmpty(errors) || !dirty}\n          type=\"button\"\n          onClick={(): void => {\n            submitForm();\n          }}\n        >\n          {labelSave}\n        </Button>\n      </div>\n    </Grid>\n  );\n};\n\nexport default ActionButtons;\n","import { useState } from 'react';\n\nimport { Formik } from 'formik';\nimport { find, values as objectValues, propEq } from 'ramda';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Grid } from '@mui/material';\n\nimport {\n  labelCancel,\n  labelRequired,\n  labelSave\n} from '../../../../translatedLabels';\nimport { Mapper, ProviderAttributes, Rule, Translation } from '../../../models';\nimport rules from '../../Rules';\n\nimport { AnyObjectSchema, object, string } from 'yup';\nimport ActionButtons from './ActionButtons';\nimport MapperType from './MapperTypeAutocomplete';\n\nconst baseValidationSchema = {\n  type: string().nullable().required(labelRequired)\n};\n\ninterface Props {\n  mapper: Mapper;\n  onCancel: () => void;\n  onSubmit: (mapper: Mapper) => void;\n  sources: ProviderAttributes | null;\n  t: Translation;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  mapperForm: {\n    flex: '1',\n    paddingTop: theme.spacing(1)\n  }\n}));\n\nconst Edit = ({\n  mapper,\n  onCancel,\n  onSubmit,\n  sources,\n  t\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  const [initialValues, setInitialValues] = useState(mapper);\n\n  const getRule = (ruleType): Rule => {\n    const rulesValues = objectValues(rules);\n\n    return find<Rule>(propEq(ruleType, 'type'), rulesValues) as Rule;\n  };\n\n  const getValidationSchema = (ruleType): AnyObjectSchema => {\n    const rule = getRule(ruleType);\n    const additionalSchema = rule\n      ? rule.validationSchema\n      : (): Record<string, unknown> => ({});\n\n    return object().shape({\n      ...baseValidationSchema,\n      ...additionalSchema(t)\n    });\n  };\n\n  const [rule, setRule] = useState<Rule | null>(getRule(mapper.type));\n  const [validationSchema, setValidationSchema] = useState(\n    getValidationSchema(mapper.type)\n  );\n\n  const handleTypeChange = (updatedType): void => {\n    if (updatedType) {\n      const newRule = getRule(updatedType.id);\n      const newInitialValues = newRule.initialValues || {\n        parameters: {\n          conditions: [],\n          source: undefined\n        },\n        type: updatedType.id\n      };\n      setInitialValues({\n        ...mapper,\n        ...newInitialValues\n      });\n      setValidationSchema(getValidationSchema(updatedType.id));\n      setRule(newRule);\n    } else {\n      setInitialValues({\n        ...mapper,\n        parameters: {\n          conditions: [],\n          source: []\n        },\n        type: null\n      });\n      setValidationSchema(object().shape(baseValidationSchema));\n      setRule(null);\n    }\n  };\n\n  const MapperForm = rule?.Form;\n\n  return (\n    <div className={classes.mapperForm}>\n      <Formik\n        enableReinitialize\n        validateOnMount\n        initialValues={initialValues}\n        validationSchema={validationSchema}\n        onSubmit={(values): void => {\n          onSubmit(values);\n        }}\n      >\n        {({\n          errors,\n          handleBlur,\n          handleChange,\n          setFieldTouched,\n          setFieldValue,\n          submitForm,\n          touched,\n          values,\n          dirty\n        }): JSX.Element => {\n          return (\n            <Grid container direction=\"column\" spacing={1}>\n              <Grid item>\n                <MapperType values={values} onChange={handleTypeChange} />\n              </Grid>\n              <Grid item>\n                {MapperForm && (\n                  <MapperForm\n                    errors={errors}\n                    handleBlur={handleBlur}\n                    handleChange={handleChange}\n                    setFieldTouched={setFieldTouched}\n                    setFieldValue={setFieldValue}\n                    sources={sources}\n                    touched={touched}\n                    values={values}\n                  />\n                )}\n              </Grid>\n              <ActionButtons\n                dirty={dirty}\n                errors={errors}\n                labelCancel={t(labelCancel)}\n                labelSave={t(labelSave)}\n                submitForm={submitForm}\n                onCancel={onCancel}\n              />\n            </Grid>\n          );\n        }}\n      </Formik>\n    </div>\n  );\n};\n\nexport default Edit;\n","import { memo } from 'react';\n\nimport { FormikValues } from 'formik';\nimport {\n  equals,\n  find,\n  map,\n  values as objectValues,\n  prop,\n  propEq,\n  sortBy\n} from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { SelectEntry, SingleAutocompleteField } from '@centreon/ui';\n\nimport { labelMapperType } from '../../../../../translatedLabels';\nimport { Rule } from '../../../../models';\nimport rules from '../../../Rules';\n\nconst fieldName = 'type';\n\ninterface Props {\n  onChange: (type: SelectEntry) => void;\n  values: FormikValues;\n}\n\nconst MapperTypeAutocomplete = ({ onChange, values }: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const handleChange = (_, value): void => {\n    onChange(value);\n  };\n\n  const rulesValues = objectValues(rules);\n\n  const sortedRulesValues = sortBy(prop('order'))(rulesValues);\n\n  const options = map<Rule, SelectEntry>(\n    ({ title, type }) => ({\n      id: type,\n      name: title\n    }),\n    sortedRulesValues\n  );\n\n  const value =\n    (find(propEq(prop(fieldName, values), 'id'))(options) as SelectEntry) ||\n    null;\n\n  const getTranslatedOption = (option): string => t(option.name);\n\n  return (\n    <SingleAutocompleteField\n      label={t(labelMapperType)}\n      options={options}\n      renderOption={(renderProps, option): JSX.Element => {\n        return <li {...renderProps}>{getTranslatedOption(option)}</li>;\n      }}\n      size=\"small\"\n      value={value}\n      onChange={handleChange}\n    />\n  );\n};\n\nconst MemoizedMapperTypeAutocomplete = memo(\n  MapperTypeAutocomplete,\n  (prevProps, nextProps) => equals(prevProps.values.type, nextProps.values.type)\n);\n\nexport default MemoizedMapperTypeAutocomplete;\n","import { MouseEvent, memo, useState } from 'react';\n\nimport { equals, find, not, or, prop, propEq, values } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport DuplicateIcon from '@mui/icons-material/ContentCopy';\nimport DeleteIcon from '@mui/icons-material/Delete';\nimport EditIcon from '@mui/icons-material/Edit';\nimport IconMore from '@mui/icons-material/MoreHoriz';\nimport { Typography } from '@mui/material';\n\nimport {\n  ActionsList,\n  ConfirmDialog,\n  DuplicateDialog,\n  PopoverMenu\n} from '@centreon/ui';\n\nimport {\n  labelAskDeleteMapper,\n  labelCancel,\n  labelDelete,\n  labelDuplicate,\n  labelDuplicateMapper,\n  labelEdit,\n  labelMoreActions,\n  labelNbOfCopies\n} from '../../../../translatedLabels';\nimport { Mapper, Rule } from '../../../models';\nimport rules from '../../Rules';\n\nconst useStyles = makeStyles()((theme) => ({\n  buttonsItem: {\n    display: 'grid',\n    grid: 'auto-flow / repeat(2, min-content)',\n    gridArea: 'buttons',\n    justifySelf: 'end'\n  },\n  container: {\n    alignItems: 'center',\n    display: 'grid',\n    grid: `\"type preview buttons\" ${theme.spacing(5)} / ${theme.spacing(\n      13\n    )} auto min-content`,\n    width: '100%'\n  },\n  popover: {\n    width: theme.spacing(17)\n  },\n  previewItem: {\n    gridArea: 'preview',\n    height: '100%',\n    minWidth: 0,\n    overflow: 'hidden',\n    padding: '0px 10px'\n  },\n  typeItem: {\n    gridArea: 'type'\n  },\n  typeTypo: {\n    flex: 1,\n    fontSize: '1rem',\n    margin: 'auto'\n  }\n}));\n\ninterface ReadContentProps {\n  mapper: Mapper;\n}\n\nconst ReadContent = ({ mapper }: ReadContentProps): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const getRule = (ruleType): Rule =>\n    find(propEq(ruleType, 'type'), values(rules)) as Rule;\n\n  const getMapperTitleFromType = (type): string => prop('title', getRule(type));\n\n  const getPreview = (ruleType): JSX.Element | null => {\n    const rule = getRule(ruleType);\n    const Component = rule ? rule.Preview : null;\n\n    return Component ? Component({ mapper }) : null;\n  };\n\n  const Preview = getPreview(mapper.type);\n\n  return (\n    <>\n      <div className={classes.typeItem}>\n        <Typography className={classes.typeTypo} variant=\"body2\">\n          {t(getMapperTitleFromType(mapper.type))}\n        </Typography>\n      </div>\n\n      <div className={classes.previewItem}>{Preview}</div>\n    </>\n  );\n};\n\nconst MemoizedReadContent = memo(ReadContent, equals);\n\ninterface Props extends ReadContentProps {\n  onDelete: (id: number, e) => void;\n  onDuplicate: (duplicationCount: number) => () => void;\n  onEdit: (event: MouseEvent<HTMLButtonElement>) => void;\n}\n\nconst Read = ({\n  mapper,\n  onEdit,\n  onDelete,\n  onDuplicate\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const [openDelete, setOpenDelete] = useState(false);\n  const [openDuplicate, setOpenDuplicate] = useState(false);\n\n  const handleDelete = (): void => {\n    setOpenDelete(true);\n  };\n\n  const handleCancelDelete = (): void => {\n    setOpenDelete(false);\n  };\n\n  const handleDuplicate = (): void => {\n    setOpenDuplicate(true);\n  };\n\n  const handleCancelDuplicate = (): void => {\n    setOpenDuplicate(false);\n  };\n\n  const handleConfirmDuplicate = (_, count): void => {\n    onDuplicate(Number.parseInt(count, 10))();\n    setOpenDuplicate(false);\n  };\n\n  const actions = [\n    {\n      Icon: DuplicateIcon,\n      label: labelDuplicate,\n      onClick: handleDuplicate\n    },\n    {\n      Icon: EditIcon,\n      label: labelEdit,\n      onClick: onEdit\n    },\n    {\n      Icon: DeleteIcon,\n      label: labelDelete,\n      onClick: handleDelete\n    }\n  ];\n\n  const displayActionsPopup = not(or(openDuplicate, openDelete));\n\n  return (\n    <div className={classes.container}>\n      <MemoizedReadContent mapper={mapper} />\n      <div className={classes.buttonsItem}>\n        <PopoverMenu\n          icon={\n            <IconMore\n              aria-label={t(labelMoreActions)}\n              color=\"primary\"\n              fontSize=\"small\"\n            />\n          }\n          title={t(labelMoreActions)}\n        >\n          {(): JSX.Element => (\n            <div className={classes.popover}>\n              {displayActionsPopup && <ActionsList actions={actions} />}\n            </div>\n          )}\n        </PopoverMenu>\n      </div>\n\n      <ConfirmDialog\n        labelCancel={t(labelCancel)}\n        labelConfirm={t(labelDelete)}\n        labelTitle={t(labelAskDeleteMapper)}\n        open={openDelete}\n        onCancel={handleCancelDelete}\n        onConfirm={onDelete}\n      />\n\n      <DuplicateDialog\n        labelCancel={t(labelCancel)}\n        labelConfirm={t(labelDuplicate)}\n        labelInput={t(labelNbOfCopies)}\n        labelTitle={t(labelDuplicateMapper)}\n        limit={10}\n        open={openDuplicate}\n        onCancel={handleCancelDuplicate}\n        onConfirm={handleConfirmDuplicate}\n      />\n    </div>\n  );\n};\n\nexport default Read;\n","import { useTranslation } from 'react-i18next';\n\nimport { Mapper as MapperProps, ProviderAttributes } from '../../../models';\n\nimport Edit from './Edit';\nimport Read from './Read';\n\ninterface DuplicationInterface {\n  duplicationCount: number;\n  mapperId: number;\n}\n\ninterface Props {\n  mapper: MapperProps;\n  onCancel: (mapperId: number) => void;\n  onDelete: (mapperId: number) => void;\n  onDuplicate: ({ duplicationCount, mapperId }: DuplicationInterface) => void;\n  onEdit: (mapperId: number) => void;\n  onSave: (mapper: MapperProps) => void;\n  sources: ProviderAttributes | null;\n}\n\nconst Mapper = ({\n  mapper,\n  onEdit,\n  onDuplicate,\n  onCancel,\n  onDelete,\n  onSave,\n  sources\n}: Props): JSX.Element => {\n  const handleEdit = (): void => {\n    onEdit(mapper.id as number);\n  };\n\n  const handleDuplicate = (duplicationCount: number) => (): void => {\n    onDuplicate({ duplicationCount, mapperId: mapper.id as number });\n  };\n\n  const handleCancel = (): void => {\n    onCancel(mapper.id as number);\n  };\n\n  const handleDelete = (): void => {\n    onDelete(mapper.id as number);\n  };\n\n  const handleSubmit = (values: MapperProps): void => {\n    onSave(values);\n  };\n  const { t } = useTranslation();\n\n  return mapper.editing ? (\n    <Edit\n      mapper={mapper}\n      sources={sources}\n      t={t}\n      onCancel={handleCancel}\n      onSubmit={handleSubmit}\n    />\n  ) : (\n    <Read\n      mapper={mapper}\n      onDelete={handleDelete}\n      onDuplicate={handleDuplicate}\n      onEdit={handleEdit}\n    />\n  );\n};\n\nexport default Mapper;\n","import { CSSProperties, ForwardedRef, forwardRef } from 'react';\n\nimport { DraggableSyntheticListeners } from '@dnd-kit/core';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport MoveIcon from '@mui/icons-material/UnfoldMore';\nimport { Box, Grid, Paper } from '@mui/material';\n\nimport { labelSortMapper } from '../../../../translatedLabels';\nimport Mapper from '../Mapper';\n\nimport { SortableMapperProps } from './SortableMapper';\n\ninterface Props extends SortableMapperProps {\n  isDragging?: boolean;\n  isOverlay?: boolean;\n  listeners?: DraggableSyntheticListeners;\n  style?: CSSProperties;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  dragHandle: {\n    alignSelf: 'center',\n    cursor: 'grab',\n    height: theme.spacing(3)\n  },\n  draggingMapper: {\n    opacity: '0.5'\n  },\n  icon: {\n    fontSize: 24\n  },\n  mapperContainer: {\n    alignItem: 'center',\n    display: 'flex',\n    padding: theme.spacing(0, 1)\n  },\n  overlay: {\n    boxShadow: theme.shadows[3]\n  },\n  sortableMapper: {\n    padding: theme.spacing(1, 0)\n  }\n}));\n\nconst Item = forwardRef(\n  (\n    {\n      id,\n      mapper,\n      onCancel,\n      onDelete,\n      onEdit,\n      onDuplicate,\n      onSave,\n      sources,\n      listeners,\n      style,\n      isOverlay,\n      isDragging,\n      ...props\n    }: Props,\n    ref: ForwardedRef<HTMLDivElement>\n  ): JSX.Element => {\n    const { classes, cx } = useStyles();\n    const { t } = useTranslation();\n\n    return (\n      <div\n        aria-label={`mapper_${id}`}\n        className={cx(classes.sortableMapper, {\n          [classes.draggingMapper]: isDragging\n        })}\n        ref={ref}\n        style={style}\n      >\n        <Grid item>\n          <Paper\n            className={cx(classes.mapperContainer, {\n              [classes.overlay]: isOverlay\n            })}\n          >\n            <Box alignItems=\"center\" display=\"flex\" flex={1}>\n              <Mapper\n                mapper={mapper}\n                sources={sources}\n                onCancel={onCancel}\n                onDelete={onDelete}\n                onDuplicate={onDuplicate}\n                onEdit={onEdit}\n                onSave={onSave}\n              />\n            </Box>\n            <div\n              aria-label={`${t(labelSortMapper)}_${id}`}\n              className={classes.dragHandle}\n              {...listeners}\n              {...props}\n            >\n              <MoveIcon className={classes.icon} />\n            </div>\n          </Paper>\n        </Grid>\n      </div>\n    );\n  }\n);\n\nexport default Item;\n","import { CSSProperties } from 'react';\n\nimport { useSortable } from '@dnd-kit/sortable';\nimport { CSS } from '@dnd-kit/utilities';\n\nimport { Mapper, ProviderAttributes } from '../../../models';\n\nimport Item from './Item';\n\nexport interface SortableMapperProps {\n  id: string;\n  mapper: Mapper;\n  onCancel;\n  onDelete;\n  onDuplicate;\n  onEdit;\n  onSave;\n  sources: ProviderAttributes | null;\n}\n\nconst SortableMapper = ({\n  id,\n  mapper,\n  onCancel,\n  onDelete,\n  onEdit,\n  onSave,\n  sources,\n  onDuplicate\n}: SortableMapperProps): JSX.Element => {\n  const {\n    attributes,\n    listeners,\n    setNodeRef,\n    transform,\n    transition,\n    isDragging\n  } = useSortable({ id });\n\n  const style: CSSProperties = {\n    transform: CSS.Translate.toString(transform),\n    transition: transition || undefined\n  };\n\n  return (\n    <Item\n      id={id}\n      isDragging={isDragging}\n      listeners={listeners}\n      mapper={mapper}\n      ref={setNodeRef}\n      sources={sources}\n      style={style}\n      onCancel={onCancel}\n      onDelete={onDelete}\n      onDuplicate={onDuplicate}\n      onEdit={onEdit}\n      onSave={onSave}\n      {...attributes}\n    />\n  );\n};\n\nexport default SortableMapper;\n","import { useMemo, useState } from 'react';\n\nimport {\n  DndContext,\n  DragOverlay,\n  KeyboardSensor,\n  PointerSensor,\n  closestCenter,\n  useSensor,\n  useSensors\n} from '@dnd-kit/core';\nimport {\n  SortableContext,\n  sortableKeyboardCoordinates,\n  verticalListSortingStrategy\n} from '@dnd-kit/sortable';\nimport { FormikErrors, FormikValues } from 'formik';\nimport { indexOf, isNil, move, not, pipe } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport AddIcon from '@mui/icons-material/Add';\nimport { Alert, Button, Grid, Typography } from '@mui/material';\n\nimport { labelAddMapper, labelMappers } from '../../../translatedLabels';\nimport { Mapper, ProviderAttributes } from '../../models';\n\nimport Item from './Sortable/Item';\nimport SortableMapper from './Sortable/SortableMapper';\n\ninterface StylesProps {\n  isEditing?: boolean;\n}\n\nconst useStyles = makeStyles<StylesProps>()((theme, { isEditing }) => ({\n  container: {\n    padding: theme.spacing(isEditing ? 0.5 : 1.5, 1, 0),\n    width: '100%'\n  }\n}));\n\ninterface Props {\n  displayMappersOnly?: boolean;\n  edit?: boolean;\n  errors: FormikErrors<FormikValues>;\n  mappers: Array<Mapper>;\n  onAdd: () => void;\n  onCancel: (mapperId: number) => void;\n  onDelete: (mapperId: number) => void;\n  onDragEnd: (props) => void;\n  onDuplicate: (duplicationCount: number, mapperId: number) => void;\n  onEdit: (mapperId: number) => void;\n  onSave: (mapper: Mapper) => void;\n  sources: ProviderAttributes | null;\n}\n\nconst MappersListing = ({\n  errors,\n  mappers,\n  onAdd,\n  onCancel,\n  onDelete,\n  onDragEnd,\n  onEdit,\n  onSave,\n  onDuplicate,\n  sources,\n  edit,\n  displayMappersOnly\n}: Props): JSX.Element => {\n  const { classes } = useStyles({ isEditing: edit || displayMappersOnly });\n  const { t } = useTranslation();\n  const [activeMapper, setActiveMapper] = useState<Mapper | null>(null);\n  const sensors = useSensors(\n    useSensor(PointerSensor),\n    useSensor(KeyboardSensor, {\n      coordinateGetter: sortableKeyboardCoordinates\n    })\n  );\n\n  const { requiredAttributes, mapperMonitoringRequired } = errors;\n\n  const sortableMappers = useMemo(\n    () => mappers.map((mapper) => `${mapper.id}`),\n    [mappers]\n  );\n\n  const dragStart = (event): void => {\n    const activeIndex = indexOf(event.active.id, sortableMappers);\n    setActiveMapper(mappers[activeIndex]);\n  };\n\n  const dragEnd = (event): void => {\n    const { active, over } = event;\n\n    if (active.id !== over.id) {\n      const oldIndex = indexOf(active.id, sortableMappers);\n      const newIndex = indexOf(over.id, sortableMappers);\n      onDragEnd(move(oldIndex, newIndex, mappers));\n    }\n    setActiveMapper(null);\n  };\n\n  return (\n    <div aria-label={t(labelMappers)}>\n      <Grid container className={classes.container} direction=\"column\">\n        <DndContext\n          collisionDetection={closestCenter}\n          sensors={sensors}\n          onDragEnd={dragEnd}\n          onDragStart={dragStart}\n        >\n          <SortableContext\n            items={sortableMappers}\n            strategy={verticalListSortingStrategy}\n          >\n            {mappers.map((mapper) => (\n              <SortableMapper\n                id={`${mapper.id}`}\n                key={`${mapper.id}`}\n                mapper={mapper}\n                sources={sources}\n                onCancel={onCancel}\n                onDelete={onDelete}\n                onDuplicate={onDuplicate}\n                onEdit={onEdit}\n                onSave={onSave}\n              />\n            ))}\n          </SortableContext>\n          <DragOverlay>\n            {pipe(isNil, not)(activeMapper) ? (\n              <Item\n                isOverlay\n                id={`${activeMapper?.id}`}\n                mapper={activeMapper as Mapper}\n                sources={sources}\n                onCancel={onCancel}\n                onDelete={onDelete}\n                onDuplicate={onDuplicate}\n                onEdit={onEdit}\n                onSave={onSave}\n              />\n            ) : null}\n          </DragOverlay>\n        </DndContext>\n        <Grid item>\n          <Button\n            fullWidth\n            aria-label={labelAddMapper}\n            color=\"primary\"\n            variant=\"outlined\"\n            onClick={onAdd}\n          >\n            <AddIcon />\n            {t(labelAddMapper)}\n          </Button>\n        </Grid>\n        {requiredAttributes || mapperMonitoringRequired ? (\n          <Grid item>\n            <Alert severity=\"error\">\n              {requiredAttributes && (\n                <Typography>{requiredAttributes as string}</Typography>\n              )}\n              {mapperMonitoringRequired && (\n                <Typography>{mapperMonitoringRequired as string}</Typography>\n              )}\n            </Alert>\n          </Grid>\n        ) : null}\n      </Grid>\n    </div>\n  );\n};\n\nexport default MappersListing;\n","import { memo, useEffect, useState } from 'react';\n\nimport { addIndex, and, equals, find, isEmpty, map, propOr } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { Column, ColumnType, Listing, useRequest } from '@centreon/ui';\n\nimport {\n  labelAlias,\n  labelIPAddress,\n  labelName,\n  labelSomethingWentWrong\n} from '../../../translatedLabels';\nimport { listPreviewHosts } from '../../api';\nimport { listHostsSimulationDecoder } from '../../api/decoders';\nimport { AdditionalParameter, HostSimulation, Mapper } from '../../models';\n\nconst configuration = (t): Array<Column> => [\n  {\n    getFormattedString: (row: HostSimulation): string | null => row.host.name,\n    id: 'name',\n    label: t(labelName),\n    type: ColumnType.string\n  },\n  {\n    getFormattedString: (row: HostSimulation): string | null => row.host.alias,\n    id: 'alias',\n    label: t(labelAlias),\n    type: ColumnType.string\n  },\n  {\n    getFormattedString: (row: HostSimulation): string | null =>\n      row.host.ipAddress,\n    id: 'ipAddress',\n    label: t(labelIPAddress),\n    type: ColumnType.string\n  }\n];\n\ninterface Props {\n  credentialId: boolean | null;\n  disableNextOnSendingRequests?: (props: Array<boolean>) => void;\n  jobParameters: Array<AdditionalParameter>;\n  mappers: Array<Mapper>;\n  providerId: number;\n  sendingAttributes: boolean;\n}\n\nconst Preview = ({\n  mappers,\n  providerId,\n  credentialId,\n  jobParameters,\n  sendingAttributes,\n  disableNextOnSendingRequests\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const [hosts, setHosts] = useState<Array<HostSimulation>>([]);\n  const { sendRequest, sending } = useRequest({\n    decoder: listHostsSimulationDecoder,\n    defaultFailureMessage: t(labelSomethingWentWrong),\n    request: listPreviewHosts\n  });\n\n  useEffect(() => {\n    if (and(!isEmpty(mappers), !find(propOr(false, 'editing'))(mappers))) {\n      sendRequest({\n        credentialId,\n        jobParameters,\n        mappers,\n        providerId\n      }).then((previewHosts) => {\n        setHosts(previewHosts);\n      });\n    }\n  }, [mappers]);\n\n  useEffect(\n    () => disableNextOnSendingRequests?.([sending, sendingAttributes]),\n    [sending, sendingAttributes]\n  );\n\n  const mapIndexed = addIndex<HostSimulation>(map);\n\n  return (\n    <Listing\n      innerScrollDisabled\n      columns={configuration(t)}\n      currentPage={0}\n      limit={hosts.length}\n      loading={sending}\n      paginated={false}\n      rows={mapIndexed((host, id) => ({ ...host, id }), hosts)}\n      selectedRows={[]}\n      totalRows={hosts.length}\n    />\n  );\n};\n\nexport default memo(\n  Preview,\n  (prevProps, nextProps) =>\n    equals(prevProps.mappers, nextProps.mappers) &&\n    equals(prevProps.credentialId, nextProps.credentialId) &&\n    equals(prevProps.providerId, nextProps.providerId) &&\n    equals(prevProps.jobParameters, nextProps.jobParameters)\n);\n","import {\n  FormikErrors,\n  FormikHandlers,\n  FormikHelpers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\nimport {\n  path,\n  addIndex,\n  equals,\n  find,\n  isNil,\n  length,\n  map,\n  not,\n  pathOr,\n  propEq,\n  reject\n} from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Typography } from '@mui/material';\n\nimport { SelectEntry, SingleAutocompleteField, TextField } from '@centreon/ui';\n\nimport {\n  labelIndexUsed,\n  labelPropertyName,\n  labelPropertyUsed,\n  labelValueSearched,\n  labelWhichResultKeyDoYouWantToUse,\n  labelWhichResultPropertyDoYouWantToFilterOn,\n  labelWhichResultPropertyDoYouWantToUse\n} from '../../../../translatedLabels';\nimport { Attribute, AttributeType } from '../../../models';\n\nconst useStyles = makeStyles()((theme) => ({\n  inputs: {\n    alignItems: 'center',\n    columnGap: theme.spacing(0.5),\n    display: 'grid',\n    grid: 'auto-flow / 1fr min-content 1fr'\n  },\n  inputsContainer: {\n    display: 'grid',\n    grid: 'auto auto / auto',\n    rowGap: theme.spacing(1)\n  }\n}));\n\ninterface Props\n  extends Pick<FormikHandlers, 'handleChange' | 'handleBlur'>,\n    Pick<FormikHelpers<FormikValues>, 'setFieldTouched' | 'setFieldValue'> {\n  attributeConfiguration: Attribute;\n  errors: FormikErrors<FormikValues>;\n  fieldPath: Array<string>;\n  name: string;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst AdvancedAttribute = ({\n  attributeConfiguration,\n  fieldPath,\n  values,\n  name,\n  handleChange,\n  handleBlur,\n  setFieldTouched,\n  setFieldValue,\n  errors,\n  touched\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const { properties, type } = attributeConfiguration;\n\n  const isArrayAttribute = equals(type, AttributeType.array);\n  const hasDefinedProperties = not(isNil(properties));\n\n  const isObjectArrayAttribute = hasDefinedProperties && isArrayAttribute;\n  const isStringArrayAttribute = not(hasDefinedProperties) && isArrayAttribute;\n\n  const mapIndexed = addIndex<string, SelectEntry>(map);\n\n  const propertiesOptions = isNil(properties)\n    ? []\n    : mapIndexed(\n        (property, index) => ({ id: index, name: property }),\n        properties\n      );\n\n  const keyInputFieldPath = [...fieldPath, 'index', 'key'];\n  const keyInputName = `${name}.index.key`;\n\n  const valueInputFieldPath = [...fieldPath, 'index', 'value'];\n  const valueInputName = `${name}.index.value`;\n\n  const propertyInputFieldPath = [...fieldPath, 'property'];\n  const propertyInputName = `${name}.property`;\n\n  const indexKeyValue = pathOr(null, [...fieldPath, 'index', 'key'], values);\n  const propertyValue = pathOr(null, [...fieldPath, 'property'], values);\n  const indexValue = pathOr(null, [...fieldPath, 'index', 'value'], values);\n\n  const changeAutocomplete = ({ inputName, value }): void => {\n    setFieldTouched(inputName, true);\n\n    const isKeyInputFieldUpdated = equals(inputName, keyInputName);\n    const isPropertyValueEmpty = not(propertyValue);\n    const hasTwoProperties = equals(length(propertiesOptions), 2);\n\n    if (isKeyInputFieldUpdated && isPropertyValueEmpty && hasTwoProperties) {\n      setFieldValue(\n        propertyInputName,\n        reject(equals(value), propertiesOptions)[0]?.name\n      );\n    }\n    setFieldValue(inputName, value?.name);\n  };\n\n  const getTouchedError = (inputPath): string | undefined => {\n    return path<boolean>(inputPath, touched)\n      ? path<string>(inputPath, errors)\n      : undefined;\n  };\n\n  const keyInputValue = isStringArrayAttribute\n    ? indexKeyValue\n    : find(propEq(indexKeyValue, 'name'), propertiesOptions);\n  const propertyInputValue = find(\n    propEq(propertyValue, 'name'),\n    propertiesOptions\n  );\n\n  return (\n    <div>\n      {isStringArrayAttribute && (\n        <>\n          <Typography align=\"center\">\n            {t(labelWhichResultKeyDoYouWantToUse)}\n          </Typography>\n          <TextField\n            fullWidth\n            required\n            ariaLabel={t(labelIndexUsed)}\n            error={getTouchedError(keyInputFieldPath)}\n            inputProps={{\n              min: 0\n            }}\n            label={t(labelIndexUsed)}\n            name={keyInputName}\n            type=\"number\"\n            value={keyInputValue}\n            onBlur={handleBlur}\n            onChange={handleChange}\n          />\n        </>\n      )}\n      {isObjectArrayAttribute && (\n        <div className={classes.inputsContainer}>\n          <div>\n            <Typography align=\"center\">\n              {t(labelWhichResultPropertyDoYouWantToFilterOn)}\n            </Typography>\n            <div className={classes.inputs}>\n              <SingleAutocompleteField\n                fullWidth\n                required\n                error={getTouchedError(keyInputFieldPath)}\n                label={t(labelPropertyName)}\n                options={propertiesOptions}\n                value={keyInputValue || null}\n                onBlur={(): ((e) => void) => handleBlur(keyInputName)}\n                onChange={(_, value): void =>\n                  changeAutocomplete({ inputName: keyInputName, value })\n                }\n              />\n              <Typography>=</Typography>\n              <TextField\n                fullWidth\n                required\n                ariaLabel={t(labelValueSearched)}\n                error={getTouchedError(valueInputFieldPath)}\n                label={t(labelValueSearched)}\n                name={valueInputName}\n                value={indexValue}\n                onBlur={handleBlur}\n                onChange={handleChange}\n              />\n            </div>\n          </div>\n          <div>\n            <Typography align=\"center\">\n              {t(labelWhichResultPropertyDoYouWantToUse)}\n            </Typography>\n            <div className={classes.inputs}>\n              <SingleAutocompleteField\n                fullWidth\n                required\n                error={getTouchedError([propertyInputFieldPath])}\n                label={t(labelPropertyUsed)}\n                options={propertiesOptions}\n                value={propertyInputValue || null}\n                onBlur={(): ((e) => void) => handleBlur(propertyInputName)}\n                onChange={(_, value): void =>\n                  changeAutocomplete({ inputName: propertyInputName, value })\n                }\n              />\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default AdvancedAttribute;\n","import { memo } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHandlers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\nimport {\n  path,\n  T,\n  addIndex,\n  always,\n  and,\n  cond,\n  equals,\n  find,\n  flatten,\n  isEmpty,\n  isNil,\n  map,\n  not,\n  pathOr,\n  propEq\n} from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Paper } from '@mui/material';\n\nimport { SelectEntry, SingleAutocompleteField } from '@centreon/ui';\n\nimport { labelSource } from '../../../../translatedLabels';\nimport { Attribute, AttributeType, ProviderAttributes } from '../../../models';\n\nimport AdvancedAttribute from './AdvancedAttributeForm';\n\ninterface Props extends Pick<FormikHandlers, 'handleChange' | 'handleBlur'> {\n  error?: string;\n  errors: FormikErrors<FormikValues>;\n  fieldPath: Array<string>;\n  name: string;\n  setFieldTouched: (field: string, value?, shouldValidate?: boolean) => void;\n  setFieldValue: (field: string, value, shouldValidate?: boolean) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  advancedAttribute: {\n    borderBottom: `1px ${theme.palette.background.default} solid`,\n    borderTop: `1px ${theme.palette.background.default} solid`,\n    margin: theme.spacing(0.5),\n    padding: theme.spacing(0.5)\n  }\n}));\n\nconst SourceAutocomplete = ({\n  name,\n  fieldPath,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  error = undefined,\n  sources,\n  handleChange,\n  errors,\n  touched,\n  handleBlur\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const allSources = flatten([\n    sources.attributes,\n    sources.parameters,\n    sources.credentials\n  ]);\n\n  const getAttributeConfiguration = (\n    attributeName: string | undefined\n  ): Attribute | undefined => find(propEq(attributeName, 'name'), allSources);\n\n  const handleAutocompleteChange = (_, value): void => {\n    setFieldTouched(`${name}.index.key`, false, false);\n    setFieldTouched(`${name}.index.value`, false, false);\n    setFieldTouched(`${name}.property`, false, false);\n    setFieldTouched(`${name}.name`);\n    const attributeConfiguration = getAttributeConfiguration(value?.name);\n\n    const sourceProperties = cond([\n      [\n        ({ type, properties }): boolean =>\n          and(equals(type, AttributeType.array), not(isNil(properties))),\n        always({\n          index: {\n            key: '',\n            value: ''\n          },\n          name: value?.name,\n          property: ''\n        })\n      ],\n      [\n        propEq(AttributeType.array, 'type'),\n        always({\n          index: {\n            key: 0\n          },\n          name: value?.name,\n          property: null\n        })\n      ],\n      [\n        T,\n        always({\n          index: null,\n          name: value?.name,\n          property: null\n        })\n      ]\n    ])(attributeConfiguration);\n\n    setFieldValue(name, sourceProperties);\n  };\n\n  const textValueChange = (event): void => {\n    setFieldTouched(`${name}.name`);\n    setFieldValue(name, {\n      index: null,\n      name: event.target.value,\n      property: null\n    });\n  };\n\n  const mapIndexed = addIndex<Attribute, SelectEntry>(map);\n\n  const options = !isEmpty(sources)\n    ? mapIndexed(\n        ({ name: sourceName }, index) => ({ id: index, name: sourceName }),\n        allSources\n      )\n    : [];\n\n  const fieldValue = path([...fieldPath, 'name'], values);\n  const value = (find(propEq(fieldValue, 'name'), options) as SelectEntry) || {\n    name: pathOr('', [...fieldPath, 'name'], values)\n  };\n\n  const attributeConfiguration = getAttributeConfiguration(value.name);\n\n  return (\n    <>\n      <SingleAutocompleteField\n        freeSolo\n        required\n        error={error}\n        label={t(labelSource)}\n        options={options || []}\n        value={value}\n        onChange={handleAutocompleteChange}\n        onTextChange={textValueChange}\n      />\n      {equals(attributeConfiguration?.type, AttributeType.array) && (\n        <Paper className={classes.advancedAttribute}>\n          <AdvancedAttribute\n            attributeConfiguration={attributeConfiguration as Attribute}\n            errors={errors}\n            fieldPath={fieldPath}\n            handleBlur={handleBlur}\n            handleChange={handleChange}\n            name={name}\n            setFieldTouched={setFieldTouched}\n            setFieldValue={setFieldValue}\n            touched={touched}\n            values={values}\n          />\n        </Paper>\n      )}\n    </>\n  );\n};\n\nconst MemoizedConditionSourceAutocomplete = memo(\n  SourceAutocomplete,\n  (prevProps, nextProps) =>\n    equals(prevProps.sources, nextProps.sources) &&\n    equals(\n      path(prevProps.fieldPath, prevProps.values),\n      path(nextProps.fieldPath, nextProps.values)\n    ) &&\n    equals(prevProps.error, nextProps.error) &&\n    equals(prevProps.errors, nextProps.errors) &&\n    equals(prevProps.touched, nextProps.touched)\n);\n\nexport default MemoizedConditionSourceAutocomplete;\n","import { memo } from 'react';\n\nimport { FormikHandlers } from 'formik';\nimport { equals, omit } from 'ramda';\n\nimport { TextField } from '@centreon/ui';\n\ninterface Props extends Pick<FormikHandlers, 'handleChange' | 'handleBlur'> {\n  error?: string;\n  label: string;\n  name: string;\n  value: string;\n}\n\nconst ValueField = ({\n  error,\n  label,\n  value,\n  name,\n  handleChange,\n  handleBlur\n}: Props): JSX.Element => {\n  return (\n    <TextField\n      fullWidth\n      required\n      error={error}\n      helperText={error}\n      inputProps={{\n        'aria-label': label\n      }}\n      label={label}\n      name={name}\n      value={value}\n      onBlur={handleBlur}\n      onChange={handleChange}\n    />\n  );\n};\n\nconst MemoizedValueField = memo(ValueField, (prevProps, nextProps) =>\n  equals(\n    omit(['handleChange', 'handleBlur'], prevProps),\n    omit(['handleChange', 'handleBlur'], nextProps)\n  )\n);\n\nexport default MemoizedValueField;\n","import { memo, useEffect } from 'react';\n\nimport { FormikErrors, FormikTouched, FormikValues } from 'formik';\nimport { path, equals, pathOr } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport AddIcon from '@mui/icons-material/Add';\nimport DeleteIcon from '@mui/icons-material/Delete';\nimport { Button, Grid, IconButton, Paper, Typography } from '@mui/material';\n\nimport {\n  labelAddCondition,\n  labelConditions,\n  labelDeleteCondition,\n  labelValue\n} from '../../../../translatedLabels';\nimport { ProviderAttributes } from '../../../models';\nimport OperatorAutocomplete from '../Operator';\n\nimport SourceAutocomplete from './SourceAutocomplete';\nimport ValueField from './ValueField';\n\nconst useStyles = makeStyles()((theme) => ({\n  button: {\n    fontSize: theme.typography.caption.fontSize\n  },\n  condition: {\n    display: 'flex',\n    padding: theme.spacing(0.5)\n  },\n  conditions: {\n    display: 'flex',\n    padding: theme.spacing(0.5, 0.5, 0)\n  },\n  container: {\n    margin: 0,\n    padding: '30px 100px 0px 100px',\n    width: '100%'\n  },\n  icon: {\n    fontSize: 16\n  },\n  iconButton: {\n    padding: 8\n  },\n  sourceAutocomplete: {\n    marginBottom: theme.spacing(1)\n  },\n  title: {\n    color: theme.palette.grey[600]\n  }\n}));\n\ninterface Props {\n  errors: FormikErrors<FormikValues>;\n  handleBlur: (e) => void;\n  handleChange: (e) => void;\n  setFieldTouched: (field: string, value?, shouldValidate?: boolean) => void;\n  setFieldValue: (field, value) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst conditionsPath = ['parameters', 'conditions'];\n\nconst Conditions = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: Props): JSX.Element => {\n  const conditions = values?.parameters?.conditions || [];\n\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const handleAdd = (): void => {\n    setFieldValue(`parameters.conditions[${conditions.length}]`, {\n      operator: 'equal',\n      source: {\n        index: null,\n        name: '',\n        property: null\n      },\n      value: ''\n    });\n  };\n\n  const handleDelete = (index): void => {\n    // slice conditions to remove condition between these\n    const firstConditions = conditions.slice(0, index);\n    const lastConditions = conditions.slice(index + 1);\n\n    setFieldValue('parameters.conditions', [\n      ...firstConditions,\n      ...lastConditions\n    ]);\n  };\n\n  const getTouchedError = ({ index, field }): string | undefined =>\n    path(['parameters', 'conditions', index, field], touched)\n      ? path(['parameters', 'conditions', index, field], errors)\n      : undefined;\n\n  useEffect(() => {\n    setFieldTouched('parameters.conditions', true, true);\n  }, [values?.parameters?.conditions?.length]);\n\n  return (\n    <>\n      <Typography className={classes.title} display=\"block\" variant=\"caption\">\n        {t(labelConditions)}\n      </Typography>\n      <Paper className={classes.conditions}>\n        <Grid\n          container\n          item\n          aria-label=\"conditions\"\n          direction=\"column\"\n          spacing={1}\n        >\n          {conditions.map((_, index) => (\n            // biome-ignore lint/suspicious/noArrayIndexKey:\n            <Grid item key={`condition${index}`}>\n              <Paper className={classes.condition}>\n                <Grid item style={{ flex: 1 }}>\n                  <div className={classes.sourceAutocomplete}>\n                    <SourceAutocomplete\n                      error={getTouchedError({\n                        field: ['source', 'name'],\n                        index\n                      })}\n                      errors={errors}\n                      fieldPath={['parameters', 'conditions', index, 'source']}\n                      handleBlur={handleBlur}\n                      handleChange={handleChange}\n                      name={`parameters.conditions[${index}].source`}\n                      setFieldTouched={setFieldTouched}\n                      setFieldValue={setFieldValue}\n                      sources={sources}\n                      touched={touched}\n                      values={values}\n                    />\n                  </div>\n                  <Grid container spacing={1}>\n                    <Grid item style={{ flex: 1 }}>\n                      <OperatorAutocomplete\n                        fieldPath={[\n                          'parameters',\n                          'conditions',\n                          index,\n                          'operator'\n                        ]}\n                        name={`parameters.conditions[${index}].operator`}\n                        setFieldTouched={setFieldTouched}\n                        setFieldValue={setFieldValue}\n                        values={values}\n                      />\n                    </Grid>\n                    <Grid item style={{ flex: 1 }}>\n                      <ValueField\n                        error={getTouchedError({ field: 'value', index })}\n                        handleBlur={handleBlur}\n                        handleChange={handleChange}\n                        label={t(labelValue)}\n                        name={`parameters.conditions[${index}].value`}\n                        value={pathOr(\n                          '',\n                          ['parameters', 'conditions', index, 'value'],\n                          values\n                        )}\n                      />\n                    </Grid>\n                  </Grid>\n                </Grid>\n                <Grid item style={{ alignItems: 'center', display: 'flex' }}>\n                  <IconButton\n                    aria-label={t(labelDeleteCondition)}\n                    className={classes.iconButton}\n                    size=\"large\"\n                    onClick={(): void => handleDelete(index)}\n                  >\n                    <DeleteIcon className={classes.icon} />\n                  </IconButton>\n                </Grid>\n              </Paper>\n            </Grid>\n          ))}\n          <Grid item>\n            <Button\n              fullWidth\n              aria-label={t(labelAddCondition)}\n              className={classes.button}\n              color=\"primary\"\n              size=\"small\"\n              onClick={handleAdd}\n            >\n              <AddIcon className={classes.icon} />\n              {t(labelAddCondition)}\n            </Button>\n          </Grid>\n        </Grid>\n      </Paper>\n    </>\n  );\n};\n\nconst MemoizedConditions = memo(\n  Conditions,\n  (prevProps, nextProps) =>\n    equals(\n      path(conditionsPath, prevProps.values),\n      path(conditionsPath, nextProps.values)\n    ) &&\n    equals(\n      path(conditionsPath, prevProps.errors),\n      path(conditionsPath, nextProps.errors)\n    ) &&\n    equals(\n      path(conditionsPath, prevProps.touched),\n      path(conditionsPath, nextProps.touched)\n    ) &&\n    equals(prevProps.sources, nextProps.sources)\n);\n\nexport default MemoizedConditions;\n","import { equals, includes, keysIn, type } from 'ramda';\nimport { Schema, mixed, object, string } from 'yup';\n\nimport { labelRequired } from '../../../../translatedLabels';\nimport { ParameterCondition, Translation } from '../../../models';\n\nconst conditionValidationSchema = (\n  t: Translation\n): Schema<ParameterCondition> =>\n  object().shape({\n    operator: string().nullable().required(t(labelRequired)),\n    source: object().shape({\n      index: object()\n        .shape({\n          key: mixed().nullable().required(t(labelRequired)),\n          value: string()\n            .nullable()\n            .when('key', ([key], schema) => {\n              return equals(type(key), 'Number')\n                ? schema.notRequired()\n                : schema.required(t(labelRequired));\n            })\n        })\n        .nullable(),\n      name: string().defined().required(t(labelRequired)),\n      property: string()\n        .nullable()\n        .when('index', ([index], schema) => {\n          return includes('value', keysIn(index))\n            ? schema.required(t(labelRequired))\n            : schema;\n        })\n    }),\n    value: string().nullable().required(t(labelRequired))\n  });\n\nexport default conditionValidationSchema;\n","import { memo } from 'react';\n\nimport { addIndex, equals, find, map, propEq } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { SelectEntry, SingleAutocompleteField } from '@centreon/ui';\n\nimport { labelDestination } from '../../../../translatedLabels';\n\nimport destinations from './destinations';\n\ninterface Props {\n  error?: string;\n  name: string;\n  setFieldTouched: (field: string) => void;\n  setFieldValue: (field: string, value, shouldValidate?: boolean) => void;\n  touched?: boolean;\n  values: string;\n}\n\nconst DestinationAutocomplete = ({\n  name,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  error,\n  touched\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n\n  const handleAutocompleteChange = (_, value): void => {\n    setFieldTouched(name);\n    setFieldValue(name, value?.name);\n  };\n\n  const textValueChange = (event): void => {\n    setFieldTouched(name);\n    setFieldValue(name, event.target.value);\n  };\n\n  const mapIndexed = addIndex<string, SelectEntry>(map);\n\n  const options = mapIndexed(\n    (destination, index) => ({\n      id: index,\n      name: destination\n    }),\n    destinations\n  );\n\n  const value = (find(propEq(values, 'name'), options) as SelectEntry) || {\n    name: values || ''\n  };\n\n  return (\n    <SingleAutocompleteField\n      freeSolo\n      required\n      disableClearable={false}\n      error={touched ? error : undefined}\n      label={t(labelDestination)}\n      options={options}\n      value={value}\n      onChange={handleAutocompleteChange}\n      onTextChange={textValueChange}\n    />\n  );\n};\n\nconst MemoizedDestinationAutocomplete = memo(\n  DestinationAutocomplete,\n  (prevProps, nextProps) =>\n    equals(prevProps.values, nextProps.values) &&\n    equals(prevProps.touched, nextProps.touched) &&\n    equals(prevProps.error, nextProps.error)\n);\n\nexport default MemoizedDestinationAutocomplete;\n","import { ChangeEvent, memo } from 'react';\n\nimport { FormikHelpers, FormikValues } from 'formik';\nimport { path, equals, isEmpty, pick } from 'ramda';\n\nimport { TextField } from '@centreon/ui';\n\ninterface Props\n  extends Pick<\n    FormikHelpers<FormikValues>,\n    'setFieldTouched' | 'setFieldValue'\n  > {\n  error?: string;\n  label: string;\n  value: string;\n}\n\nconst DestinationField = ({\n  setFieldTouched,\n  setFieldValue,\n  label,\n  error,\n  value\n}: Props): JSX.Element => {\n  const changeDestinationInput = (e: ChangeEvent<HTMLInputElement>): void => {\n    const prefix = 'host.macros.';\n    const inputValue = path(['target', 'value'], e);\n\n    setFieldTouched('parameters.destination');\n\n    if (isEmpty(inputValue)) {\n      setFieldValue('parameters.destination', null);\n\n      return;\n    }\n    setFieldValue('parameters.destination', `${prefix}${inputValue}`);\n  };\n\n  return (\n    <TextField\n      fullWidth\n      required\n      error={error}\n      helperText={error}\n      inputProps={{\n        'aria-label': label\n      }}\n      label={label}\n      value={value}\n      onChange={changeDestinationInput}\n    />\n  );\n};\n\nconst MemoizedDestinationField = memo(\n  DestinationField,\n  (prevProps, nextProps) =>\n    equals(\n      pick(['value', 'error'], prevProps),\n      pick(['value', 'error'], nextProps)\n    )\n);\n\nexport default MemoizedDestinationField;\n","const destinations = ['host.alias', 'host.ip', 'host.name'];\n\nexport default destinations;\n","import { FormikErrors, FormikTouched, FormikValues } from 'formik';\nimport { makeStyles } from 'tss-react/mui';\n\nimport {\n  labelCreateHostCategory,\n  labelHostCategory,\n  labelHostCategorySelector,\n  labelSelectHostCategory\n} from '../../../../translatedLabels';\nimport { listHostCategoriesEndpoint } from '../../../api/endpoint';\nimport { ProviderAttributes, SourceType } from '../../../models';\nimport Conditions from '../Conditions';\nimport HostForm from '../HostForm';\n\ninterface Props {\n  errors: FormikErrors<FormikValues>;\n  handleBlur: (e) => void;\n  handleChange: (e) => void;\n  setFieldTouched: (field: string, value?: boolean) => void;\n  setFieldValue: (field: string, value) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  hostGroupForm: {\n    display: 'grid',\n    grid: 'auto-flow min-content / 1fr',\n    rowGap: theme.spacing(1)\n  }\n}));\n\nconst fieldName = 'parameters.source';\nconst fieldPath = ['parameters', 'source'];\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  return (\n    <div className={classes.hostGroupForm}>\n      <Conditions\n        errors={errors}\n        handleBlur={handleBlur}\n        handleChange={handleChange}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n      <HostForm\n        supportAdvancedAtribute\n        additionalEndpointParameters={{\n          field: 'is_activated',\n          values: {\n            $eq: '1'\n          }\n        }}\n        baseEndpoint={listHostCategoriesEndpoint}\n        errors={errors}\n        fieldName={fieldName}\n        fieldPath={fieldPath}\n        labelField={labelHostCategory}\n        labelFirstOption={labelSelectHostCategory}\n        labelSecondOption={labelCreateHostCategory}\n        labelSelector={labelHostCategorySelector}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sourceType={SourceType.hostCategory}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n    </div>\n  );\n};\n\nexport default Form;\n","const initialValues = {\n  parameters: {\n    conditions: [],\n    source: []\n  },\n  type: 'host_category'\n};\n\nexport default initialValues;\n","import { Dispatch, SetStateAction, memo } from 'react';\n\nimport { equals } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport {\n  FormControl,\n  FormControlLabel,\n  FormHelperText,\n  Radio,\n  RadioGroup\n} from '@mui/material';\n\nimport { HostSelectorTypeProps, SelectorType } from '.';\n\ninterface Props extends HostSelectorTypeProps {\n  selectorTypeValue: SelectorType;\n  setSelectorType: Dispatch<SetStateAction<SelectorType>>;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  radioButton: {\n    padding: theme.spacing(0.5)\n  },\n  radioButtonLabel: {\n    marginLeft: theme.spacing(0.5)\n  }\n}));\n\nconst HostSelectorType = ({\n  labelSelector,\n  labelFirstOption,\n  labelSecondOption,\n  setSelectorType,\n  setFieldTouched,\n  setFieldValue,\n  fieldName,\n  selectorTypeValue\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const handleSelectorTypeChange = (_, value): void => {\n    setSelectorType(value);\n    setFieldTouched(fieldName, false);\n    setFieldValue(fieldName, []);\n  };\n\n  return (\n    <FormControl component=\"fieldset\">\n      <FormHelperText>{t(labelSelector)}</FormHelperText>\n      <RadioGroup\n        aria-label={t(labelSelector)}\n        name=\"hostSelector\"\n        value={selectorTypeValue}\n        onChange={handleSelectorTypeChange}\n      >\n        <FormControlLabel\n          classes={{\n            root: classes.radioButtonLabel\n          }}\n          control={\n            <Radio\n              className={classes.radioButton}\n              color=\"primary\"\n              inputProps={{ 'aria-label': t(labelFirstOption) }}\n              size=\"small\"\n            />\n          }\n          label={t(labelFirstOption) as string}\n          value={SelectorType.select}\n        />\n        <FormControlLabel\n          classes={{\n            root: classes.radioButtonLabel\n          }}\n          control={\n            <Radio\n              className={classes.radioButton}\n              color=\"primary\"\n              inputProps={{ 'aria-label': t(labelSecondOption) }}\n              size=\"small\"\n            />\n          }\n          label={t(labelSecondOption) as string}\n          value={SelectorType.create}\n        />\n      </RadioGroup>\n    </FormControl>\n  );\n};\n\nconst MemoizedHostSelectorType = memo(\n  HostSelectorType,\n  (prevProps, nextProps) =>\n    equals(prevProps.selectorTypeValue, nextProps.selectorTypeValue)\n);\n\nexport default MemoizedHostSelectorType;\n","import { useState } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHelpers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\nimport {\n  always,\n  equals,\n  head,\n  ifElse,\n  isNil,\n  pathOr,\n  pipe,\n  propOr\n} from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport {\n  SingleConnectedAutocompleteField,\n  buildListingEndpoint\n} from '@centreon/ui';\n\nimport { ProviderAttributes, Source, SourceType } from '../../../models';\nimport SourceAutocomplete from '../Source';\n\nimport HostSelectorType from './HostSelectorType';\n\nexport enum SelectorType {\n  create = 'create',\n  select = 'select'\n}\n\nexport interface HostSelectorTypeProps\n  extends Pick<\n    FormikHelpers<FormikValues>,\n    'setFieldValue' | 'setFieldTouched'\n  > {\n  fieldName: string;\n  labelFirstOption: string;\n  labelSecondOption: string;\n  labelSelector: string;\n}\n\ninterface Props extends HostSelectorTypeProps {\n  additionalEndpointParameters?: Record<string, unknown>;\n  baseEndpoint: string;\n  errors: FormikErrors<FormikValues>;\n  fieldPath: Array<string>;\n  labelField: string;\n  sourceType: SourceType;\n  sources: ProviderAttributes;\n  supportAdvancedAtribute?: boolean;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst HostForm = ({\n  baseEndpoint,\n  labelSelector,\n  labelFirstOption,\n  labelSecondOption,\n  labelField,\n  sourceType,\n  fieldPath,\n  fieldName,\n  sources,\n  values,\n  errors,\n  touched,\n  setFieldTouched,\n  setFieldValue,\n  additionalEndpointParameters = undefined,\n  supportAdvancedAtribute = false\n}: Props): JSX.Element => {\n  const getInitialSelectorType = (): SelectorType =>\n    ifElse(\n      pipe(head, propOr(sourceType, 'type'), equals(sourceType)),\n      always(SelectorType.select),\n      always(SelectorType.create)\n    )(pathOr([], fieldPath, values));\n\n  const { t } = useTranslation();\n  const [selectorType, setSelectorType] = useState<SelectorType>(\n    getInitialSelectorType()\n  );\n\n  const getEndpoint = (params): string => {\n    return buildListingEndpoint({\n      baseEndpoint,\n      parameters: {\n        page: params.page,\n        search: {\n          conditions: [\n            additionalEndpointParameters,\n            ...(params.search?.conditions || [])\n          ].filter(Boolean)\n        },\n        sort: { name: 'ASC' }\n      }\n    });\n  };\n\n  const changeHostMapper = (_, value): void => {\n    setFieldValue(\n      fieldName,\n      isNil(value)\n        ? []\n        : [\n            {\n              type: sourceType,\n              value\n            }\n          ]\n    );\n  };\n\n  const isOptionEqualToValue = (option, value): boolean =>\n    equals(option.name, value.name);\n\n  const blur = (): void => setFieldTouched(fieldName, true);\n\n  const sourceValue = pathOr<Array<Source>>([], fieldPath, values);\n  const error = pathOr<FormikErrors<FormikValues> | null>(\n    null,\n    fieldPath,\n    errors\n  );\n  const isTouched = pathOr<boolean>(false, fieldPath, touched);\n\n  return (\n    <>\n      <HostSelectorType\n        fieldName={fieldName}\n        labelFirstOption={labelFirstOption}\n        labelSecondOption={labelSecondOption}\n        labelSelector={labelSelector}\n        selectorTypeValue={selectorType}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        setSelectorType={setSelectorType}\n      />\n      {equals(selectorType, SelectorType.create) && (\n        <SourceAutocomplete\n          error={isTouched ? error : undefined}\n          labelField={labelField}\n          name={fieldName}\n          sources={sources}\n          supportAdvancedAtribute={supportAdvancedAtribute}\n          values={sourceValue}\n        />\n      )}\n      {equals(selectorType, SelectorType.select) && (\n        <SingleConnectedAutocompleteField\n          required\n          disableClearable={false}\n          error={isTouched ? error : undefined}\n          field=\"name\"\n          getEndpoint={getEndpoint}\n          getOptionLabel={(option): string => option?.name || ''}\n          initialPage={1}\n          isOptionEqualToValue={isOptionEqualToValue}\n          label={t(labelField)}\n          name={fieldName}\n          value={pipe(\n            pathOr([], fieldPath),\n            head,\n            propOr(null, 'value')\n          )(values)}\n          onBlur={blur}\n          onChange={changeHostMapper}\n        />\n      )}\n    </>\n  );\n};\n\nexport default HostForm;\n","import { FormikErrors, FormikTouched, FormikValues } from 'formik';\nimport { makeStyles } from 'tss-react/mui';\n\nimport {\n  labelCreateHostGroup,\n  labelHostGroup,\n  labelHostGroupSelector,\n  labelSelectHostGroup\n} from '../../../../translatedLabels';\nimport { listHostGroupsEndpoint } from '../../../api/endpoint';\nimport { ProviderAttributes, SourceType } from '../../../models';\nimport Conditions from '../Conditions';\nimport HostGroupForm from '../HostForm';\n\ninterface Props {\n  errors: FormikErrors<FormikValues>;\n  handleBlur: (e) => void;\n  handleChange: (e) => void;\n  setFieldTouched: (field: string, value?: boolean) => void;\n  setFieldValue: (field: string, value) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  hostGroupForm: {\n    display: 'grid',\n    grid: 'auto-flow min-content / 1fr',\n    rowGap: theme.spacing(1)\n  }\n}));\n\nconst fieldName = 'parameters.source';\nconst fieldPath = ['parameters', 'source'];\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  return (\n    <div className={classes.hostGroupForm}>\n      <Conditions\n        errors={errors}\n        handleBlur={handleBlur}\n        handleChange={handleChange}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n      <HostGroupForm\n        supportAdvancedAtribute\n        baseEndpoint={listHostGroupsEndpoint}\n        errors={errors}\n        fieldName={fieldName}\n        fieldPath={fieldPath}\n        labelField={labelHostGroup}\n        labelFirstOption={labelSelectHostGroup}\n        labelSecondOption={labelCreateHostGroup}\n        labelSelector={labelHostGroupSelector}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sourceType={SourceType.hostGroup}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n    </div>\n  );\n};\n\nexport default Form;\n","import { pathOr } from 'ramda';\n\nimport { Mapper, ParameterCondition, Source } from '../../../models';\nimport MapperPreview from '../Preview';\nimport getSourcePreview from '../Source/preview';\n\ninterface Props {\n  mapper: Mapper;\n}\n\nconst Preview = ({ mapper }: Props): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr<Array<ParameterCondition>>(\n      [],\n      ['parameters', 'conditions'],\n      mapper\n    )}\n    source={getSourcePreview(\n      pathOr<Array<Source>>([], ['parameters', 'source'], mapper)\n    )}\n  />\n);\n\nexport default Preview;\n","const initialValues = {\n  parameters: {\n    conditions: [],\n    source: []\n  },\n  type: 'host_group'\n};\n\nexport default initialValues;\n","import { array, object } from 'yup';\nimport { SourceMapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\nimport sourceValidationSchema from '../Source/validationSchema';\n\nconst validationSchema = (t: Translation): SourceMapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    source: sourceValidationSchema(t)\n  })\n});\n\nexport default validationSchema;\n","import { memo } from 'react';\n\nimport { FormikErrors, FormikTouched, FormikValues } from 'formik';\nimport { path, equals, head, isNil, pathOr, pipe, propOr } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport {\n  SingleConnectedAutocompleteField,\n  buildListingEndpoint\n} from '@centreon/ui';\n\nimport { labelHostSeverity } from '../../../../translatedLabels';\nimport { listHostSeveritiesEndpoint } from '../../../api/endpoint';\nimport memoPropsFormComponent from '../../../memoForm';\nimport { ProviderAttributes, SourceType } from '../../../models';\nimport Conditions from '../Conditions';\n\ninterface Props {\n  errors: FormikErrors<FormikValues>;\n  handleBlur: (e) => void;\n  handleChange: (e) => void;\n  setFieldTouched: (field: string, value?: boolean) => void;\n  setFieldValue: (field: string, value) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  hostSeverityForm: {\n    display: 'grid',\n    grid: 'auto-flow min-content / 1fr',\n    rowGap: theme.spacing(1)\n  }\n}));\n\nconst fieldName = 'parameters.source';\nconst fieldPath = ['parameters', 'source'];\n\nconst HostSeverityField = ({\n  errors,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  touched\n}: Omit<Props, 'handleBlur' | 'handleChange' | 'sources'>): JSX.Element => {\n  const { t } = useTranslation();\n\n  const changeHostSeverity = (_, value): void => {\n    setFieldValue(\n      fieldName,\n      isNil(value)\n        ? []\n        : [\n            {\n              type: SourceType.hostSeverity,\n              value\n            }\n          ]\n    );\n  };\n\n  const getEndpoint = (params): string => {\n    return buildListingEndpoint({\n      baseEndpoint: listHostSeveritiesEndpoint,\n      parameters: params\n    });\n  };\n\n  const isOptionEqualToValue = (option, value): boolean =>\n    equals(option.name, value.name);\n\n  const error = path(fieldPath, errors);\n  const isTouched = path(fieldPath, touched);\n\n  const blur = (): void => setFieldTouched(fieldName);\n\n  return (\n    <SingleConnectedAutocompleteField\n      required\n      disableClearable={false}\n      error={isTouched ? error : undefined}\n      field=\"name\"\n      getEndpoint={getEndpoint}\n      initialPage={1}\n      isOptionEqualToValue={isOptionEqualToValue}\n      label={t(labelHostSeverity)}\n      name={fieldName}\n      value={pipe(pathOr([], fieldPath), head, propOr(null, 'value'))(values)}\n      onBlur={blur}\n      onChange={changeHostSeverity}\n    />\n  );\n};\n\nconst MemoizedHostSeverityField = memo(\n  HostSeverityField,\n  (prevProps, nextProps): boolean =>\n    memoPropsFormComponent({ fieldPath, nextProps, prevProps })\n);\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  return (\n    <div className={classes.hostSeverityForm}>\n      <Conditions\n        errors={errors}\n        handleBlur={handleBlur}\n        handleChange={handleChange}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n      <MemoizedHostSeverityField\n        errors={errors}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        touched={touched}\n        values={values}\n      />\n    </div>\n  );\n};\n\nexport default Form;\n","import { pathOr } from 'ramda';\n\nimport { Mapper, ParameterCondition, Source } from '../../../models';\nimport MapperPreview from '../Preview';\nimport getSourcePreview from '../Source/preview';\n\ninterface Props {\n  mapper: Mapper;\n}\n\nconst Preview = ({ mapper }: Props): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr<Array<ParameterCondition>>(\n      [],\n      ['parameters', 'conditions'],\n      mapper\n    )}\n    source={getSourcePreview(\n      pathOr<Array<Source>>([], ['parameters', 'source'], mapper)\n    )}\n  />\n);\n\nexport default Preview;\n","const initialValues = {\n  parameters: {\n    conditions: [],\n    source: []\n  },\n  type: 'host_severity'\n};\n\nexport default initialValues;\n","import { array, object } from 'yup';\nimport { SourceMapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\nimport sourceValidationSchema from '../Source/validationSchema';\n\nconst validationSchema = (t: Translation): SourceMapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    source: sourceValidationSchema(t)\n  })\n});\n\nexport default validationSchema;\n","import { memo, useState } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHelpers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\nimport { path, equals, pathOr } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport {\n  SelectEntry,\n  SingleConnectedAutocompleteField,\n  buildListingEndpoint\n} from '@centreon/ui';\n\nimport { labelHostTemplate } from '../../../../translatedLabels';\nimport { listHostTemplatesEndpoint } from '../../../api/endpoint';\n\ninterface Props\n  extends Pick<\n    FormikHelpers<FormikValues>,\n    'setFieldTouched' | 'setFieldValue'\n  > {\n  errors: FormikErrors<FormikValues>;\n  fieldPath: Array<string>;\n  name: string;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst HostTemplate = ({\n  name,\n  fieldPath,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  errors,\n  touched\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const [hostTemplate, setHostTemplate] = useState<SelectEntry | null>(\n    path(fieldPath, values)\n      ? {\n          id: 0,\n          name: pathOr('', fieldPath, values)\n        }\n      : null\n  );\n\n  const getEndpoint = (params): string => {\n    return buildListingEndpoint({\n      baseEndpoint: listHostTemplatesEndpoint,\n      parameters: params\n    });\n  };\n\n  const changeHostTemplate = (_, value): void => {\n    setFieldTouched(name);\n    setFieldValue(name, value?.name);\n    setHostTemplate(value);\n  };\n\n  const isOptionEqualToValue = (option, value): boolean =>\n    equals(option.name, value.name);\n\n  const getTouchedError = (): string | null => {\n    if (path(fieldPath, touched)) {\n      return path(fieldPath, errors) || null;\n    }\n\n    return null;\n  };\n\n  return (\n    <SingleConnectedAutocompleteField\n      required\n      error={getTouchedError()}\n      field=\"name\"\n      getEndpoint={getEndpoint}\n      getOptionLabel={(option): string => option?.name || ''}\n      initialPage={1}\n      isOptionEqualToValue={isOptionEqualToValue}\n      label={t(labelHostTemplate)}\n      name={name}\n      value={hostTemplate}\n      onChange={changeHostTemplate}\n    />\n  );\n};\n\nconst MemoizedHostTemplate = memo(\n  HostTemplate,\n  (prevProps, nextProps) =>\n    equals(\n      path(prevProps.fieldPath, prevProps.values),\n      path(nextProps.fieldPath, nextProps.values)\n    ) &&\n    equals(\n      path(prevProps.fieldPath, prevProps.touched),\n      path(nextProps.fieldPath, nextProps.touched)\n    ) &&\n    equals(\n      path(prevProps.fieldPath, prevProps.errors),\n      path(nextProps.fieldPath, nextProps.errors)\n    )\n);\n\nexport default MemoizedHostTemplate;\n","import { FormikErrors, FormikTouched, FormikValues } from 'formik';\nimport { path, equals, pipe, type } from 'ramda';\n\nimport { FormHelperText } from '@mui/material';\n\nimport { ProviderAttributes } from '../../../models';\nimport Conditions from '../Conditions';\n\ninterface Props {\n  errors: FormikErrors<FormikValues>;\n  handleBlur: (e) => void;\n  handleChange: (e) => void;\n  setFieldTouched: (field, values, shouldValidate) => void;\n  setFieldValue: (field, value) => void;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: Props): JSX.Element => {\n  const conditionsPath = ['parameters', 'conditions'];\n  const conditionsError = path<string>(conditionsPath, errors);\n\n  return (\n    <>\n      <Conditions\n        errors={errors}\n        handleBlur={handleBlur}\n        handleChange={handleChange}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n      {pipe(type, equals('String'))(conditionsError) && (\n        <FormHelperText error>{conditionsError}</FormHelperText>\n      )}\n    </>\n  );\n};\n\nexport default Form;\n","import { pathOr } from 'ramda';\n\nimport { Mapper, ParameterCondition } from '../../../models';\nimport MapperPreview from '../Preview';\n\ninterface Props {\n  mapper: Mapper;\n}\n\nconst Preview = ({ mapper }: Props): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr<Array<ParameterCondition>>(\n      [],\n      ['parameters', 'conditions'],\n      mapper\n    )}\n  />\n);\n\nexport default Preview;\n","import operators from '../Operator/operators';\n\nconst defaultCondition = {\n  operator: operators[0],\n  source: {\n    index: null,\n    name: '',\n    property: null\n  },\n  value: ''\n};\n\nconst inclusionInitialValues = {\n  parameters: {\n    conditions: [defaultCondition]\n  },\n  type: 'inclusion'\n};\n\nconst exclusionInitialValues = {\n  parameters: {\n    conditions: [defaultCondition]\n  },\n  type: 'exclusion'\n};\n\nexport default {\n  exclusion: exclusionInitialValues,\n  inclusion: inclusionInitialValues\n};\n","import { array, object } from 'yup';\nimport {\n  labelAtLeastOneConditionRequired,\n  labelRequired\n} from '../../../../translatedLabels';\nimport {\n  InclusionExclusionValidationSchema,\n  Translation\n} from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\n\nconst validationSchema = (\n  t: Translation\n): InclusionExclusionValidationSchema => ({\n  parameters: object().shape({\n    conditions: array()\n      .of(conditionValidationSchema(t))\n      .required(t(labelRequired))\n      .min(1, t(labelAtLeastOneConditionRequired))\n  })\n});\n\nexport default validationSchema;\n","import { FormikErrors, FormikValues } from 'formik';\nimport { path } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Checkbox, FormControlLabel, Grid } from '@mui/material';\n\nimport { labelDestination, labelPassword } from '../../../../translatedLabels';\nimport { GetSource, MapperFormProps, Source } from '../../../models';\nimport Conditions from '../Conditions';\nimport DestinationField from '../Destination/DestinationField';\nimport SourceAutocomplete from '../Source';\n\nconst useStyles = makeStyles()((theme) => ({\n  checkbox: {\n    padding: theme.spacing(0.5, 1)\n  }\n}));\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  touched,\n  values,\n  sources\n}: MapperFormProps): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const getTouchedError = (): string | undefined =>\n    path(['parameters', 'destination'], touched)\n      ? path(['parameters', 'destination'], errors)\n      : undefined;\n\n  const getSource = (object): GetSource =>\n    path(['parameters', 'source'], object);\n\n  return (\n    <Grid container direction=\"column\" spacing={1}>\n      <Grid item>\n        <Conditions\n          errors={errors}\n          handleBlur={handleBlur}\n          handleChange={handleChange}\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          sources={sources}\n          touched={touched}\n          values={values}\n        />\n      </Grid>\n      <Grid item>\n        <SourceAutocomplete\n          supportAdvancedAtribute\n          error={getSource(errors) as FormikErrors<FormikValues> | null}\n          name=\"parameters.source\"\n          sources={sources}\n          values={getSource(values) as Array<Source>}\n        />\n      </Grid>\n      <Grid item>\n        <DestinationField\n          error={getTouchedError()}\n          label={t(labelDestination)}\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          value={\n            values.parameters?.destination?.replace(/^host.macros./, '') || ''\n          }\n        />\n      </Grid>\n      <Grid item>\n        <FormControlLabel\n          control={\n            <Checkbox\n              checked={values.parameters?.is_password || false}\n              className={classes.checkbox}\n              color=\"primary\"\n              name=\"is_password\"\n              size=\"small\"\n              onChange={handleChange('parameters.is_password')}\n            />\n          }\n          label={t(labelPassword) as string}\n        />\n      </Grid>\n    </Grid>\n  );\n};\n\nexport default Form;\n","import { path, pathOr } from 'ramda';\n\nimport { PreviewMapperProps } from '../../../models';\nimport MapperPreview from '../Preview';\nimport getSourcePreview from '../Source/preview';\n\nconst Preview = ({ mapper }: PreviewMapperProps): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr([], ['parameters', 'conditions'], mapper)}\n    destination={path(['parameters', 'destination'], mapper)}\n    source={getSourcePreview(pathOr([], ['parameters', 'source'], mapper))}\n  />\n);\n\nexport default Preview;\n","export default {\n  parameters: {\n    conditions: [],\n    is_password: false\n  },\n  type: 'macro'\n};\n","import { array, boolean, object, string } from 'yup';\nimport { labelRequired } from '../../../../translatedLabels';\nimport { MapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\nimport sourceValidationSchema from '../Source/validationSchema';\n\nconst validationSchema = (t: Translation): MapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    destination: string().nullable().required(t(labelRequired)),\n    is_password: boolean().required(t(labelRequired)),\n    source: sourceValidationSchema(t)\n  })\n});\n\nexport default validationSchema;\n","import { pathOr, split } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { Grid } from '@mui/material';\n\nimport {\n  labelFromJob,\n  labelInstanceSelector,\n  labelManual\n} from '../../../../translatedLabels';\nimport { MapperFormProps } from '../../../models';\nimport Conditions from '../Conditions';\nimport MonitoringInstanceAutocomplete from '../MonitoringInstance';\n\nimport Selector from './Selector';\n\nconst radioName = 'parameters.type';\nconst radioPath = split('.', radioName);\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  touched,\n  values,\n  sources\n}: MapperFormProps): JSX.Element => {\n  const { t } = useTranslation();\n\n  const type = pathOr(null, radioPath, values);\n\n  const handleRadioChange = (event): void => {\n    setFieldValue('parameters', {\n      ...values.parameters,\n      type: event.target.value,\n      value: ''\n    });\n  };\n\n  return (\n    <Grid container direction=\"column\" spacing={1}>\n      <Grid item>\n        <Conditions\n          errors={errors}\n          handleBlur={handleBlur}\n          handleChange={handleChange}\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          sources={sources}\n          touched={touched}\n          values={values}\n        />\n      </Grid>\n      <Selector\n        handleRadioChange={handleRadioChange}\n        label={t(labelInstanceSelector)}\n        labelFirstRadio={t(labelFromJob)}\n        labelSecondRadio={t(labelManual)}\n        radioName={radioName}\n        value={type}\n      />\n      <Grid item>\n        {type === 'manual' && (\n          <MonitoringInstanceAutocomplete\n            errors={errors}\n            fieldPath={['parameters', 'value']}\n            name=\"parameters.value\"\n            setFieldTouched={setFieldTouched}\n            setFieldValue={setFieldValue}\n            touched={touched}\n            values={values}\n          />\n        )}\n      </Grid>\n    </Grid>\n  );\n};\n\nexport default Form;\n","import { path, pathOr } from 'ramda';\n\nimport { PreviewMapperProps } from '../../../models';\nimport MapperPreview from '../Preview';\n\nconst Preview = ({ mapper }: PreviewMapperProps): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr([], ['parameters', 'conditions'], mapper)}\n    value={path(['parameters', 'value'], mapper)}\n  />\n);\n\nexport default Preview;\n","import { memo } from 'react';\n\nimport { equals } from 'ramda';\n\nimport {\n  FormControl,\n  FormControlLabel,\n  FormHelperText,\n  Grid,\n  Radio,\n  RadioGroup\n} from '@mui/material';\n\ninterface Props {\n  handleRadioChange: (e) => void;\n  label: string;\n  labelFirstRadio: string;\n  labelSecondRadio: string;\n  radioName: string;\n  value: string | null;\n}\n\nconst Selector = ({\n  label,\n  value,\n  radioName,\n  labelFirstRadio,\n  labelSecondRadio,\n  handleRadioChange\n}: Props): JSX.Element => {\n  return (\n    <Grid item>\n      <FormControl component=\"fieldset\">\n        <FormHelperText>{label}</FormHelperText>\n        <RadioGroup\n          row\n          aria-label=\"type\"\n          name={radioName}\n          value={value}\n          onChange={handleRadioChange}\n        >\n          <FormControlLabel\n            control={<Radio color=\"primary\" size=\"small\" />}\n            label={labelFirstRadio}\n            value=\"from_job\"\n          />\n          <FormControlLabel\n            control={<Radio color=\"primary\" size=\"small\" />}\n            label={labelSecondRadio}\n            value=\"manual\"\n          />\n        </RadioGroup>\n      </FormControl>\n    </Grid>\n  );\n};\n\nconst MemoizedSelector = memo(Selector, (prevProps, nextProps) =>\n  equals(prevProps.value, nextProps.value)\n);\n\nexport default MemoizedSelector;\n","import { equals } from 'ramda';\nimport { array, object, string } from 'yup';\n\nimport { labelRequired } from '../../../../translatedLabels';\nimport { MapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\n\nconst validationSchema = (t: Translation): MapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    type: string()\n      .matches(/(from_job|manual)/, t(labelRequired))\n      .required(t(labelRequired)),\n    value: string().when('type', ([type]) => {\n      if (equals(type, 'from_job')) {\n        return string().nullable();\n      }\n\n      return string().nullable().required(t(labelRequired));\n    })\n  })\n});\n\nexport default validationSchema;\n","import { memo, useEffect, useState } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHelpers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\nimport { path, equals } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport {\n  SingleConnectedAutocompleteField,\n  buildListingEndpoint,\n  useRequest\n} from '@centreon/ui';\n\nimport {\n  labelMonitoringServer,\n  labelSomethingWentWrong\n} from '../../../../translatedLabels';\nimport { listMonitoringServers } from '../../../api';\nimport { listMonitoringServersDecoder } from '../../../api/decoders';\nimport { listMonitoringServersEndpoint } from '../../../api/endpoint';\nimport { MonitoringServer } from '../../../models';\n\ninterface Props\n  extends Pick<\n    FormikHelpers<FormikValues>,\n    'setFieldTouched' | 'setFieldValue'\n  > {\n  errors: FormikErrors<FormikValues>;\n  fieldPath: Array<string>;\n  name: string;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nconst MonitoringInstance = ({\n  name,\n  fieldPath,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  errors,\n  touched\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const [monitoringServer, setMonitoringServer] =\n    useState<MonitoringServer | null>(path(fieldPath, values) || null);\n\n  const { sendRequest } = useRequest({\n    decoder: listMonitoringServersDecoder,\n    defaultFailureMessage: t(labelSomethingWentWrong),\n    request: listMonitoringServers\n  });\n\n  const getMonitoringServer = (): MonitoringServer | undefined =>\n    path(fieldPath, values);\n\n  const getEndpoint = (params): string => {\n    return buildListingEndpoint({\n      baseEndpoint: listMonitoringServersEndpoint,\n      parameters: {\n        page: params.page,\n        search: {\n          conditions: [\n            {\n              field: 'is_activate',\n              values: {\n                $eq: '1'\n              }\n            },\n            ...(params.search?.conditions || [])\n          ]\n        },\n        sort: { name: 'ASC' }\n      }\n    });\n  };\n\n  const changeMonitoringInstance = (_, value): void => {\n    setFieldTouched(name);\n    setFieldValue(name, value?.name);\n    setMonitoringServer(value);\n  };\n\n  useEffect(() => {\n    if (getMonitoringServer()) {\n      const search = {\n        name: { $eq: getMonitoringServer() }\n      };\n\n      sendRequest({\n        customQueryParameters: [{ name: 'search', value: search }],\n        parameters: {\n          page: 1,\n          sort: { name: 'ASC' }\n        }\n      }).then(({ result }) => {\n        setMonitoringServer(result[0] || null);\n      });\n    }\n  }, []);\n\n  return (\n    <SingleConnectedAutocompleteField\n      required\n      error={path(fieldPath, touched) ? path(fieldPath, errors) : undefined}\n      field=\"name\"\n      getEndpoint={getEndpoint}\n      getOptionLabel={(option): string => option?.name || ''}\n      initialPage={1}\n      label={t(labelMonitoringServer)}\n      name={name}\n      value={monitoringServer}\n      onChange={changeMonitoringInstance}\n    />\n  );\n};\n\nconst MemoizedMonitoringInstance = memo(\n  MonitoringInstance,\n  (prevProps, nextProps) =>\n    equals(\n      path(prevProps.fieldPath, prevProps.values),\n      path(nextProps.fieldPath, nextProps.values)\n    ) &&\n    equals(\n      path(prevProps.fieldPath, prevProps.touched),\n      path(nextProps.fieldPath, nextProps.touched)\n    ) &&\n    equals(\n      path(prevProps.fieldPath, prevProps.errors),\n      path(nextProps.fieldPath, nextProps.errors)\n    )\n);\n\nexport default MemoizedMonitoringInstance;\n","import { memo } from 'react';\n\nimport { FormikHelpers, FormikValues } from 'formik';\nimport { path, equals, find, propEq } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { SingleAutocompleteField } from '@centreon/ui';\n\nimport { labelOperator } from '../../../../translatedLabels';\n\nimport { useTranslatedOperators } from './operators';\n\ninterface Props\n  extends Pick<\n    FormikHelpers<FormikValues>,\n    'setFieldTouched' | 'setFieldValue'\n  > {\n  fieldPath: Array<string | number>;\n  name: string;\n  values: FormikValues;\n}\n\nconst Operator = ({\n  name,\n  fieldPath,\n  setFieldTouched,\n  setFieldValue,\n  values\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const translatedOperators = useTranslatedOperators();\n\n  const handleChange = (_, value): void => {\n    setFieldTouched(name);\n    setFieldValue(name, value?.id);\n  };\n\n  const nameValue = path(fieldPath, values);\n  const value = find(propEq(nameValue, 'id'), translatedOperators) || null;\n\n  return (\n    <SingleAutocompleteField\n      disableClearable\n      label={t(labelOperator)}\n      options={translatedOperators}\n      value={value}\n      onChange={handleChange}\n    />\n  );\n};\n\nconst MemoizedOperator = memo(Operator, (prevProps, nextProps) =>\n  equals(\n    path(prevProps.fieldPath, prevProps.values),\n    path(nextProps.fieldPath, nextProps.values)\n  )\n);\n\nexport default MemoizedOperator;\n","import { useTranslation } from 'react-i18next';\n\nimport { SelectEntry } from '@centreon/ui';\n\nimport {\n  labelContains,\n  labelDoesNotContains,\n  labelIsDifferentFrom,\n  labelIsEqualTo\n} from '../../../../translatedLabels';\n\nenum Operator {\n  contain = 'contain',\n  equal = 'equal',\n  notEqual = 'notequal',\n  notcontain = 'notcontain'\n}\n\nconst operators = [\n  Operator.equal,\n  Operator.notEqual,\n  Operator.contain,\n  Operator.notcontain\n];\n\nexport const useTranslatedOperators = (): Array<SelectEntry> => {\n  const { t } = useTranslation();\n\n  return [\n    { id: Operator.equal, name: t(labelIsEqualTo) },\n    { id: Operator.notEqual, name: t(labelIsDifferentFrom) },\n    { id: Operator.contain, name: t(labelContains) },\n    { id: Operator.notcontain, name: t(labelDoesNotContains) }\n  ];\n};\n\nexport default operators;\n","import { path, isNil, prop } from 'ramda';\n\nimport { Typography } from '@mui/material';\n\nimport {\n  labelResultKeyUsed,\n  labelResultPropertyFiltered,\n  labelResultPropertyUsed\n} from '../../../../translatedLabels';\nimport { SourceParameterCondition } from '../../../models';\n\ninterface Props {\n  source: SourceParameterCondition;\n}\n\nconst AdvancedAttributeSummary = ({ source }: Props): JSX.Element => {\n  const property = prop('property', source);\n  const indexKey = path(['index', 'key'], source);\n  const indexValue = path(['index', 'value'], source);\n\n  return (\n    <div>\n      {isNil(property) ? (\n        <Typography variant=\"caption\">\n          <>\n            {labelResultKeyUsed}: {indexKey}\n          </>\n        </Typography>\n      ) : (\n        <>\n          <Typography display=\"block\" variant=\"caption\">\n            <>\n              {labelResultPropertyFiltered}: {indexKey} = {`\"${indexValue}\"`}\n            </>\n          </Typography>\n          <Typography variant=\"caption\">\n            <>\n              {labelResultPropertyUsed}: {property}\n            </>\n          </Typography>\n        </>\n      )}\n    </div>\n  );\n};\n\nexport default AdvancedAttributeSummary;\n","import { path, find, gt, isNil, not, propEq } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Tooltip, Typography } from '@mui/material';\n\nimport { labelAND } from '../../../../translatedLabels';\nimport { ParameterCondition } from '../../../models';\nimport { useTranslatedOperators } from '../Operator/operators';\n\nimport AdvancedAttributeSummary from './AdvancedAttributesSummary';\n\nconst useStyles = makeStyles()((theme) => ({\n  conditionPrefix: {\n    marginRight: theme.spacing(0.5)\n  },\n  conditionsSummary: {\n    display: 'grid',\n    grid: 'auto-flow auto / auto',\n    marginBottom: theme.spacing(1),\n    padding: theme.spacing(0.5, 1)\n  }\n}));\n\ninterface Props {\n  conditions: Array<ParameterCondition>;\n}\n\nconst ConditionsSummary = ({ conditions }: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const translatedOperators = useTranslatedOperators();\n  const { t } = useTranslation();\n\n  return (\n    <div className={classes.conditionsSummary}>\n      {conditions.map(\n        (\n          { source: conditionSource, operator, value: conditionValue },\n          index\n        ) => {\n          const formattedConditionSource = `{{${conditionSource.name}}}`;\n          const translatedOperator = find(\n            propEq(operator, 'id'),\n            translatedOperators\n          )?.name;\n          const formattedValue = `\"${conditionValue}\"`;\n\n          const isAdvancedAttribute = not(\n            isNil(path(['index', 'key'], conditionSource))\n          );\n\n          return (\n            <div key={`${conditionSource.name} ${operator} ${conditionValue}`}>\n              {gt(index, 0) && (\n                <Typography\n                  className={classes.conditionPrefix}\n                  variant=\"caption\"\n                >\n                  {t(labelAND)}\n                </Typography>\n              )}\n              <Typography variant=\"caption\">\n                <Tooltip\n                  placement=\"top\"\n                  title={\n                    isAdvancedAttribute ? (\n                      <AdvancedAttributeSummary source={conditionSource} />\n                    ) : (\n                      ''\n                    )\n                  }\n                >\n                  <Typography display=\"inline\" variant=\"caption\">\n                    {isAdvancedAttribute ? (\n                      <strong>{formattedConditionSource}</strong>\n                    ) : (\n                      formattedConditionSource\n                    )}\n                  </Typography>\n                </Tooltip>{' '}\n                {translatedOperator} {formattedValue}\n              </Typography>\n            </div>\n          );\n        }\n      )}\n    </div>\n  );\n};\n\nexport default ConditionsSummary;\n","import { isNil, length, not, pipe } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport ArrowIcon from '@mui/icons-material/ArrowForward';\nimport { Avatar, Tooltip, Typography } from '@mui/material';\n\nimport { PopoverMenu } from '@centreon/ui';\n\nimport { labelConditions } from '../../../../translatedLabels';\nimport { ParameterCondition } from '../../../models';\n\nimport ConditionsSummary from './ConditionsSummary';\n\ninterface StylesProps {\n  displayConditions: boolean;\n}\n\nconst useStyles = makeStyles<StylesProps>()((theme, { displayConditions }) => ({\n  conditionsTag: {\n    backgroundColor: theme.palette.primary.main,\n    fontSize: theme.typography.body2.fontSize,\n    height: theme.spacing(2),\n    width: theme.spacing(2)\n  },\n  conditionsTooltip: {\n    maxWidth: theme.breakpoints.values.sm\n  },\n  icon: {\n    fontSize: 14,\n    marginRight: theme.spacing(1)\n  },\n  mapperPreview: {\n    alignItems: 'center',\n    columnGap: theme.spacing(0.5),\n    display: 'grid',\n    gridTemplateColumns: displayConditions\n      ? `${theme.spacing(2)} auto`\n      : 'auto',\n    height: '100%'\n  },\n  title: {\n    color: theme.palette.grey[600],\n    display: 'flex'\n  },\n  tooltip: {\n    maxWidth: 'none'\n  },\n  valuesPreview: {\n    alignContent: 'center',\n    display: 'grid',\n    grid: 'auto-flow min-content / 1fr',\n    height: '100%',\n    rowGap: theme.spacing(0.5)\n  }\n}));\n\ninterface Props {\n  conditions: Array<ParameterCondition>;\n  destination?: string;\n  source?: string;\n  value?: string;\n}\n\nconst Preview = ({\n  source,\n  value,\n  destination,\n  conditions = []\n}: Props): JSX.Element => {\n  const { classes } = useStyles({ displayConditions: length(conditions) > 0 });\n  const { t } = useTranslation();\n\n  const isDefined = pipe(isNil, not);\n\n  const hasCondition = length(conditions) > 0;\n\n  return (\n    <div className={classes.mapperPreview}>\n      {hasCondition && (\n        <PopoverMenu\n          className={classes.conditionsTooltip}\n          icon={\n            <Avatar\n              aria-label={t(labelConditions)}\n              className={classes.conditionsTag}\n            >\n              {length(conditions)}\n            </Avatar>\n          }\n          popperPlacement=\"top\"\n        >\n          {(): JSX.Element => <ConditionsSummary conditions={conditions} />}\n        </PopoverMenu>\n      )}\n      <div className={classes.valuesPreview}>\n        <Tooltip\n          classes={{ tooltip: classes.tooltip }}\n          disableFocusListener={isDefined(value)}\n          disableHoverListener={isDefined(value)}\n          disableTouchListener={isDefined(value)}\n          placement=\"top\"\n          title={source || ''}\n        >\n          <Typography noWrap className={classes.title} variant=\"caption\">\n            {source || value || ''}\n          </Typography>\n        </Tooltip>\n        {isDefined(destination) && (\n          <Typography noWrap className={classes.title} variant=\"caption\">\n            <ArrowIcon className={classes.icon} />\n            {destination}\n          </Typography>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Preview;\n","import { FormikErrors, FormikValues } from 'formik';\nimport { path } from 'ramda';\n\nimport { Grid } from '@mui/material';\n\nimport { GetSource, MapperFormProps, Source } from '../../../models';\nimport Conditions from '../Conditions';\nimport DestinationAutocomplete from '../Destination/DestinationAutocomplete';\nimport SourceAutocomplete from '../Source';\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: MapperFormProps): JSX.Element => {\n  const getSource = (object): GetSource =>\n    path(['parameters', 'source'], object);\n\n  const getDestination = (object): string | boolean | undefined =>\n    path(['parameters', 'destination'], object);\n\n  return (\n    <Grid container direction=\"column\" spacing={1}>\n      <Grid item>\n        <Conditions\n          errors={errors}\n          handleBlur={handleBlur}\n          handleChange={handleChange}\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          sources={sources}\n          touched={touched}\n          values={values}\n        />\n      </Grid>\n      <Grid item>\n        <SourceAutocomplete\n          supportAdvancedAtribute\n          error={getSource(errors) as FormikErrors<FormikValues> | null}\n          name=\"parameters.source\"\n          sources={sources}\n          values={getSource(values) as Array<Source>}\n        />\n      </Grid>\n      <Grid item>\n        <DestinationAutocomplete\n          error={getDestination(errors) as string | undefined}\n          name=\"parameters.destination\"\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          touched={getDestination(touched) as boolean}\n          values={getDestination(values) as string}\n        />\n      </Grid>\n    </Grid>\n  );\n};\n\nexport default Form;\n","import { path, pathOr } from 'ramda';\n\nimport { PreviewMapperProps } from '../../../models';\nimport MapperPreview from '../Preview';\nimport getSourcePreview from '../Source/preview';\n\nconst Preview = ({ mapper }: PreviewMapperProps): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr([], ['parameters', 'conditions'], mapper)}\n    destination={path(['parameters', 'destination'], mapper)}\n    source={getSourcePreview(pathOr([], ['parameters', 'source'], mapper))}\n  />\n);\n\nexport default Preview;\n","import { array, object, string } from 'yup';\nimport { labelRequired } from '../../../../translatedLabels';\nimport { MapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\nimport sourceValidationSchema from '../Source/validationSchema';\n\nconst validationSchema = (t: Translation): MapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    destination: string().nullable().required(t(labelRequired)),\n    source: sourceValidationSchema(t)\n  })\n});\n\nexport default validationSchema;\n","import { FormikValues, useFormikContext } from 'formik';\nimport { isNil } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Typography } from '@mui/material';\n\nimport { labelAdvancedSourceConfiguration } from '../../../../../translatedLabels';\nimport { Attribute } from '../../../../models';\nimport AdvancedAttribute from '../../Conditions/AdvancedAttributeForm';\n\nconst useStyles = makeStyles()((theme) => ({\n  title: {\n    marginBottom: theme.spacing(2)\n  }\n}));\n\nconst AdvancedAttributeStep = (attribute: Attribute): (() => JSX.Element) => {\n  const Form = (): JSX.Element => {\n    const {\n      errors,\n      values,\n      handleBlur,\n      handleChange,\n      setFieldTouched,\n      setFieldValue,\n      touched\n    } = useFormikContext<FormikValues>();\n    const { t } = useTranslation();\n    const { classes } = useStyles();\n\n    if (isNil(attribute)) {\n      return <div />;\n    }\n\n    return (\n      <div>\n        <Typography align=\"center\" className={classes.title} variant=\"h5\">\n          {t(labelAdvancedSourceConfiguration)}\n        </Typography>\n        <AdvancedAttribute\n          attributeConfiguration={attribute}\n          errors={errors}\n          fieldPath={['source']}\n          handleBlur={handleBlur}\n          handleChange={handleChange}\n          name=\"source\"\n          setFieldTouched={setFieldTouched}\n          setFieldValue={setFieldValue}\n          touched={touched}\n          values={values}\n        />\n      </div>\n    );\n  };\n\n  return Form;\n};\n\nexport default AdvancedAttributeStep;\n","import { makeStyles } from 'tss-react/mui';\n\nconst useStyles = makeStyles()((theme) => ({\n  wizardContent: {\n    padding: theme.spacing(2)\n  }\n}));\n\nexport default useStyles;\n","import { FormikValues } from 'formik';\nimport { and, equals, isNil, not, pipe, prop, propOr } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { Wizard } from '@centreon/ui';\n\nimport { AdvancedAttributeToConfigure } from '..';\nimport {\n  labelCancel,\n  labelCancelAdvancedSourceConfiguration,\n  labelConfirm,\n  labelFinish\n} from '../../../../../translatedLabels';\nimport {\n  Attribute,\n  AttributeType,\n  Source,\n  SourceType\n} from '../../../../models';\n\nimport AdvancedAttributeStep from './AdvancedAttributeStep';\nimport useStyles from './advancedAttributeForm.styles';\nimport sourceValidationSchema from './validationSchema';\n\ninterface Props {\n  advancedAttributeToConfigure: AdvancedAttributeToConfigure | null;\n  close: () => void;\n  confirm: (source: Source) => void;\n}\n\nconst isDefined = pipe(isNil, not);\n\nconst getInitialValues = (\n  advancedAttributeToConfigure: AdvancedAttributeToConfigure | null\n): Source | undefined => {\n  if (isNil(advancedAttributeToConfigure)) {\n    return undefined;\n  }\n\n  const { name, type, properties } = advancedAttributeToConfigure.attribute;\n  const values = prop('values', advancedAttributeToConfigure);\n\n  if (isDefined(values)) {\n    return values;\n  }\n\n  const isArrayAttribute = equals(type, AttributeType.array);\n  const hasDefinedProperties = not(isNil(properties));\n\n  const isObjectArrayAttribute = hasDefinedProperties && isArrayAttribute;\n\n  const baseSource: Source = {\n    type: SourceType.discovery,\n    value: name\n  };\n\n  return isObjectArrayAttribute\n    ? {\n        ...baseSource,\n        index: {\n          key: '',\n          value: ''\n        },\n        property: ''\n      }\n    : {\n        ...baseSource,\n        index: {\n          key: ''\n        }\n      };\n};\n\nconst AdvancedAttributeForm = ({\n  confirm,\n  advancedAttributeToConfigure,\n  close\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n  const submit = (values: FormikValues): void =>\n    confirm(values.source as Source);\n\n  const initialValues = getInitialValues(advancedAttributeToConfigure);\n\n  const attribute = propOr(null, 'attribute', advancedAttributeToConfigure);\n\n  const open = and(isDefined(attribute), isDefined(initialValues));\n\n  return (\n    <Wizard\n      actionsBarLabels={{\n        labelFinish: t(labelFinish),\n        labelNext: '',\n        labelPrevious: ''\n      }}\n      classNameDialogContent={classes.wizardContent}\n      confirmDialogLabels={{\n        labelCancel: t(labelCancel),\n        labelConfirm: t(labelConfirm),\n        labelMessage: '',\n        labelTitle: t(labelCancelAdvancedSourceConfiguration)\n      }}\n      initialValues={{ source: initialValues }}\n      open={open}\n      steps={[\n        {\n          Component: AdvancedAttributeStep(attribute as Attribute),\n          stepName: '',\n          validationSchema: sourceValidationSchema(t)\n        }\n      ]}\n      width=\"xs\"\n      onClose={close}\n      onSubmit={submit}\n    />\n  );\n};\n\nexport default AdvancedAttributeForm;\n","import { equals, includes, keysIn, or, type } from 'ramda';\nimport { Schema, mixed, object, string } from 'yup';\n\nimport { SelectEntry } from '@centreon/ui';\n\nimport { labelRequired } from '../../../../../translatedLabels';\nimport {\n  IndexSourceParameterCondition,\n  SourceType,\n  Translation\n} from '../../../../models';\nimport { selectEntryValidationSchema } from '../validationSchema';\n\nexport interface Source {\n  index?: IndexSourceParameterCondition;\n  property?: string;\n  type: SourceType;\n  value: string | SelectEntry | { id: number | string };\n}\n\ninterface SourceForm {\n  source: Source;\n}\n\nconst sourceValidationSchema = (t: Translation): Schema<SourceForm> =>\n  object({\n    source: object().shape({\n      index: object()\n        .shape({\n          key: mixed().nullable().required(t(labelRequired)),\n          value: string()\n            .nullable()\n            .when('key', ([key], schema) => {\n              return equals(type(key), 'Number')\n                ? schema.notRequired()\n                : schema.required(t(labelRequired));\n            })\n        })\n        .optional(),\n      property: string()\n        .when('index', ([index], schema) => {\n          return includes('value', keysIn(index))\n            ? schema.required(t(labelRequired))\n            : schema;\n        })\n        .optional(),\n      type: mixed().oneOf(Object.values(SourceType)),\n      value: string()\n        .when('type', ([sourceType], schema) => {\n          if (\n            or(\n              equals(sourceType, SourceType.discovery),\n              equals(sourceType, SourceType.string)\n            )\n          ) {\n            return schema;\n          }\n\n          return selectEntryValidationSchema;\n        })\n        .nullable()\n        .required(t(labelRequired))\n    })\n  });\n\nexport default sourceValidationSchema;\n","import { path, isNil, prop } from 'ramda';\n\nimport { Typography } from '@mui/material';\n\nimport {\n  labelResultKeyUsed,\n  labelResultPropertyFiltered,\n  labelResultPropertyUsed\n} from '../../../../translatedLabels';\nimport { Source } from '../../../models';\n\ninterface Props {\n  source: Source;\n}\n\nconst AdvancedSourceSummary = ({ source }: Props): JSX.Element => {\n  const property = prop('property', source);\n  const indexKey = path(['index', 'key'], source);\n  const indexValue = path(['index', 'value'], source);\n\n  return (\n    <div>\n      {isNil(property) ? (\n        <Typography display=\"block\" variant=\"caption\">\n          <>\n            {labelResultKeyUsed}: {indexKey}\n          </>\n        </Typography>\n      ) : (\n        <>\n          <Typography display=\"block\" variant=\"caption\">\n            <>\n              {labelResultPropertyFiltered}: {indexKey} = {`\"${indexValue}\"`}\n            </>\n          </Typography>\n          <Typography variant=\"caption\">\n            <>\n              {labelResultPropertyUsed}: {property}\n            </>\n          </Typography>\n        </>\n      )}\n    </div>\n  );\n};\n\nexport default AdvancedSourceSummary;\n","import { memo } from 'react';\n\nimport { FormikErrors, FormikValues } from 'formik';\nimport { equals } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { Tooltip } from '@mui/material';\n\nimport { DraggableAutocompleteField } from '@centreon/ui';\n\nimport { labelSource } from '../../../../translatedLabels';\nimport { Attribute, ProviderAttributes, Source } from '../../../models';\n\nimport AdvancedAttributeForm from './AdvancedAttributeForm';\nimport AdvancedSourceSummary from './AdvancedSourceSummary';\nimport { isDefined, useSourceForm } from './useSourceForm';\n\ninterface Props {\n  error: FormikErrors<FormikValues> | null;\n  labelField?: string;\n  name: string;\n  sources: ProviderAttributes;\n  supportAdvancedAtribute?: boolean;\n  values: Array<Source>;\n}\n\nexport interface AdvancedAttributeToConfigure {\n  attribute: Attribute;\n  index: number;\n  values?: Source;\n}\n\nconst SourceAutocomplete = ({\n  name,\n  values,\n  error = null,\n  sources,\n  labelField = labelSource,\n  supportAdvancedAtribute\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n  const {\n    advancedAttributeToConfigure,\n    saveAdvancedAttributeSource,\n    getInitialValues,\n    itemClick,\n    handleAutocompleteChange,\n    options,\n    closeDialog,\n    itemHover,\n    itemHovered,\n    getIsAdvancedAttributeFromName,\n    blur\n  } = useSourceForm({ name, sources, supportAdvancedAtribute, values });\n\n  const sourceHovered = isDefined(itemHovered)\n    ? values[itemHovered?.index as number]\n    : null;\n\n  const isAdvancedAttributeHovered = isDefined(sourceHovered)\n    ? getIsAdvancedAttributeFromName(sourceHovered?.value as string)\n    : false;\n\n  return (\n    <div>\n      <Tooltip\n        PopperProps={{\n          anchorEl: itemHovered?.anchorElement\n        }}\n        TransitionProps={{ timeout: 0 }}\n        open={isDefined(sourceHovered)}\n        title={\n          isDefined(sourceHovered) && isAdvancedAttributeHovered ? (\n            <AdvancedSourceSummary source={sourceHovered as Source} />\n          ) : (\n            ''\n          )\n        }\n      >\n        <div>\n          <DraggableAutocompleteField\n            required\n            disableClearable={false}\n            error={error || undefined}\n            initialValues={getInitialValues()}\n            itemClick={itemClick}\n            itemHover={itemHover}\n            label={t(labelField)}\n            name={name}\n            options={options || []}\n            onBlur={blur}\n            onSelectedValuesChange={handleAutocompleteChange}\n          />\n        </div>\n      </Tooltip>\n\n      <AdvancedAttributeForm\n        advancedAttributeToConfigure={advancedAttributeToConfigure}\n        close={closeDialog}\n        confirm={saveAdvancedAttributeSource}\n      />\n    </div>\n  );\n};\n\nconst MemoizedSourceAutocomplete = memo(\n  SourceAutocomplete,\n  (prevProps, nextProps) =>\n    equals(prevProps.values, nextProps.values) &&\n    equals(prevProps.sources, nextProps.sources) &&\n    equals(prevProps.error, nextProps.error)\n);\n\nexport default MemoizedSourceAutocomplete;\n","import { always, equals, ifElse, reduce } from 'ramda';\n\nimport { Source, SourceType } from '../../../models';\n\nconst formatSourceValue = ({ type, value }): string =>\n  ifElse(\n    equals(SourceType.discovery),\n    always(`{{${value}}}`),\n    always(value.name ?? value)\n  )(type);\n\nconst getSourcePreview = (sources: Array<Source>): string =>\n  reduce((acc, source) => `${acc}${formatSourceValue(source)}`, '', sources);\n\nexport default getSourcePreview;\n","import { useState } from 'react';\n\nimport { FormikValues, useFormikContext } from 'formik';\nimport {\n  T,\n  addIndex,\n  always,\n  cond,\n  equals,\n  find,\n  flatten,\n  isEmpty,\n  isNil,\n  length,\n  lensIndex,\n  map,\n  not,\n  pipe,\n  pluck,\n  prop,\n  propEq,\n  propOr,\n  remove,\n  set\n} from 'ramda';\n\nimport {\n  DraggableSelectEntry,\n  ItemActionProps,\n  SelectEntry\n} from '@centreon/ui';\n\nimport {\n  Attribute,\n  AttributeType,\n  ProviderAttributes,\n  Source,\n  SourceType\n} from '../../../models';\n\nimport { AdvancedAttributeToConfigure } from '.';\n\ninterface Props {\n  name: string;\n  sources: ProviderAttributes;\n  supportAdvancedAtribute?: boolean;\n  values: Array<Source>;\n}\n\ninterface ItemHovered {\n  anchorElement?: HTMLElement | null;\n  index: number;\n}\n\ninterface SourceForm {\n  advancedAttributeToConfigure: AdvancedAttributeToConfigure | null;\n  blur: () => void;\n  closeDialog: () => void;\n  getInitialValues: () => Array<SelectEntry>;\n  getIsAdvancedAttributeFromName: (attributeName: string) => boolean;\n  handleAutocompleteChange: (\n    selectedValues: Array<SelectEntry>,\n    lastValueAdded?: DraggableSelectEntry | undefined\n  ) => void;\n  itemClick: (item: ItemActionProps) => void;\n  itemHover: (item: ItemActionProps) => void;\n  itemHovered: ItemHovered | null;\n  options: Array<SelectEntry>;\n  saveAdvancedAttributeSource: (newSource: Source) => void;\n}\n\nconst isDefined = pipe(isNil, not);\n\nconst useSourceForm = ({\n  sources,\n  values,\n  supportAdvancedAtribute,\n  name\n}: Props): SourceForm => {\n  const [advancedAttributeToConfigure, setAdvancedAttributeToConfigure] =\n    useState<AdvancedAttributeToConfigure | null>(null);\n  const [itemHovered, setItemHovered] = useState<ItemHovered | null>(null);\n\n  const { setFieldValue, setFieldTouched } = useFormikContext<FormikValues>();\n\n  const getAllAttributes = (): Array<Attribute> =>\n    flatten([sources.attributes, sources.parameters, sources.credentials]);\n\n  const getAttributeFromName = (attributeName: string): Attribute => {\n    const allAttributes = getAllAttributes();\n\n    return find(propEq(attributeName, 'name'), allAttributes) as Attribute;\n  };\n\n  const getIsAdvancedAttributeFromName = (attributeName: string): boolean => {\n    const attribute = getAttributeFromName(attributeName);\n\n    return equals(prop('type', attribute), AttributeType.array);\n  };\n\n  const handleAutocompleteChange = (\n    selectedValues: Array<SelectEntry>,\n    lastValueAdded?: DraggableSelectEntry\n  ): void => {\n    if (\n      equals(\n        pluck('id', selectedValues) as Array<string>,\n        pluck('id', values || [])\n      )\n    ) {\n      return;\n    }\n\n    if (\n      not(isNil(lastValueAdded)) &&\n      isNil(lastValueAdded?.createOption) &&\n      supportAdvancedAtribute\n    ) {\n      const sourceAttribute = getAttributeFromName(lastValueAdded?.name || '');\n\n      const isAdvancedAttribute = getIsAdvancedAttributeFromName(\n        sourceAttribute.name\n      );\n\n      if (isAdvancedAttribute) {\n        setAdvancedAttributeToConfigure({\n          attribute: sourceAttribute,\n          index: length(values || [])\n        });\n      }\n    }\n\n    setFieldValue(\n      name,\n      map((value) => {\n        const currentSource = find(\n          ({ id }) => equals<string | number | undefined>(id, value.id),\n          values || []\n        );\n\n        if (isDefined(currentSource)) {\n          return currentSource;\n        }\n\n        return {\n          id: value.id,\n          type: isNil(value.createOption)\n            ? SourceType.discovery\n            : SourceType.string,\n          value: value.name\n        };\n      }, selectedValues || [])\n    );\n  };\n\n  const mapIndexedSource = addIndex<Source, SelectEntry>(map);\n\n  const mapIndexed = addIndex<Attribute, SelectEntry>(map);\n\n  const options = isEmpty(sources)\n    ? []\n    : mapIndexed(\n        ({ name: sourceName }, index) => ({ id: index, name: sourceName }),\n        flatten([sources.attributes, sources.parameters, sources.credentials])\n      );\n\n  interface GetFormattedValueProps {\n    index: number;\n    value: Source;\n  }\n\n  const getFormattedValue = ({\n    value,\n    index\n  }: GetFormattedValueProps): SelectEntry =>\n    cond<Source, SelectEntry>([\n      [\n        propEq(SourceType.string, 'type'),\n        always({\n          createOption: prop('value', value),\n          id: value.id || `${value.value}_${index}`,\n          name: prop('value', value)\n        } as SelectEntry)\n      ],\n      [\n        T,\n        always({\n          id: value.id || `${value.value}_${index}`,\n          name: prop('value', value)\n        } as SelectEntry)\n      ]\n    ])(value);\n\n  const getInitialValues = (): Array<SelectEntry> =>\n    mapIndexedSource(\n      (value: Source, index: number) => getFormattedValue({ index, value }),\n      values || ([] as Array<Source>)\n    );\n\n  const itemClick = (item: ItemActionProps): void => {\n    if (not(supportAdvancedAtribute)) {\n      return;\n    }\n\n    const source = values[item.index];\n\n    const attribute = getAttributeFromName(source.value as string);\n    const isAdvancedAttribute = getIsAdvancedAttributeFromName(\n      source.value as string\n    );\n\n    if (not(isAdvancedAttribute)) {\n      return;\n    }\n\n    setAdvancedAttributeToConfigure({\n      attribute,\n      index: item.index,\n      values: source\n    });\n  };\n\n  const closeDialog = (): void => {\n    const isEditing = isDefined(\n      propOr(null, 'values', advancedAttributeToConfigure)\n    );\n\n    setAdvancedAttributeToConfigure(null);\n\n    if (isEditing) {\n      return;\n    }\n\n    const sourceIndex = propOr<\n      number,\n      AdvancedAttributeToConfigure | null,\n      number\n    >(0, 'index', advancedAttributeToConfigure);\n    setFieldValue(name, remove(sourceIndex, 1, values));\n  };\n\n  const saveAdvancedAttributeSource = (newSource: Source): void => {\n    if (isNil(advancedAttributeToConfigure)) {\n      return;\n    }\n\n    const index = prop('index', advancedAttributeToConfigure);\n\n    const sourceLens = lensIndex(index);\n\n    const newSourcesValue = set(\n      sourceLens,\n      {\n        id: `${newSource.value}_${index}`,\n        ...newSource\n      },\n      values\n    );\n\n    setAdvancedAttributeToConfigure(null);\n    setFieldValue(name, newSourcesValue);\n  };\n\n  const itemHover = (item: ItemActionProps): void => {\n    if (not(supportAdvancedAtribute)) {\n      return;\n    }\n\n    if (isNil(item)) {\n      setItemHovered(null);\n\n      return;\n    }\n\n    const { anchorElement, index } = item;\n\n    setItemHovered({ anchorElement, index });\n  };\n\n  const blur = (): void => {\n    setFieldTouched(name, true);\n  };\n\n  return {\n    advancedAttributeToConfigure,\n    blur,\n    closeDialog,\n    getInitialValues,\n    getIsAdvancedAttributeFromName,\n    handleAutocompleteChange,\n    itemClick,\n    itemHover,\n    itemHovered,\n    options,\n    saveAdvancedAttributeSource\n  };\n};\n\nexport { isDefined, useSourceForm };\n","import { equals, or } from 'ramda';\nimport { ArraySchema, Schema, array, mixed, number, object, string } from 'yup';\n\nimport { SelectEntry } from '@centreon/ui';\n\nimport { labelRequired } from '../../../../translatedLabels';\nimport { SourceType, Translation } from '../../../models';\n\nexport const selectEntryValidationSchema = object().shape({\n  id: number(),\n  name: string()\n});\n\ninterface Source {\n  type: SourceType;\n  value: string | SelectEntry | { id: number | string };\n}\n\nconst validationSchema = (\n  t: Translation\n): ArraySchema<Schema<Source>, undefined> =>\n  array()\n    .of(\n      object().shape({\n        type: mixed().oneOf(Object.values(SourceType)),\n        value: string()\n          .when('type', ([sourceType], schema) => {\n            if (\n              or(\n                equals(sourceType, SourceType.discovery),\n                equals(sourceType, SourceType.string)\n              )\n            ) {\n              return schema;\n            }\n\n            return selectEntryValidationSchema;\n          })\n          .nullable()\n          .required(t(labelRequired))\n      })\n    )\n    .min(1, t(labelRequired));\n\nexport default validationSchema;\n","import { Grid } from '@mui/material';\n\nimport { MapperFormProps } from '../../../models';\nimport Conditions from '../Conditions';\nimport HostTemplateAutocomplete from '../HostTemplate';\n\nconst Form = ({\n  errors,\n  handleBlur,\n  handleChange,\n  setFieldTouched,\n  setFieldValue,\n  values,\n  sources,\n  touched\n}: MapperFormProps): JSX.Element => (\n  <Grid container direction=\"column\" spacing={1}>\n    <Grid item>\n      <Conditions\n        errors={errors}\n        handleBlur={handleBlur}\n        handleChange={handleChange}\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        sources={sources}\n        touched={touched}\n        values={values}\n      />\n    </Grid>\n    <Grid item>\n      <HostTemplateAutocomplete\n        errors={errors}\n        fieldPath={['parameters', 'value']}\n        name=\"parameters.value\"\n        setFieldTouched={setFieldTouched}\n        setFieldValue={setFieldValue}\n        touched={touched}\n        values={values}\n      />\n    </Grid>\n  </Grid>\n);\n\nexport default Form;\n","import { pathOr } from 'ramda';\n\nimport { PreviewMapperProps } from '../../../models';\nimport MapperPreview from '../Preview';\n\nconst Preview = ({ mapper }: PreviewMapperProps): JSX.Element => (\n  <MapperPreview\n    conditions={pathOr([], ['parameters', 'conditions'], mapper)}\n    value={pathOr('', ['parameters', 'value'], mapper)}\n  />\n);\n\nexport default Preview;\n","import { array, object, string } from 'yup';\nimport { labelRequired } from '../../../../translatedLabels';\nimport { MapperValidationSchema, Translation } from '../../../models';\nimport conditionValidationSchema from '../Conditions/validationSchema';\n\nconst validationSchema = (t: Translation): MapperValidationSchema => ({\n  parameters: object().shape({\n    conditions: array().of(conditionValidationSchema(t)),\n    value: string().nullable().required(t(labelRequired))\n  })\n});\n\nexport default validationSchema;\n","import {\n  labelExclusion,\n  labelHostCategory,\n  labelHostGroup,\n  labelHostSeverity,\n  labelInclusion,\n  labelMacro,\n  labelMonitoring,\n  labelProperty,\n  labelTemplate\n} from '../../../translatedLabels';\nimport { MapperRules, MapperType } from '../../models';\n\nimport {\n  Form as HostCategoryForm,\n  initialValues as HostCategoryInitialValues\n} from './HostCategory';\nimport {\n  Preview as HostConfigurationPreview,\n  validationSchema as HostConfigurationSchema,\n  Form as HostGroupForm,\n  initialValues as HostGroupInitialValues\n} from './HostGroup';\nimport {\n  Form as HostSeverityForm,\n  initialValues as HostSeverityInitialValues,\n  Preview as HostSeverityPreview,\n  validationSchema as HostSeveritySchema\n} from './HostSeverity';\nimport {\n  Form as InclusionExclusionForm,\n  Preview as InclusionExclusionPreview,\n  initialValues as inclusionExclusionInitialValues,\n  validationSchema as inclusionExclusionSchema\n} from './InclusionExclusion';\nimport {\n  Form as MacroForm,\n  Preview as MacroPreview,\n  initialValues as macroInitialValues,\n  validationSchema as macroSchema\n} from './Macro';\nimport {\n  Form as MonitoringForm,\n  Preview as MonitoringPreview,\n  validationSchema as monitoringSchema\n} from './Monitoring';\nimport {\n  Form as PropertyForm,\n  Preview as PropertyPreview,\n  validationSchema as propertySchema\n} from './Property';\nimport {\n  Form as TemplateForm,\n  Preview as TemplatePreview,\n  validationSchema as templateSchema\n} from './Template';\n\nconst rules: MapperRules = {\n  exclusion: {\n    Form: InclusionExclusionForm,\n    Preview: InclusionExclusionPreview,\n    initialValues: inclusionExclusionInitialValues.exclusion,\n    order: 7,\n    title: labelExclusion,\n    type: MapperType.exclusion,\n    validationSchema: inclusionExclusionSchema\n  },\n  hostCategory: {\n    Form: HostCategoryForm,\n    Preview: HostConfigurationPreview,\n    initialValues: HostCategoryInitialValues,\n    order: 4,\n    title: labelHostCategory,\n    type: MapperType.hostCategory,\n    validationSchema: HostConfigurationSchema\n  },\n  hostGroup: {\n    Form: HostGroupForm,\n    Preview: HostConfigurationPreview,\n    initialValues: HostGroupInitialValues,\n    order: 3,\n    title: labelHostGroup,\n    type: MapperType.hostGroup,\n    validationSchema: HostConfigurationSchema\n  },\n  hostSeverity: {\n    Form: HostSeverityForm,\n    Preview: HostSeverityPreview,\n    initialValues: HostSeverityInitialValues,\n    order: 5,\n    title: labelHostSeverity,\n    type: MapperType.hostSeverity,\n    validationSchema: HostSeveritySchema\n  },\n  inclusion: {\n    Form: InclusionExclusionForm,\n    Preview: InclusionExclusionPreview,\n    initialValues: inclusionExclusionInitialValues.inclusion,\n    order: 6,\n    title: labelInclusion,\n    type: MapperType.inclusion,\n    validationSchema: inclusionExclusionSchema\n  },\n  macro: {\n    Form: MacroForm,\n    Preview: MacroPreview,\n    initialValues: macroInitialValues,\n    order: 1,\n    title: labelMacro,\n    type: MapperType.macro,\n    validationSchema: macroSchema\n  },\n  monitoring: {\n    Form: MonitoringForm,\n    Preview: MonitoringPreview,\n    order: 8,\n    title: labelMonitoring,\n    type: MapperType.monitoring,\n    validationSchema: monitoringSchema\n  },\n  property: {\n    Form: PropertyForm,\n    Preview: PropertyPreview,\n    order: 0,\n    title: labelProperty,\n    type: MapperType.property,\n    validationSchema: propertySchema\n  },\n  template: {\n    Form: TemplateForm,\n    Preview: TemplatePreview,\n    order: 2,\n    title: labelTemplate,\n    type: MapperType.template,\n    validationSchema: templateSchema\n  }\n};\n\nexport default rules;\n","import { memo, useEffect, useState } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHelpers,\n  FormikValues,\n  useFormikContext\n} from 'formik';\nimport {\n  and,\n  equals,\n  indexOf,\n  insertAll,\n  isNil,\n  omit,\n  pipe,\n  pluck,\n  reject\n} from 'ramda';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Skeleton, useTheme } from '@mui/material';\n\nimport { useRequest } from '@centreon/ui';\n\nimport { listProvidersAttributes } from '../api';\nimport { listProviderAttributesDecoder } from '../api/decoders';\nimport { Mapper, ProviderAttributes } from '../models';\n\nimport MappersListing from './MappersListing';\nimport Preview from './Preview';\n\nconst useStyles = makeStyles()((theme) => ({\n  loadingMappersContainer: {\n    display: 'grid',\n    gridTemplateRows: `repeat(5, ${theme.spacing(4)})`,\n    rowGap: theme.spacing(2)\n  },\n  mappers: {\n    marginTop: theme.spacing(1),\n    textAlign: 'center'\n  },\n  mappersArea: {\n    gridArea: 'mappers',\n    marginBottom: theme.spacing(0.5),\n    overflowY: 'auto'\n  },\n  mappersContainer: {\n    width: '100%'\n  },\n  mappersStep: {\n    display: 'grid',\n    gridTemplateAreas: `\n      \"mappers preview\"\n    `,\n    gridTemplateColumns: 'repeat(2, 1fr)',\n    height: '100%'\n  },\n  previewArea: {\n    gridArea: 'preview',\n    height: 'fit-content'\n  },\n  skeletonMapper: {\n    margin: theme.spacing(0, 1)\n  }\n}));\n\ninterface MappersFormProps\n  extends Pick<FormikHelpers<FormikValues>, 'setFieldValue'> {\n  disableNextOnSendingRequests?: (props: Array<boolean>) => void;\n  displayMappersOnly?: boolean;\n  edit?: boolean;\n  errors: FormikErrors<FormikValues>;\n  values: FormikValues;\n}\n\nconst MappersForm = ({\n  displayMappersOnly = false,\n  edit = false,\n  disableNextOnSendingRequests,\n  values,\n  errors,\n  setFieldValue\n}: MappersFormProps): JSX.Element => {\n  const { classes } = useStyles();\n  const [sources, setSources] = useState<ProviderAttributes | null>(null);\n  const { sendRequest, sending } = useRequest({\n    decoder: listProviderAttributesDecoder,\n    request: listProvidersAttributes\n  });\n  const theme = useTheme();\n\n  const handleDragEnd = (result): void => {\n    setFieldValue('mappers', result);\n  };\n\n  const handleAdd = (): void => {\n    const mappersId = pluck(\n      'id',\n      values.mappers as Array<Mapper>\n    ) as Array<number>;\n    setFieldValue('mappers', [\n      ...values.mappers,\n      {\n        adding: true,\n        editing: true,\n        id: Math.max(...mappersId) + 1,\n        type: null\n      }\n    ]);\n  };\n\n  const handleDuplicate = ({ duplicationCount, mapperId }): void => {\n    const mapperToDuplicate = values.mappers.find(\n      (mapper) => mapper.id === mapperId\n    );\n\n    const duplicatedElements = Array.from(\n      { length: duplicationCount },\n      (_, index) => ({\n        ...mapperToDuplicate,\n        id: mapperToDuplicate.id + index + 1\n      })\n    );\n\n    const indexOfMapper = indexOf(mapperToDuplicate, values.mappers);\n\n    const updateMapperIds = (mappers): Array<Mapper> =>\n      mappers.map((mapper) =>\n        mapper.id > mapperToDuplicate.id\n          ? { ...mapper, id: mapper.id + duplicationCount + 1 }\n          : mapper\n      );\n\n    const insertDuplicatedMappers = (mappers): Array<Mapper> => {\n      return insertAll(indexOfMapper + 1, duplicatedElements, mappers);\n    };\n\n    const mappers = pipe(\n      updateMapperIds,\n      insertDuplicatedMappers\n    )(values.mappers);\n\n    setFieldValue('mappers', mappers);\n  };\n\n  const handleEdit = (mapperId): void => {\n    setFieldValue(\n      'mappers',\n      values.mappers.map((mapper) => {\n        if (mapper.id === mapperId) {\n          return {\n            ...mapper,\n            editing: true\n          };\n        }\n\n        return mapper;\n      })\n    );\n  };\n\n  const handleSave = (mapperValues): void => {\n    setFieldValue(\n      'mappers',\n      values.mappers.map((mapper) => {\n        const currentMapperValues = { ...mapperValues };\n        if (\n          mapper.id === currentMapperValues.id &&\n          (currentMapperValues.adding || currentMapperValues.editing)\n        ) {\n          return omit(['editing', 'adding'], currentMapperValues);\n        }\n\n        return mapper;\n      })\n    );\n  };\n\n  const handleCancel = (mapperId): void => {\n    setFieldValue(\n      'mappers',\n      reject<Mapper>(\n        (mapper) => equals(mapper.id, mapperId) && equals(mapper.adding, true),\n        values.mappers\n      ).map((mapper) => {\n        if (equals(mapper.id, mapperId) && mapper.editing) {\n          return omit(['editing', 'adding'], mapper);\n        }\n\n        return mapper;\n      })\n    );\n  };\n\n  const handleDelete = (mapperId): void => {\n    setFieldValue(\n      'mappers',\n      values.mappers.filter((mapper) => mapper.id !== mapperId)\n    );\n  };\n\n  useEffect(() => {\n    if (values.providerId > 0) {\n      sendRequest(values.providerId).then((newSources) => {\n        setSources(newSources);\n      });\n    }\n  }, [values.providerId]);\n\n  const displayPreview = and(\n    equals(displayMappersOnly, false),\n    !isNil(values.providerId)\n  );\n\n  return (\n    <div\n      className={\n        edit || displayMappersOnly\n          ? classes.mappersContainer\n          : classes.mappersStep\n      }\n    >\n      <div className={classes.mappersArea}>\n        {isNil(sources) || sending ? (\n          <div className={classes.loadingMappersContainer}>\n            {[...Array(5).keys()].map((id) => (\n              <Skeleton\n                animation=\"wave\"\n                className={classes.skeletonMapper}\n                height={theme.spacing(4)}\n                key={`${id}`}\n                variant=\"rectangular\"\n              />\n            ))}\n          </div>\n        ) : (\n          <MappersListing\n            displayMappersOnly={displayMappersOnly}\n            edit={edit}\n            errors={errors}\n            mappers={values.mappers}\n            sources={sources}\n            onAdd={handleAdd}\n            onCancel={handleCancel}\n            onDelete={handleDelete}\n            onDragEnd={handleDragEnd}\n            onDuplicate={handleDuplicate}\n            onEdit={handleEdit}\n            onSave={handleSave}\n          />\n        )}\n      </div>\n      {displayPreview && (\n        <div className={classes.previewArea}>\n          <Preview\n            credentialId={values.credentials?.id}\n            disableNextOnSendingRequests={disableNextOnSendingRequests}\n            jobParameters={values.additionalParameters}\n            mappers={values.mappers}\n            providerId={values.providerId}\n            sendingAttributes={sending}\n          />\n        </div>\n      )}\n    </div>\n  );\n};\n\nconst MemoizedMappersForm = memo(\n  MappersForm,\n  (prevProps, nextProps): boolean =>\n    equals(prevProps.values.providerId, nextProps.values.providerId) &&\n    equals(\n      prevProps.errors.requiredAttributes,\n      nextProps.errors.requiredAttributes\n    ) &&\n    equals(\n      prevProps.errors.mapperMonitoringRequired,\n      nextProps.errors.mapperMonitoringRequired\n    ) &&\n    equals(prevProps.values.mappers, nextProps.values.mappers)\n);\n\nconst Mappers = (\n  props: Omit<MappersFormProps, 'errors' | 'setFieldValue' | 'values'>\n): JSX.Element => {\n  const { values, errors, setFieldValue } = useFormikContext<FormikValues>();\n\n  return (\n    <MemoizedMappersForm\n      {...props}\n      errors={errors}\n      setFieldValue={setFieldValue}\n      values={values}\n    />\n  );\n};\n\nexport default Mappers;\n","import { FormikErrors, FormikValues } from 'formik';\n\nimport {\n  labelMissingProperty,\n  labelMonitoringMapperRequired\n} from '../../translatedLabels';\nimport { MapperType, Translation } from '../models';\n\nconst validate =\n  (t: Translation) =>\n  (values: FormikValues): FormikErrors<FormikValues> => {\n    const { mappers } = values;\n    const errors: FormikErrors<FormikValues> = {};\n\n    const requiredProperties = {\n      alias: false,\n      ip: false,\n      name: false\n    };\n\n    mappers.forEach(({ type, parameters, editing }) => {\n      if (type === MapperType.property) {\n        const destination = parameters.destination?.replace('host.', '') || '';\n        if (Object.keys(requiredProperties).includes(destination)) {\n          requiredProperties[destination] = true;\n        }\n      }\n\n      if (editing) {\n        errors.editing = '';\n      }\n    });\n\n    const hasMonitoringMappers = mappers.some(\n      (mapper) => mapper.type === 'monitoring'\n    );\n\n    const missingAttributes = Object.entries(requiredProperties).reduce<\n      Array<string>\n    >((acc, [attribute, value]) => {\n      if (value === false) {\n        acc.push(attribute);\n      }\n\n      return acc;\n    }, []);\n\n    if (missingAttributes.length) {\n      errors.requiredAttributes = `${t(\n        labelMissingProperty\n      )}: ${missingAttributes.join(',')}`;\n    }\n\n    if (!hasMonitoringMappers) {\n      errors.mapperMonitoringRequired = t(labelMonitoringMapperRequired);\n    }\n\n    return errors;\n  };\n\nexport default validate;\n","import {\n  and,\n  equals,\n  includes,\n  isEmpty,\n  isNil,\n  join,\n  lte,\n  map,\n  omit,\n  prop,\n  reject,\n  type as typeOf\n} from 'ramda';\n\nimport { SelectEntry } from '@centreon/ui';\n\nimport {\n  AdditionalParameter,\n  AdditionalParameterToSend,\n  CustomSchedulingAPI,\n  CustomSchedulingForm,\n  CustomSchedulingType,\n  Mapper,\n  MapperType,\n  ParameterCondition,\n  Source,\n  SourceType\n} from '../models';\n\nconst isNotDefined = (value): boolean => isNil(value) || isEmpty(value);\n\ninterface FormatSourceProps {\n  mapperType: string;\n  source?: Array<Source> | string;\n}\n\nconst formatSource = ({\n  mapperType,\n  source\n}: FormatSourceProps): Array<Source> | undefined | string => {\n  if (isNil(source)) {\n    return source;\n  }\n  if (\n    includes(mapperType, [\n      MapperType.hostGroup,\n      MapperType.hostSeverity,\n      MapperType.hostCategory\n    ])\n  ) {\n    if (equals(typeOf(source), 'String')) {\n      return source;\n    }\n\n    return (source as Array<Source> | undefined)?.map(\n      ({ type, value, ...rest }) => ({\n        type,\n        value: includes(type, [\n          SourceType.hostGroup,\n          SourceType.hostSeverity,\n          SourceType.hostCategory\n        ])\n          ? { id: (value as SelectEntry).id }\n          : value,\n        ...omit(['id'], rest)\n      })\n    );\n  }\n\n  return map(omit(['id']), source as Array<Source>);\n};\n\nexport const formatMappers = (mappers: Array<Mapper>): Array<Mapper> =>\n  mappers.map((mapper) => {\n    const parameters = {\n      ...reject(\n        equals<unknown | undefined>(undefined),\n        prop('parameters', mapper) as {\n          conditions: Array<ParameterCondition>;\n          destination?: string;\n          is_password?: boolean;\n          source?: Array<Source> | string;\n          type?: string;\n          value?: string;\n        }\n      ),\n      conditions: mapper.parameters.conditions ?? []\n    };\n\n    return {\n      parameters: {\n        ...parameters,\n        source: formatSource({\n          mapperType: mapper.type as string,\n          source: mapper.parameters.source\n        })\n      },\n      type: mapper.type\n    };\n  });\n\nexport const formatJobParameters = (\n  jobParameters: Array<AdditionalParameter>\n): Array<AdditionalParameterToSend> =>\n  jobParameters.map(({ name, value }) => ({\n    name,\n    value\n  }));\n\nexport const formatScheduledExecution = (\n  scheduledExecutionForm: CustomSchedulingForm | null\n): CustomSchedulingAPI | null => {\n  if (isNil(scheduledExecutionForm)) {\n    return null;\n  }\n  const formattedScheduledExecution: CustomSchedulingAPI = {};\n\n  if (equals(scheduledExecutionForm?.type, CustomSchedulingType.year)) {\n    formattedScheduledExecution.months = {\n      values: isNotDefined(scheduledExecutionForm?.months)\n        ? '*'\n        : join(',', scheduledExecutionForm?.months as Array<number>)\n    };\n  }\n  if (lte(scheduledExecutionForm?.type as number, CustomSchedulingType.month)) {\n    formattedScheduledExecution.days = {\n      values: isNotDefined(scheduledExecutionForm?.daysOfMonth)\n        ? '*'\n        : join(',', scheduledExecutionForm?.daysOfMonth as Array<number>)\n    };\n  }\n  if (\n    and(\n      equals(scheduledExecutionForm?.type, CustomSchedulingType.week),\n      !isNotDefined(scheduledExecutionForm?.daysOfWeek)\n    )\n  ) {\n    formattedScheduledExecution.weekdays = join(\n      ',',\n      scheduledExecutionForm?.daysOfWeek as Array<number>\n    );\n  }\n  if (lte(scheduledExecutionForm?.type as number, CustomSchedulingType.day)) {\n    formattedScheduledExecution.hours = {\n      values: `${\n        scheduledExecutionForm?.time?.$d\n          ? scheduledExecutionForm?.time?.$d?.getHours()\n          : scheduledExecutionForm?.time?.getHours()\n      }`\n    };\n    formattedScheduledExecution.minutes = {\n      values: `${\n        scheduledExecutionForm?.time?.$d\n          ? scheduledExecutionForm?.time?.$d?.getMinutes()\n          : scheduledExecutionForm?.time?.getMinutes()\n      }`\n    };\n  }\n  if (equals(scheduledExecutionForm?.type, CustomSchedulingType.hour)) {\n    formattedScheduledExecution.hours = {\n      every: scheduledExecutionForm?.hour || undefined,\n      values: '*'\n    };\n    formattedScheduledExecution.minutes = {\n      values: `${scheduledExecutionForm?.minute}`\n    };\n  }\n  if (equals(scheduledExecutionForm?.type, CustomSchedulingType.minute)) {\n    formattedScheduledExecution.minutes = {\n      every: scheduledExecutionForm?.minute || undefined,\n      values: '*'\n    };\n  }\n\n  return formattedScheduledExecution;\n};\n","import { JsonDecoder } from 'ts.data.json';\n\nimport { buildListingDecoder } from '@centreon/ui';\n\nimport {\n  AdditionalParameter,\n  Attribute,\n  AttributeType,\n  Credential,\n  CredentialParameter,\n  Host,\n  HostSimulation,\n  HostTemplate,\n  IndexSourceParameterCondition,\n  MapperExample,\n  MapperParameters,\n  MonitoringServer,\n  ParameterCondition,\n  Provider,\n  ProviderAttributes,\n  ProviderEntity,\n  Source,\n  SourceParameterCondition,\n  SourceType\n} from '../models';\n\nexport const hostTemplateDecoder = JsonDecoder.object<HostTemplate>(\n  {\n    id: JsonDecoder.number,\n    name: JsonDecoder.string\n  },\n  'HostTemplate'\n);\n\nexport const hostTemplateListingDecoder = buildListingDecoder<HostTemplate>({\n  entityDecoder: hostTemplateDecoder,\n  entityDecoderName: 'Host templates',\n  listingDecoderName: 'Listing hosts'\n});\n\nexport const listProviderParametersDecoder = JsonDecoder.array(\n  JsonDecoder.object<CredentialParameter>(\n    {\n      description: JsonDecoder.nullable(JsonDecoder.string),\n      is_hidden: JsonDecoder.boolean,\n      is_locked: JsonDecoder.boolean,\n      is_mandatory: JsonDecoder.boolean,\n      is_password: JsonDecoder.optional(JsonDecoder.boolean),\n      name: JsonDecoder.string,\n      value: JsonDecoder.nullable(JsonDecoder.string)\n    },\n    'CredentialParameter'\n  ),\n  'CredentialParameters'\n);\n\nexport const credentialDecoder = JsonDecoder.object<Credential>(\n  {\n    id: JsonDecoder.number,\n    name: JsonDecoder.string,\n    parameters: listProviderParametersDecoder,\n    type_id: JsonDecoder.number\n  },\n  'Credential'\n);\n\nexport const listCredentialsDecoder = buildListingDecoder<Credential>({\n  entityDecoder: credentialDecoder,\n  entityDecoderName: 'Credentials',\n  listingDecoderName: 'ListCredentials'\n});\n\ninterface Entry {\n  id: number;\n  name: string | number | null;\n}\n\nexport const sourceValueDecoder = JsonDecoder.object<Entry>(\n  {\n    id: JsonDecoder.number,\n    name: JsonDecoder.nullable(\n      JsonDecoder.oneOf<string | number>(\n        [JsonDecoder.string, JsonDecoder.number],\n        'string | number'\n      )\n    )\n  },\n  'Source Type'\n);\n\nconst sourceDecoder = JsonDecoder.object<Source>(\n  {\n    id: JsonDecoder.optional(JsonDecoder.string),\n    index: JsonDecoder.optional(\n      JsonDecoder.object(\n        {\n          key: JsonDecoder.nullable(\n            JsonDecoder.oneOf<number | string>(\n              [JsonDecoder.number, JsonDecoder.string],\n              'Source Index Key'\n            )\n          ),\n          value: JsonDecoder.string\n        },\n        'Source Index'\n      )\n    ),\n    property: JsonDecoder.optional(JsonDecoder.string),\n    type: JsonDecoder.enumeration<SourceType>(SourceType, 'SourceType'),\n    value: JsonDecoder.oneOf<string | Entry>(\n      [JsonDecoder.string, sourceValueDecoder],\n      'string | SelectEntry'\n    )\n  },\n  'Source'\n);\n\nconst sourceParameterCondition = JsonDecoder.object<SourceParameterCondition>(\n  {\n    index: JsonDecoder.nullable(\n      JsonDecoder.object<IndexSourceParameterCondition>(\n        {\n          key: JsonDecoder.nullable(\n            JsonDecoder.oneOf<string | number>(\n              [JsonDecoder.number, JsonDecoder.string],\n              'Key Index Source Parameter Condition'\n            )\n          ),\n          value: JsonDecoder.optional(JsonDecoder.string)\n        },\n        'Index Source Parameter Condition'\n      )\n    ),\n    name: JsonDecoder.string,\n    property: JsonDecoder.nullable(JsonDecoder.string)\n  },\n  'Source Parameter Condition'\n);\n\nexport const mapperParametersExampleDecoder =\n  JsonDecoder.object<MapperParameters>(\n    {\n      conditions: JsonDecoder.array(\n        JsonDecoder.object<ParameterCondition>(\n          {\n            operator: JsonDecoder.string,\n            source: sourceParameterCondition,\n            value: JsonDecoder.optional(JsonDecoder.string)\n          },\n          'Parameter Condition'\n        ),\n        'Parameter Conditions'\n      ),\n      destination: JsonDecoder.optional(JsonDecoder.string),\n      is_password: JsonDecoder.optional(JsonDecoder.boolean),\n      source: JsonDecoder.optional(\n        JsonDecoder.oneOf<string | Array<Source>>(\n          [JsonDecoder.string, JsonDecoder.array(sourceDecoder, 'Sources')],\n          'Source value'\n        )\n      ),\n      type: JsonDecoder.optional(JsonDecoder.string),\n      value: JsonDecoder.optional(JsonDecoder.string)\n    },\n    'Mapper Parameters Example'\n  );\n\nexport const mapperParametersDecoder = JsonDecoder.object<MapperParameters>(\n  {\n    conditions: JsonDecoder.array(\n      JsonDecoder.object<ParameterCondition>(\n        {\n          operator: JsonDecoder.string,\n          source: sourceParameterCondition,\n          value: JsonDecoder.optional(JsonDecoder.string)\n        },\n        'Parameter Condition'\n      ),\n      'Parameter Conditions'\n    ),\n    destination: JsonDecoder.optional(JsonDecoder.string),\n    is_password: JsonDecoder.optional(JsonDecoder.boolean),\n    source: JsonDecoder.optional(JsonDecoder.array(sourceDecoder, 'Sources')),\n    type: JsonDecoder.optional(JsonDecoder.string),\n    value: JsonDecoder.optional(JsonDecoder.string)\n  },\n  'Mapper Parameters'\n);\n\nexport const mapperDecoder = JsonDecoder.object<MapperExample>(\n  {\n    parameters: mapperParametersDecoder,\n    type: JsonDecoder.string\n  },\n  'Mapper'\n);\n\nexport const mapperExampleDecoder = JsonDecoder.object<MapperExample>(\n  {\n    parameters: mapperParametersExampleDecoder,\n    type: JsonDecoder.string\n  },\n  'Mapper'\n);\n\nexport const listAdditionalParameters = JsonDecoder.array(\n  JsonDecoder.object<AdditionalParameter>(\n    {\n      description: JsonDecoder.string,\n      group: JsonDecoder.string,\n      isHidden: JsonDecoder.boolean,\n      isLocked: JsonDecoder.boolean,\n      isMandatory: JsonDecoder.boolean,\n      name: JsonDecoder.string,\n      value: JsonDecoder.nullable(\n        JsonDecoder.oneOf<string | number>(\n          [JsonDecoder.number, JsonDecoder.string],\n          'string | number'\n        )\n      )\n    },\n    'Additional Parameter',\n    {\n      isHidden: 'is_hidden',\n      isLocked: 'is_locked',\n      isMandatory: 'is_mandatory'\n    }\n  ),\n  'List Additional Parameters,'\n);\n\nexport const providerEntityDecoder = JsonDecoder.object<ProviderEntity>(\n  {\n    id: JsonDecoder.number,\n    name: JsonDecoder.string\n  },\n  'Provider Type'\n);\n\nconst providerDecoder = JsonDecoder.object<Provider>(\n  {\n    description: JsonDecoder.string,\n    hostTemplate: providerEntityDecoder,\n    icon: JsonDecoder.string,\n    id: JsonDecoder.number,\n    isCompatible: JsonDecoder.boolean,\n    isNeedProxy: JsonDecoder.boolean,\n    jobParametersTemplate: listAdditionalParameters,\n    mappersExamples: JsonDecoder.array(mapperExampleDecoder, 'Mappers Example'),\n    name: JsonDecoder.string,\n    pluginPack: providerEntityDecoder,\n    type: providerEntityDecoder\n  },\n  'Provider',\n  {\n    hostTemplate: 'host_template',\n    isCompatible: 'is_compatible',\n    isNeedProxy: 'is_need_proxy',\n    jobParametersTemplate: 'job_parameters_template',\n    mappersExamples: 'mappers_examples',\n    pluginPack: 'plugin_pack'\n  }\n);\n\nexport const listProvidersDecoder = buildListingDecoder<Provider>({\n  entityDecoder: providerDecoder,\n  entityDecoderName: 'Providers',\n  listingDecoderName: 'ListProviders'\n});\n\nconst monitoringServerDecoder = JsonDecoder.object<MonitoringServer>(\n  {\n    id: JsonDecoder.number,\n    name: JsonDecoder.string\n  },\n  'Monitoring Server'\n);\n\nexport const listMonitoringServersDecoder =\n  buildListingDecoder<MonitoringServer>({\n    entityDecoder: monitoringServerDecoder,\n    entityDecoderName: 'MonitoringServers',\n    listingDecoderName: 'ListMonitoringServers'\n  });\n\nconst attributeDecoder = JsonDecoder.object<Attribute>(\n  {\n    name: JsonDecoder.string,\n    properties: JsonDecoder.optional(\n      JsonDecoder.nullable(\n        JsonDecoder.array(JsonDecoder.string, 'Attribute properties')\n      )\n    ),\n    type: JsonDecoder.enumeration(AttributeType, 'Attribute Type')\n  },\n  'Attribute'\n);\n\nexport const listProviderAttributesDecoder =\n  JsonDecoder.object<ProviderAttributes>(\n    {\n      attributes: JsonDecoder.array(attributeDecoder, 'Provider Attributes'),\n      credentials: JsonDecoder.array(attributeDecoder, 'Provider Credentials'),\n      parameters: JsonDecoder.array(attributeDecoder, 'Provider Parameters')\n    },\n    'ListProviderAttributes'\n  );\n\nexport const listHostsSimulationDecoder = JsonDecoder.array(\n  JsonDecoder.object<HostSimulation>(\n    {\n      host: JsonDecoder.object<Host>(\n        {\n          alias: JsonDecoder.nullable(JsonDecoder.string),\n          id: JsonDecoder.nullable(JsonDecoder.number),\n          ipAddress: JsonDecoder.nullable(JsonDecoder.string),\n          name: JsonDecoder.nullable(JsonDecoder.string)\n        },\n        'Host',\n        {\n          ipAddress: 'ip_address'\n        }\n      )\n    },\n    'HostSimulation'\n  ),\n  'ListHostsSimulation'\n);\n","import { baseEndpoint } from '../../api/endpoint';\n\nconst listHostTemplatesEndpoint = `${baseEndpoint}/configuration/hosts/templates`;\nconst listMonitoringServersEndpoint = `${baseEndpoint}/configuration/monitoring-servers`;\nconst listProviderParametersEndpoint = (providerTypeId: number): string =>\n  `${baseEndpoint}/auto-discovery/provider-types/${providerTypeId}/credentials-templates`;\nconst listProvidersEndpoint = `${baseEndpoint}/auto-discovery/providers`;\nconst listProvidersAttributesEndpoint = (providerId: number): string =>\n  `${listProvidersEndpoint}/${providerId}/attributes`;\nconst readProxyEndpoint = `${baseEndpoint}/configuration/proxy`;\nconst providerTypesCredentialsEndpoint = (providerTypeId: number): string =>\n  `${baseEndpoint}/auto-discovery/provider-types/${providerTypeId}/credentials`;\nconst updateCredentialsEndpoint = (credentialsId: number): string =>\n  `${baseEndpoint}/auto-discovery/credentials/${credentialsId}`;\nconst simulateHostsEndpoint = `${baseEndpoint}/auto-discovery/mappers/simulate`;\nconst discoveryJobsEndpoint = `${baseEndpoint}/auto-discovery/jobs`;\nconst listHostGroupsEndpoint = `${baseEndpoint}/configuration/hosts/groups`;\nconst listHostSeveritiesEndpoint = `${baseEndpoint}/configuration/hosts/severities`;\nconst listHostCategoriesEndpoint = `${baseEndpoint}/configuration/hosts/categories`;\n\nexport {\n  listHostTemplatesEndpoint,\n  listMonitoringServersEndpoint,\n  listProviderParametersEndpoint,\n  readProxyEndpoint,\n  providerTypesCredentialsEndpoint,\n  simulateHostsEndpoint,\n  updateCredentialsEndpoint,\n  discoveryJobsEndpoint,\n  listProvidersAttributesEndpoint,\n  listProvidersEndpoint,\n  listHostGroupsEndpoint,\n  listHostSeveritiesEndpoint,\n  listHostCategoriesEndpoint\n};\n","import { CancelToken } from 'axios';\nimport { add, equals, gt, isNil, reduce, reject } from 'ramda';\n\nimport {\n  BuildListingEndpointParameters,\n  buildListingEndpoint,\n  getData,\n  postData,\n  putData\n} from '@centreon/ui';\n\nimport { Proxy as ProxyModel } from '../../PanelEdit/models';\nimport {\n  AdditionalParameter,\n  Credential,\n  CredentialParameter,\n  CustomSchedulingForm,\n  HostSimulation,\n  HostTemplateListing,\n  ListCredentials,\n  Mapper,\n  MonitoringServerListing,\n  PlanExecutionValue,\n  PolicyValue,\n  ProviderAttributes,\n  ProviderListing\n} from '../models';\n\nimport {\n  formatJobParameters,\n  formatMappers,\n  formatScheduledExecution\n} from './adapters';\nimport {\n  discoveryJobsEndpoint,\n  listHostTemplatesEndpoint,\n  listMonitoringServersEndpoint,\n  listProviderParametersEndpoint,\n  listProvidersAttributesEndpoint,\n  listProvidersEndpoint,\n  providerTypesCredentialsEndpoint,\n  readProxyEndpoint,\n  simulateHostsEndpoint,\n  updateCredentialsEndpoint\n} from './endpoint';\n\nconst listHostTemplates =\n  (cancelToken: CancelToken) =>\n  (\n    parameters: BuildListingEndpointParameters\n  ): Promise<HostTemplateListing> => {\n    const endpoint = buildListingEndpoint({\n      baseEndpoint: listHostTemplatesEndpoint,\n      ...parameters\n    });\n\n    return getData<HostTemplateListing>(cancelToken)({ endpoint });\n  };\n\ninterface ListCredentialsParams {\n  page: number;\n  providerTypeId: number;\n  search: string;\n}\n\nconst listCredentials =\n  (cancelToken: CancelToken) =>\n  ({\n    providerTypeId,\n    page,\n    search = ''\n  }: ListCredentialsParams): Promise<ListCredentials> => {\n    const endpoint = providerTypesCredentialsEndpoint(providerTypeId);\n    const searchParam = search && `&search=${JSON.stringify(search)}`;\n\n    return getData<ListCredentials>(cancelToken)({\n      endpoint: `${endpoint}?page=${page}${searchParam}`\n    });\n  };\n\nconst listMonitoringServers =\n  (cancelToken: CancelToken) =>\n  ({\n    parameters,\n    customQueryParameters\n  }: BuildListingEndpointParameters): Promise<MonitoringServerListing> => {\n    const endpoint = buildListingEndpoint({\n      baseEndpoint: listMonitoringServersEndpoint,\n      customQueryParameters,\n      parameters\n    });\n\n    return getData<MonitoringServerListing>(cancelToken)({ endpoint });\n  };\n\nconst listProvidersAttributes =\n  (cancelToken: CancelToken) =>\n  (providerId: number): Promise<ProviderAttributes> =>\n    getData<ProviderAttributes>(cancelToken)({\n      endpoint: listProvidersAttributesEndpoint(providerId)\n    });\n\ninterface ListPreviewHosts {\n  credentialId?: number | null;\n  jobParameters: Array<AdditionalParameter>;\n  mappers: Array<Mapper>;\n  providerId: number;\n}\n\nconst listPreviewHosts =\n  (cancelToken: CancelToken) =>\n  ({\n    mappers,\n    providerId,\n    credentialId,\n    jobParameters\n  }: ListPreviewHosts): Promise<Array<HostSimulation>> => {\n    const mappersToPost = formatMappers(mappers);\n    const jobParametersToPost = formatJobParameters(jobParameters);\n\n    return postData<unknown, Array<HostSimulation>>(cancelToken)({\n      data: {\n        credential_id: credentialId || null,\n        job_parameters: jobParametersToPost,\n        mappers: mappersToPost,\n        provider_id: providerId\n      },\n      endpoint: simulateHostsEndpoint\n    });\n  };\n\nconst listProviderParameters =\n  (cancelToken: CancelToken) =>\n  (providerTypeId: number): Promise<Array<CredentialParameter>> =>\n    getData<Array<CredentialParameter>>(cancelToken)({\n      endpoint: listProviderParametersEndpoint(providerTypeId)\n    });\n\nconst listProviders =\n  (cancelToken: CancelToken) =>\n  (params: BuildListingEndpointParameters): Promise<ProviderListing> => {\n    const endpoint = buildListingEndpoint({\n      baseEndpoint: listProvidersEndpoint,\n      ...params\n    });\n\n    return getData<ProviderListing>(cancelToken)({ endpoint });\n  };\n\nconst readProxy = (cancelToken: CancelToken) => (): Promise<ProxyModel> =>\n  getData<ProxyModel>(cancelToken)({ endpoint: readProxyEndpoint });\n\ninterface AddOrUpdateCredentials {\n  credentialsId: number;\n  data: Credential;\n  previousCredentials?: Credential | null;\n  providerTypeId: number;\n}\n\nconst addOrUpdateCredentials =\n  (cancelToken: CancelToken) =>\n  ({\n    providerTypeId,\n    data,\n    credentialsId,\n    previousCredentials\n  }: AddOrUpdateCredentials): Promise<unknown> => {\n    const dataToPost = {\n      name: data.name,\n      parameters: data.parameters\n        .map(({ value, name }, index) => {\n          const checkValueNotChanged =\n            previousCredentials &&\n            value === previousCredentials.parameters[index].value;\n          if (checkValueNotChanged) {\n            return null;\n          }\n\n          return {\n            name,\n            value\n          };\n        })\n        .filter((parameter) => parameter)\n    };\n\n    if (!isNil(credentialsId)) {\n      return putData(cancelToken)({\n        data: dataToPost,\n        endpoint: updateCredentialsEndpoint(credentialsId)\n      });\n    }\n\n    return postData(cancelToken)({\n      data: dataToPost,\n      endpoint: providerTypesCredentialsEndpoint(providerTypeId)\n    });\n  };\n\ninterface AddDiscoveryJob {\n  alias: string;\n  analysisMode: number;\n  credentialId?: number | null;\n  executionMode: number;\n  jobParameters: Array<AdditionalParameter>;\n  mappers: Array<Mapper>;\n  monitoringServerId: number;\n  providerId: number;\n  proxy: ProxyModel | null;\n  saveMode: Array<number> | null;\n  scheduling: CustomSchedulingForm | null;\n}\n\nconst addDiscoveryJob =\n  (cancelToken: CancelToken) =>\n  ({\n    credentialId,\n    providerId,\n    monitoringServerId,\n    proxy,\n    mappers,\n    jobParameters,\n    executionMode,\n    analysisMode,\n    scheduling,\n    alias,\n    saveMode\n  }: AddDiscoveryJob): Promise<unknown> => {\n    const mappersToPost = formatMappers(mappers);\n    const jobParametersToPost = formatJobParameters(jobParameters);\n\n    const data = {\n      alias,\n      analysis_mode: analysisMode,\n      credential_id: credentialId || null,\n      execution_mode: executionMode,\n      job_parameters: jobParametersToPost,\n      mappers: mappersToPost,\n      monitoring_server_id: monitoringServerId,\n      provider_id: providerId,\n      proxy,\n      save_mode: equals(analysisMode, PolicyValue.automatic)\n        ? reduce<number, number>(add, 0, saveMode ?? [])\n        : undefined,\n      scheduling: gt(executionMode, PlanExecutionValue.executeImmediately)\n        ? formatScheduledExecution(scheduling)\n        : undefined\n    };\n\n    return postData(cancelToken)({\n      data: reject(equals<unknown | null | undefined>(undefined), data),\n      endpoint: discoveryJobsEndpoint\n    });\n  };\n\nexport {\n  listHostTemplates,\n  listMonitoringServers,\n  listPreviewHosts,\n  listProviderParameters,\n  listProviders,\n  readProxy,\n  listCredentials,\n  addOrUpdateCredentials,\n  addDiscoveryJob,\n  listProvidersAttributes\n};\n","import { path, all, equals, map } from 'ramda';\n\ninterface MemoizedFormComponentParameters {\n  fieldPath: Array<string>;\n  nextProps;\n  prevProps;\n}\n\nconst memoPropsFormComponent = ({\n  prevProps,\n  nextProps,\n  fieldPath\n}: MemoizedFormComponentParameters): boolean => {\n  const getMemoProps = (object): Array<unknown> | undefined =>\n    path(fieldPath, object);\n  const formikProps = ['values', 'errors', 'touched'];\n\n  return all(\n    equals(true),\n    map(\n      (prop) =>\n        equals(getMemoProps(prevProps[prop]), getMemoProps(nextProps[prop])),\n      formikProps\n    )\n  );\n};\n\nexport default memoPropsFormComponent;\n","import { ChangeEvent, FocusEvent } from 'react';\n\nimport {\n  FormikErrors,\n  FormikHandlers,\n  FormikHelpers,\n  FormikTouched,\n  FormikValues\n} from 'formik';\n\nimport { ListingModel, SelectEntry } from '@centreon/ui';\n\nexport interface FormikPropsComponent {\n  errors: FormikErrors<FormikValues>;\n  handleBlur?: (e: FocusEvent) => void;\n  handleChange: (e: ChangeEvent) => void;\n  setFieldValue?: (\n    field: string,\n    value: unknown,\n    shouldValidate?: boolean\n  ) => void;\n  touched?: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nexport interface PolicyProps {\n  edit?: boolean;\n}\n\nexport interface PlanExecutionProps {\n  customSchedulingBaseValue?: number;\n  edit?: boolean;\n}\n\nexport interface FormProps {\n  errors: FormikErrors<FormikValues>;\n  handleChange: (e) => void;\n  setFieldValue: (field: string, value, shouldValidate?: boolean) => void;\n  setValues?: (values: FormikValues) => void;\n  values: FormikValues;\n}\n\nexport enum PolicyValue {\n  manual = 0,\n  automatic = 1\n}\n\nexport enum SaveModeValue {\n  addHosts = 1,\n  disableHostsInConfigurationAndExcludedByMappingRules = 2,\n  enableDisabledHosts = 4,\n  exportAndReloadPollersConfiguration = 8,\n  allowToUpdateExistingHosts = 16,\n  doNotApplyTheDefaultTemplate = 32\n}\n\nexport enum PlanExecutionValue {\n  executeImmediately = 0,\n  customScheduling = 1,\n  pause = 2\n}\n\nexport enum CustomSchedulingType {\n  year = 0,\n  month = 1,\n  week = 2,\n  day = 3,\n  hour = 4,\n  minute = 5\n}\n\nexport interface RadioButton {\n  label: string;\n  value: number;\n}\n\nexport interface HostTemplate {\n  id: number;\n  name: string;\n}\n\nexport interface CredentialParameter {\n  description: string | null;\n  is_hidden: boolean;\n  is_locked: boolean;\n  is_mandatory: boolean;\n  is_password?: boolean;\n  name: string;\n  value: string | null;\n}\n\nexport interface Credential {\n  id: number;\n  name: string;\n  parameters: Array<CredentialParameter>;\n  type_id: number;\n}\n\nexport type ListCredentials = ListingModel<Credential>;\n\nexport interface IndexSourceParameterCondition {\n  key: string | number | null;\n  value?: string;\n}\n\nexport interface SourceParameterCondition {\n  index: IndexSourceParameterCondition | null;\n  name: string;\n  property: string | null;\n}\n\nexport interface ParameterCondition {\n  operator;\n  source;\n  value?;\n}\n\nexport enum SourceType {\n  discovery = 'discovery',\n  hostCategory = 'host_category',\n  hostGroup = 'host_group',\n  hostSeverity = 'host_severity',\n  integer = 'integer',\n  string = 'string'\n}\n\nexport enum MapperType {\n  exclusion = 'exclusion',\n  hostCategory = 'host_category',\n  hostGroup = 'host_group',\n  hostSeverity = 'host_severity',\n  inclusion = 'inclusion',\n  macro = 'macro',\n  monitoring = 'monitoring',\n  property = 'property',\n  template = 'template'\n}\n\nexport interface Source {\n  id?: string;\n  index?: IndexSourceParameterCondition;\n  property?: string;\n  type: SourceType;\n  value: string | SelectEntry | { id: number | string };\n}\n\nexport interface MapperParameters {\n  conditions: Array<ParameterCondition>;\n  destination?: string;\n  is_password?: boolean;\n  source?: Array<Source> | string;\n  type?: string;\n  value?: string;\n}\n\nexport interface Mapper {\n  adding?: boolean;\n  editing?: boolean;\n  id?: number;\n  parameters: MapperParameters;\n  type: string | null;\n}\n\nexport interface MapperExample {\n  parameters: MapperParameters;\n  type: string;\n}\n\nexport interface ProviderEntity {\n  id: number;\n  name: string;\n}\n\nexport interface Provider {\n  description: string;\n  hostTemplate: ProviderEntity;\n  icon: string;\n  id: number;\n  isCompatible: boolean;\n  isNeedProxy: boolean;\n  jobParametersTemplate: Array<AdditionalParameter>;\n  mappersExamples: Array<MapperExample>;\n  name: string;\n  pluginPack: ProviderEntity;\n  type: ProviderEntity;\n}\n\nexport type ProviderListing = ListingModel<Provider>;\n\nexport type MonitoringServerListing = ListingModel<MonitoringServer>;\n\nexport type HostTemplateListing = ListingModel<HostTemplate>;\n\nexport interface RetrievedProvider {\n  description: string;\n  host_template: ProviderEntity;\n  icon: string;\n  id: number;\n  is_compatible: boolean;\n  is_need_proxy: boolean;\n  job_parameters_template: Array<AdditionalParameter>;\n  mappers_examples: Array<Mapper>;\n  name: string;\n  plugin_pack: ProviderEntity;\n  type: ProviderEntity;\n}\n\nexport interface AdditionalParameter {\n  description: string;\n  group: string;\n  isHidden: boolean;\n  isLocked: boolean;\n  isMandatory: boolean;\n  name: string;\n  value: string | number | null;\n}\n\nexport interface AdditionalParameterToSend {\n  name: string;\n  value: string | number | null;\n}\n\nexport interface MonitoringServer {\n  id: number;\n  name: string;\n}\n\nexport enum AttributeType {\n  array = 'array',\n  integer = 'integer',\n  string = 'string'\n}\n\nexport interface Attribute {\n  name: string;\n  properties?: Array<string> | null;\n  type: AttributeType;\n}\n\nexport interface ProviderAttributes {\n  attributes: Array<Attribute>;\n  credentials: Array<Attribute>;\n  parameters: Array<Attribute>;\n}\n\nexport interface Host {\n  alias: string | null;\n  id: number | null;\n  ipAddress: string | null;\n  name: string | null;\n}\n\nexport interface HostSimulation {\n  host: Host;\n}\n\nexport interface CustomSchedulingForm {\n  daysOfMonth?: Array<number> | null;\n  daysOfWeek?: Array<number> | null;\n  hour?: number | null;\n  minute?: number | null;\n  months?: Array<number> | null;\n  time?: Date | null;\n  type?: number;\n}\n\nexport interface CronObject {\n  every?: number;\n  values: string;\n}\n\nexport interface CustomSchedulingAPI {\n  days?: CronObject;\n  hours?: CronObject;\n  minutes?: CronObject;\n  months?: CronObject;\n  weekdays?: string;\n}\n\nexport interface SourceMapperValidationSchema {\n  parameters;\n}\n\nexport interface MapperValidationSchema {\n  parameters;\n}\n\nexport interface InclusionExclusionValidationSchema {\n  parameters;\n}\n\nexport type Translation = (label: string) => string;\n\nexport interface MappersFormValues {\n  mappers: Array<Mapper>;\n  providerId: number;\n}\n\nexport interface Rule {\n  Form: (props) => JSX.Element;\n  Preview: (props) => JSX.Element;\n  initialValues?: Mapper;\n  order: number;\n  title: string;\n  type: MapperType;\n  validationSchema: (\n    t: Translation\n  ) =>\n    | (SourceMapperValidationSchema | MapperValidationSchema)\n    | InclusionExclusionValidationSchema;\n}\n\nexport interface MapperRules {\n  exclusion: Rule;\n  hostCategory: Rule;\n  hostGroup: Rule;\n  hostSeverity: Rule;\n  inclusion: Rule;\n  macro: Rule;\n  monitoring: Rule;\n  property: Rule;\n  template: Rule;\n}\n\nexport interface MapperFormProps\n  extends Pick<FormikHandlers, 'handleChange' | 'handleBlur'>,\n    Pick<FormikHelpers<FormikValues>, 'setFieldTouched' | 'setFieldValue'> {\n  errors: FormikErrors<FormikValues>;\n  sources: ProviderAttributes;\n  touched: FormikTouched<FormikValues>;\n  values: FormikValues;\n}\n\nexport type GetSource =\n  | boolean\n  | Array<Source>\n  | string\n  | null\n  | undefined\n  | FormikErrors<FormikValues>;\n\nexport interface PreviewMapperProps {\n  mapper: Mapper;\n}\n","import { useEffect, useState } from 'react';\n\ninterface Props {\n  defaultParams?;\n  onParamChange;\n}\n\nexport interface ListingParams {\n  changeLimit;\n  currentPage;\n  getEndpointParams;\n  loaded;\n  paginate;\n  sort;\n  sortf;\n  sorto;\n  startLoading;\n  stopLoading;\n}\n\nexport interface Sort {\n  sortField: string;\n  sortOrder: string;\n}\n\nexport type SortO = 'desc' | 'asc' | undefined;\n\ninterface EndpointParams {\n  limit: number;\n  page: number;\n  sortf: string;\n  sorto: string;\n}\n\nconst useTableParams = ({\n  defaultParams = {},\n  onParamChange\n}: Props): ListingParams => {\n  const [limit, setLimit] = useState(defaultParams.limit || 30);\n  const [page, setPage] = useState(defaultParams.page || 0);\n  const [sortf, setSortf] = useState(defaultParams.sortf);\n  const [sorto, setSorto] = useState(defaultParams.sorto);\n  const [loaded, setLoaded] = useState(false);\n\n  const getEndpointParams = (): EndpointParams => ({\n    limit,\n    page,\n    sortf,\n    sorto\n  });\n\n  useEffect(() => {\n    onParamChange(getEndpointParams());\n  }, [limit, page, sortf, sorto]);\n\n  const changeLimit = (updatedLimit): void => {\n    setLimit(Number.parseInt(updatedLimit, 10));\n  };\n\n  const paginate = (pageNumber: number): void => {\n    setPage(pageNumber);\n  };\n\n  const sort = ({ sortOrder, sortField }: Sort): void => {\n    setSortf(sortField);\n    setSorto(sortOrder);\n  };\n\n  const startLoading = (): void => {\n    setLoaded(false);\n  };\n\n  const stopLoading = (): void => {\n    setLoaded(true);\n  };\n\n  return {\n    changeLimit,\n    currentPage: page,\n    getEndpointParams,\n    loaded,\n    paginate,\n    sort,\n    sortf,\n    sorto,\n    startLoading,\n    stopLoading\n  };\n};\n\nexport default useTableParams;\n","import { JsonDecoder } from 'ts.data.json';\n\nimport {\n  credentialDecoder,\n  listAdditionalParameters,\n  mapperParametersDecoder,\n  providerEntityDecoder\n} from '../../JobWizard/api/decoders';\nimport { CronObject, CustomSchedulingAPI } from '../../JobWizard/models';\nimport {\n  JobProvider,\n  MapperToApply,\n  MonitoringServer,\n  Proxy as ProxyModel,\n  RetrievedJobDetails\n} from '../models';\n\nexport const mappersToApplyDecoder = JsonDecoder.array(\n  JsonDecoder.object<MapperToApply>(\n    {\n      order: JsonDecoder.number,\n      parameters: mapperParametersDecoder,\n      type: JsonDecoder.string\n    },\n    'Mapper'\n  ),\n  'Mappers'\n);\n\nexport const proxyDecoder = JsonDecoder.object<ProxyModel>(\n  {\n    password: JsonDecoder.nullable(JsonDecoder.string),\n    port: JsonDecoder.nullable(JsonDecoder.number),\n    url: JsonDecoder.nullable(JsonDecoder.string),\n    user: JsonDecoder.nullable(JsonDecoder.string)\n  },\n  'Proxy'\n);\n\nconst jobProviderDecoder = JsonDecoder.object<JobProvider>(\n  {\n    hostTemplate: providerEntityDecoder,\n    id: JsonDecoder.number,\n    isNeedProxy: JsonDecoder.boolean,\n    name: JsonDecoder.string,\n    type: providerEntityDecoder\n  },\n  'Job Provider',\n  {\n    hostTemplate: 'host_template',\n    isNeedProxy: 'is_need_proxy'\n  }\n);\n\nconst monitoringServerDecoder = JsonDecoder.object<MonitoringServer>(\n  {\n    id: JsonDecoder.optional(JsonDecoder.number),\n    name: JsonDecoder.optional(JsonDecoder.string)\n  },\n  'Monitoring Server'\n);\n\nconst cronObjectDecoder = JsonDecoder.object<CronObject>(\n  {\n    every: JsonDecoder.optional(JsonDecoder.number),\n    values: JsonDecoder.string\n  },\n  'Cron Object'\n);\n\nexport const jobDetailsDecoder = JsonDecoder.object<RetrievedJobDetails>(\n  {\n    alias: JsonDecoder.string,\n    analysisMode: JsonDecoder.number,\n    credential: JsonDecoder.nullable(credentialDecoder),\n    executionMode: JsonDecoder.number,\n    id: JsonDecoder.number,\n    jobParameters: listAdditionalParameters,\n    mappersToApply: mappersToApplyDecoder,\n    monitoringServer: JsonDecoder.nullable(monitoringServerDecoder),\n    provider: jobProviderDecoder,\n    proxy: JsonDecoder.nullable(proxyDecoder),\n    saveMode: JsonDecoder.nullable(JsonDecoder.number),\n    scheduling: JsonDecoder.nullable(\n      JsonDecoder.object<CustomSchedulingAPI>(\n        {\n          days: cronObjectDecoder,\n          hours: cronObjectDecoder,\n          minutes: cronObjectDecoder,\n          months: cronObjectDecoder,\n          weekdays: JsonDecoder.string\n        },\n        'Scheduling'\n      )\n    )\n  },\n  'Job Details',\n  {\n    analysisMode: 'analysis_mode',\n    executionMode: 'execution_mode',\n    jobParameters: 'job_parameters',\n    mappersToApply: 'mappers_to_apply',\n    monitoringServer: 'monitoring_server',\n    saveMode: 'save_mode'\n  }\n);\n","import { createContext, useContext } from 'react';\n\nimport { UseListing } from './types';\n\ntype ContextType = UseListing;\n\nconst Context = createContext<ContextType | undefined>(undefined);\n\nexport const useHostsContext = (): ContextType =>\n  useContext(Context) as ContextType;\n\nexport default Context;\n","import { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport ArrowBackIcon from '@mui/icons-material/ArrowBack';\nimport EditIcon from '@mui/icons-material/Edit';\nimport Refresh from '@mui/icons-material/Refresh';\nimport { Button as MuiButton } from '@mui/material';\n\nimport { IconButton } from '@centreon/ui';\n\nimport { UseButton } from '../../Listing/models';\nimport {\n  labelBack,\n  labelEditMappers,\n  labelRefresh\n} from '../../translatedLabels';\n\ninterface Props {\n  backToJobs: () => void;\n  buttons: Array<UseButton>;\n  mappersPanelOpen: boolean;\n  openMappersPanel: () => void;\n  reloadHosts: () => void;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  hostActions: {\n    alignItems: 'center',\n    display: 'grid',\n    gridGap: theme.spacing(1),\n    gridTemplateColumns: 'repeat(4, min-content)'\n  }\n}));\n\nconst Actions = ({\n  buttons,\n  backToJobs,\n  reloadHosts,\n  openMappersPanel,\n  mappersPanelOpen\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  return (\n    <div className={classes.hostActions}>\n      <MuiButton\n        aria-label={t(labelBack)}\n        color=\"primary\"\n        size=\"small\"\n        startIcon={<ArrowBackIcon />}\n        variant=\"contained\"\n        onClick={backToJobs}\n      >\n        {t(labelBack)}\n      </MuiButton>\n      <IconButton\n        ariaLabel={t(labelRefresh)}\n        size=\"large\"\n        title={t(labelRefresh)}\n        onClick={reloadHosts}\n      >\n        <Refresh />\n      </IconButton>\n      <IconButton\n        ariaLabel={t(labelEditMappers)}\n        disabled={mappersPanelOpen}\n        size=\"large\"\n        title={t(labelEditMappers)}\n        onClick={openMappersPanel}\n      >\n        <EditIcon />\n      </IconButton>\n      <div>\n        {buttons.map(({ id, Button }) => (\n          <Button key={id} />\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport default Actions;\n","import { ChangeEvent, KeyboardEvent, memo } from 'react';\n\nimport { equals } from 'ramda';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { SearchField } from '@centreon/ui';\n\nimport SearchHelpTooltip from './SearchHelpTooltip';\n\nconst useStyles = makeStyles()({\n  searchField: {\n    width: 500\n  }\n});\n\ninterface Props {\n  changeSearch: (\n    event: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>\n  ) => void;\n  label: string;\n  requestSearch: (event: KeyboardEvent<Element>) => void;\n  search: string | null;\n}\n\nconst Search = ({\n  label,\n  changeSearch,\n  search,\n  requestSearch\n}: Props): JSX.Element => {\n  const { classes } = useStyles();\n\n  return (\n    <SearchField\n      EndAdornment={SearchHelpTooltip}\n      className={classes.searchField}\n      placeholder={label}\n      value={search || ''}\n      onChange={changeSearch}\n      onKeyDown={requestSearch}\n    />\n  );\n};\n\nconst MemoizedSearch = memo(Search, (prevProps, nextProps) =>\n  equals(prevProps.search, nextProps.search)\n);\n\nexport default MemoizedSearch;\n","import { useTranslation } from 'react-i18next';\n\nimport { RegexpHelpTooltip } from '@centreon/ui';\n\nimport {\n  labelGetRegexHelp,\n  labelSearchAndHostAliasContaining,\n  labelSearchByDiscoveryResultName,\n  labelSearchByHostAliasContaining,\n  labelSearchByHostAliasNotContaining,\n  labelSearchByHostIPAddressEndingWith,\n  labelSearchByHostNameStartingWith,\n  labelSearchByRegexp,\n  labelSearchHelp,\n  labelSearchOnFields,\n  labelSearchOnRawData,\n  labelSearchSomeExamples,\n  labelSearchSyntax,\n  labelTips,\n  labelViewAvailablePropertiesInsidePropertyMapper\n} from '../../../translatedLabels';\n\nconst searchFields = ['host.name', 'host.alias', 'host.ip_address'];\n\nconst SearchHelpTooltip = (): JSX.Element => {\n  const { t } = useTranslation();\n\n  const tooltipDescription = (\n    <>\n      <p>{`${t(labelSearchOnFields)}. ${t(labelSearchByRegexp)}.`}</p>\n      <p>{`${t(labelSearchSyntax)} ${searchFields.join(':, ')}:.`}</p>\n      <p>\n        {`${t(labelSearchOnRawData)}. ${t(\n          labelViewAvailablePropertiesInsidePropertyMapper\n        )}`}\n      </p>\n    </>\n  );\n\n  const tooltipExamples = [\n    <li key=\"host.name\">\n      <b>host.name:^FR20</b>\n      {` ${t(labelSearchByHostNameStartingWith)} \"FR20\"`}\n    </li>,\n    <li key=\"host.ip_address\">\n      <b>host.ip_address:0.1$</b>\n      {` ${t(labelSearchByHostIPAddressEndingWith)} \"0.1\"`}\n    </li>,\n    <li key=\"host.alias\">\n      <b>host.alias:SNMP</b>\n      {` ${t(labelSearchByHostAliasContaining)} \"SNMP\"`}\n    </li>,\n    <li key=\"host.alias_not_containing\">\n      <b>host.alias:^((?!AWS).)*$</b>\n      {` ${t(labelSearchByHostAliasNotContaining)} \"AWS\"`}\n    </li>,\n    <li key=\"host.name_host.alias\">\n      <b>host.name:^FR20 host.alias:AWS</b>\n      {` ${t(labelSearchByHostNameStartingWith)} \"FR20\" ${t(\n        labelSearchAndHostAliasContaining\n      )} \"AWS\"`}\n    </li>,\n    <li key=\"discovery.results.name\">\n      <b>discovery.results.name:^FR20</b>\n      {` ${t(labelSearchByDiscoveryResultName)} FR20`}\n    </li>\n  ];\n\n  return (\n    <RegexpHelpTooltip\n      description={tooltipDescription}\n      examples={tooltipExamples}\n      labelExamples={t(labelSearchSomeExamples)}\n      labelGetHelp={t(labelGetRegexHelp)}\n      labelSearchHelp={t(labelSearchHelp)}\n      labelTips={t(labelTips)}\n      labelUrlTip=\"regex101.com\"\n      urlTip=\"https://regex101.com\"\n    />\n  );\n};\n\nexport default SearchHelpTooltip;\n","import { ChangeEvent, KeyboardEvent, memo } from 'react';\n\nimport { equals } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { Button, Grid } from '@mui/material';\n\nimport { Filter } from '@centreon/ui';\n\nimport { labelSearch } from '../../../translatedLabels';\nimport { useHostsContext } from '../../Context';\n\nimport Search from './Search';\n\ninterface Props {\n  changeSearch: (\n    event: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>\n  ) => void;\n  loadWithParams: () => void;\n  requestSearchOnEnterKey: (event: KeyboardEvent<Element>) => void;\n  search: string | null;\n}\n\nconst HostFiltersForm = ({\n  search,\n  changeSearch,\n  requestSearchOnEnterKey,\n  loadWithParams\n}: Props): JSX.Element => {\n  const { t } = useTranslation();\n\n  return (\n    <Grid container alignItems=\"center\" spacing={1}>\n      <Grid item>\n        <Search\n          changeSearch={changeSearch}\n          label={t(labelSearch)}\n          requestSearch={requestSearchOnEnterKey}\n          search={search}\n        />\n      </Grid>\n      <Grid item>\n        <Button\n          aria-label={labelSearch}\n          color=\"primary\"\n          variant=\"contained\"\n          onClick={loadWithParams}\n        >\n          {t(labelSearch)}\n        </Button>\n      </Grid>\n    </Grid>\n  );\n};\n\nconst MemoizedHostFiltersForm = memo(HostFiltersForm, (prevProps, nextProps) =>\n  equals(prevProps.search, nextProps.search)\n);\n\nconst HostFilters = (): JSX.Element => {\n  const { changeSearch, search, requestSearchOnEnterKey, loadWithParams } =\n    useHostsContext();\n\n  return (\n    <MemoizedHostFiltersForm\n      changeSearch={changeSearch}\n      loadWithParams={loadWithParams}\n      requestSearchOnEnterKey={requestSearchOnEnterKey}\n      search={search}\n    />\n  );\n};\n\nexport default (): JSX.Element => <Filter content={<HostFilters />} />;\n","import { isNil, not, or } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport { alpha, useTheme } from '@mui/material';\n\nimport { Listing as TableListing, useMemoComponent } from '@centreon/ui';\n\nimport { Sort, SortO } from '../../Listing/useTableParams';\nimport { useHostsContext } from '../Context';\nimport { DiscoveredHost } from '../models';\n\nimport Actions from './Actions';\nimport getListingConfiguration from './listingConfiguration';\n\ninterface ListingProps {\n  actions: JSX.Element;\n  changeLimit: (updatedLimit) => void;\n  changeSelection: (hosts: Array<DiscoveredHost>) => void;\n  currentPage: number;\n  data: Array<DiscoveredHost>;\n  jobId: number;\n  limit: number;\n  paginate: (updatedPage) => void;\n  selectedHosts: Array<DiscoveredHost>;\n  sending: boolean;\n  sort: (params: Sort) => void;\n  sortf: string;\n  sorto: SortO;\n  total: number;\n}\n\nconst Listing = ({\n  data,\n  paginate,\n  sort,\n  sorto,\n  sortf,\n  limit,\n  currentPage,\n  total,\n  sending,\n  changeLimit,\n  actions,\n  jobId,\n  changeSelection,\n  selectedHosts\n}: ListingProps): JSX.Element => {\n  const { t } = useTranslation();\n  const theme = useTheme();\n\n  return (\n    <TableListing\n      checkable\n      actions={actions}\n      actionsBarMemoProps={[selectedHosts]}\n      columns={getListingConfiguration({ jobId, t })}\n      currentPage={currentPage}\n      limit={limit}\n      loading={sending}\n      rowColorConditions={[\n        {\n          color: alpha(theme.palette.primary.main, 0.1),\n          condition: (row) =>\n            or(not(isNil(row.host.id)), row.hostnameAlreadyUsed),\n          name: 'host updatable'\n        }\n      ]}\n      rows={data}\n      selectedRows={selectedHosts}\n      sortField={sortf}\n      sortOrder={sorto}\n      totalRows={total}\n      onLimitChange={changeLimit}\n      onPaginate={paginate}\n      onSelectRows={changeSelection}\n      onSort={sort}\n    />\n  );\n};\n\ninterface Props {\n  jobId: number;\n}\n\nconst ListingDiscoveredHosts = ({ jobId }: Props): JSX.Element => {\n  const {\n    discoveredHosts,\n    changeSelection,\n    limit,\n    tableParams: { paginate, changeLimit, sort, sorto, sortf, currentPage },\n    sending,\n    selectedHosts,\n    buttons,\n    backToJobs,\n    loadWithParams,\n    openMappersPanel,\n    mappersPanelOpen\n  } = useHostsContext();\n\n  const actions = (\n    <Actions\n      backToJobs={backToJobs}\n      buttons={buttons}\n      mappersPanelOpen={mappersPanelOpen}\n      openMappersPanel={openMappersPanel}\n      reloadHosts={loadWithParams}\n    />\n  );\n\n  return useMemoComponent({\n    Component: (\n      <Listing\n        actions={actions}\n        changeLimit={changeLimit}\n        changeSelection={changeSelection}\n        currentPage={currentPage}\n        data={discoveredHosts.result}\n        jobId={jobId}\n        limit={limit}\n        paginate={paginate}\n        selectedHosts={selectedHosts}\n        sending={sending}\n        sort={sort}\n        sortf={sortf}\n        sorto={sorto}\n        total={discoveredHosts.meta.total}\n      />\n    ),\n    memoProps: [\n      discoveredHosts.result,\n      sorto,\n      sortf,\n      limit,\n      currentPage,\n      discoveredHosts.meta.total,\n      sending,\n      selectedHosts,\n      mappersPanelOpen\n    ]\n  });\n};\n\nexport default ListingDiscoveredHosts;\n","import { useEffect, useState } from 'react';\n\nimport { and, isNil, not } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport AddIcon from '@mui/icons-material/Add';\nimport ArticleIcon from '@mui/icons-material/Article';\nimport UpgradeIcon from '@mui/icons-material/Upgrade';\nimport {\n  CircularProgress,\n  Dialog,\n  DialogContent,\n  DialogTitle,\n  Tooltip\n} from '@mui/material';\n\nimport { IconButton, useRequest } from '@centreon/ui';\n\nimport {\n  labelAddAsNewHost,\n  labelRawData,\n  labelRawDataCode,\n  labelSomethingWentWrong,\n  labelUpdateExistingHostsConfiguration\n} from '../../../translatedLabels';\nimport { getHostRawData } from '../../api';\nimport { hostRawDataDecoder } from '../../api/decoders';\nimport { DiscoveredHost, RawData as RawDataModel } from '../../models';\n\nimport useInlineActions from './useInlineActions';\n\ninterface Props {\n  isHovered: boolean;\n  row: DiscoveredHost;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  actionIcons: {\n    alignItems: 'center',\n    columnGap: theme.spacing(0.5),\n    display: 'grid',\n    gridTemplateColumns: 'repeat(2, 1fr)'\n  },\n  code: {\n    textAlign: 'left'\n  },\n  content: {\n    textAlign: 'center',\n    width: '100%'\n  },\n  loadingIndicator: {\n    textAlign: 'center'\n  }\n}));\n\nconst actions = (\n  jobId: number\n): (({ row, isHovered }: Props) => JSX.Element) => {\n  const Actions = ({ row, isHovered }: Props): JSX.Element => {\n    const [openDialog, setOpenDialog] = useState(false);\n    const [data, setData] = useState<Record<string, unknown> | undefined>();\n\n    const { classes } = useStyles();\n    const { t } = useTranslation();\n    const { sendRequest, sending } = useRequest({\n      decoder: hostRawDataDecoder,\n      defaultFailureMessage: t(labelSomethingWentWrong),\n      request: getHostRawData\n    });\n\n    const {\n      sendInlineActionDiscoveredHost,\n      sendingInlineActionDiscoveredHost\n    } = useInlineActions(row);\n\n    const onOpenDialog = (): void => setOpenDialog(true);\n\n    const onCloseDialog = (): void => {\n      setOpenDialog(false);\n      setData(undefined);\n    };\n\n    useEffect(() => {\n      if (openDialog) {\n        sendRequest({ hostId: row.id, jobId }).then(\n          ({ discoveryResult }: RawDataModel): void => {\n            setData(discoveryResult);\n          }\n        );\n      }\n    }, [openDialog]);\n\n    const iconProps = and(isNil(row.host.id), not(row.hostnameAlreadyUsed))\n      ? {\n          Icon: AddIcon,\n          label: labelAddAsNewHost,\n          onClick: sendInlineActionDiscoveredHost\n        }\n      : {\n          Icon: UpgradeIcon,\n          label: labelUpdateExistingHostsConfiguration,\n          onClick: sendInlineActionDiscoveredHost\n        };\n\n    const title = `${row.host.name} ${t(labelRawData)}`;\n\n    const { label, Icon, onClick } = iconProps;\n\n    return (\n      <div>\n        <div className={classes.actionIcons}>\n          <Tooltip title={t(label)}>\n            <IconButton\n              ariaLabel={title}\n              disabled={sendingInlineActionDiscoveredHost}\n              size=\"small\"\n              onClick={onClick}\n            >\n              <Icon aria-label={`${t(label)}_${row.id}`} fontSize=\"small\" />\n            </IconButton>\n          </Tooltip>\n          {isHovered && (\n            <IconButton\n              ariaLabel={title}\n              size=\"large\"\n              title={title}\n              onClick={onOpenDialog}\n            >\n              <ArticleIcon color=\"primary\" fontSize=\"small\" />\n            </IconButton>\n          )}\n        </div>\n        {openDialog && (\n          <Dialog\n            fullWidth\n            maxWidth=\"md\"\n            open={openDialog}\n            scroll=\"paper\"\n            onClose={onCloseDialog}\n          >\n            <DialogTitle>\n              <div className={classes.content}>{row.host.name}</div>\n            </DialogTitle>\n            <DialogContent>\n              <div className={classes.content}>\n                {sending || isNil(data) ? (\n                  <CircularProgress className={classes.loadingIndicator} />\n                ) : (\n                  <pre\n                    aria-label={t(labelRawDataCode)}\n                    className={classes.code}\n                  >\n                    {JSON.stringify(data, null, 2)}\n                  </pre>\n                )}\n              </div>\n            </DialogContent>\n          </Dialog>\n        )}\n      </div>\n    );\n  };\n\n  return Actions;\n};\n\nexport default actions;\n","import { path, gt, isNil, length, splitAt } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport MoreHoriz from '@mui/icons-material/MoreHoriz';\nimport { Chip, IconButton, Paper, Tooltip, Typography } from '@mui/material';\n\nimport { labelMoreHostTemplates } from '../../../translatedLabels';\nimport { DiscoveredHost, HostTemplate } from '../../models';\n\nexport interface HostTemplatesProps {\n  row: DiscoveredHost;\n}\n\ninterface MoreHostTemplatesProps {\n  hostTemplates: Array<HostTemplate>;\n}\n\nconst maxChipsDisplayed = 2;\n\nconst useStyles = makeStyles()((theme) => ({\n  container: {\n    display: 'grid',\n    gridGap: theme.spacing(0.5),\n    gridTemplateColumns: 'repeat(2, min-content)'\n  },\n  hostTemplatesContainer: {\n    display: 'grid',\n    gridGap: theme.spacing(0.5),\n    gridTemplateColumns: `repeat(${maxChipsDisplayed}, min-content)`\n  },\n  iconButton: {\n    padding: 0\n  },\n  paperMoreHostTemplates: {\n    padding: theme.spacing(1, 2)\n  },\n  tooltip: {\n    backgroundColor: 'transparent',\n    maxWidth: 'none'\n  }\n}));\n\nconst MoreHostTemplates = ({\n  hostTemplates\n}: MoreHostTemplatesProps): JSX.Element => {\n  const { classes } = useStyles();\n\n  return (\n    <Paper className={classes.paperMoreHostTemplates}>\n      {hostTemplates.map(({ name }) => (\n        <Typography key={name}>{name}</Typography>\n      ))}\n    </Paper>\n  );\n};\n\nconst HostTemplates = ({ row }: HostTemplatesProps): JSX.Element | null => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const hostTemplates = path<Array<HostTemplate>>(['host', 'templates'], row);\n\n  if (isNil(hostTemplates)) {\n    return null;\n  }\n\n  return (\n    <div className={classes.container}>\n      <div className={classes.hostTemplatesContainer}>\n        {splitAt(maxChipsDisplayed, hostTemplates)[0].map(({ name }) => (\n          <Chip key={name} label={name} size=\"small\" />\n        ))}\n      </div>\n      {gt(length(hostTemplates), maxChipsDisplayed) && (\n        <Tooltip\n          classes={{ tooltip: classes.tooltip }}\n          title={<MoreHostTemplates hostTemplates={hostTemplates} />}\n        >\n          <IconButton\n            aria-label={`${t(labelMoreHostTemplates)}_${path(\n              ['host', 'name'],\n              row\n            )}`}\n            className={classes.iconButton}\n            size=\"small\"\n          >\n            <MoreHoriz />\n          </IconButton>\n        </Tooltip>\n      )}\n    </div>\n  );\n};\n\nexport default HostTemplates;\n","import { T, pathOr } from 'ramda';\n\nimport { Column, ColumnType } from '@centreon/ui';\n\nimport { Translation } from '../../../JobWizard/models';\nimport {\n  labelAlias,\n  labelHostTemplates,\n  labelIPAddress,\n  labelMonitoringServer,\n  labelName\n} from '../../../translatedLabels';\n\nimport actions from './Actions';\nimport HostTemplates from './HostTemplates';\n\ninterface Props {\n  jobId: number;\n  t: Translation;\n}\n\nconst getListingConfiguration = ({ jobId, t }: Props): Array<Column> => [\n  {\n    Component: actions(jobId),\n    disablePadding: false,\n    getRenderComponentOnRowUpdateCondition: T,\n    hasHoverableComponent: true,\n    id: 'actions',\n    label: '',\n    sortable: false,\n    type: ColumnType.component,\n    width: 60\n  },\n  {\n    disablePadding: false,\n    getFormattedString: (row): string =>\n      pathOr<string>('', ['host', 'name'], row),\n    getRenderComponentOnRowUpdateCondition: T,\n    id: 'host.name',\n    label: t(labelName),\n    sortable: true,\n    type: ColumnType.string\n  },\n  {\n    disablePadding: false,\n    getFormattedString: (row): string =>\n      pathOr<string>('', ['host', 'alias'], row),\n    getRenderComponentOnRowUpdateCondition: T,\n    id: 'host.alias',\n    label: t(labelAlias),\n    sortable: true,\n    type: ColumnType.string\n  },\n  {\n    disablePadding: false,\n    getFormattedString: (row): string =>\n      pathOr<string>('', ['host', 'ipAddress'], row),\n    getRenderComponentOnRowUpdateCondition: T,\n    id: 'host.ip_address',\n    label: t(labelIPAddress),\n    sortable: true,\n    type: ColumnType.string\n  },\n  {\n    disablePadding: false,\n    getFormattedString: (row): string =>\n      pathOr<string>('', ['host', 'monitoringServer', 'name'], row),\n    getRenderComponentOnRowUpdateCondition: T,\n    id: 'host.monitoring_server',\n    label: t(labelMonitoringServer),\n    sortable: true,\n    type: ColumnType.string\n  },\n  {\n    Component: HostTemplates,\n    disablePadding: false,\n    getRenderComponentOnRowUpdateCondition: T,\n    id: 'host.templates',\n    label: t(labelHostTemplates),\n    sortable: true,\n    type: ColumnType.component\n  }\n];\n\nexport default getListingConfiguration;\n","import { useTranslation } from 'react-i18next';\n\nimport { useRequest, useSnackbar } from '@centreon/ui';\n\nimport {\n  labelCommandWasSubmitted,\n  labelSomethingWentWrong\n} from '../../../translatedLabels';\nimport { useHostsContext } from '../../Context';\nimport { saveHosts } from '../../api';\nimport { DiscoveredHost } from '../../models';\n\ninterface UseInlineActions {\n  sendInlineActionDiscoveredHost: () => void;\n  sendingInlineActionDiscoveredHost: boolean;\n}\n\nconst useInlineActions = (row: DiscoveredHost): UseInlineActions => {\n  const { t } = useTranslation();\n\n  const { showSuccessMessage } = useSnackbar();\n  const { loadWithParams, jobId } = useHostsContext();\n\n  const {\n    sendRequest: sendInlineAction,\n    sending: sendingInlineActionDiscoveredHost\n  } = useRequest({\n    defaultFailureMessage: t(labelSomethingWentWrong),\n    request: saveHosts\n  });\n\n  const sendInlineActionDiscoveredHost = (): void => {\n    sendInlineAction({\n      hosts: [row.id],\n      jobId\n    }).then(() => {\n      showSuccessMessage(t(labelCommandWasSubmitted));\n      loadWithParams();\n    });\n  };\n\n  return { sendInlineActionDiscoveredHost, sendingInlineActionDiscoveredHost };\n};\n\nexport default useInlineActions;\n","import { useState } from 'react';\n\nimport { isEmpty } from 'ramda';\nimport { useTranslation } from 'react-i18next';\n\nimport SaveAltIcon from '@mui/icons-material/SaveAlt';\nimport { CircularProgress } from '@mui/material';\n\nimport { IconButton } from '@centreon/ui';\n\nimport { labelSave } from '../../translatedLabels';\nimport { CommonActions, DiscoveredHost } from '../models';\n\ninterface Props {\n  executeAction: (promise) => Promise<unknown>;\n  jobId: number;\n  saveDiscoveredHosts: ({ jobId, hosts }) => Promise<unknown>;\n  sendingSaveDiscoveredHosts: boolean;\n}\n\nconst useCommonActions = ({\n  jobId,\n  saveDiscoveredHosts,\n  executeAction,\n  sendingSaveDiscoveredHosts\n}: Props): CommonActions => {\n  const { t } = useTranslation();\n  const [selectedHosts, setSelectedHosts] = useState<Array<DiscoveredHost>>([]);\n\n  const save = (): void => {\n    executeAction(\n      saveDiscoveredHosts({\n        hosts: selectedHosts.map((host) => host.id),\n        jobId\n      })\n    ).then(() => setSelectedHosts([]));\n  };\n\n  return {\n    buttons: [\n      {\n        Button: (): JSX.Element => (\n          <IconButton\n            ariaLabel={t(labelSave)}\n            disabled={isEmpty(selectedHosts) || sendingSaveDiscoveredHosts}\n            size=\"large\"\n            title={t(labelSave)}\n            onClick={save}\n          >\n            <SaveAltIcon />\n            {sendingSaveDiscoveredHosts && <CircularProgress size={20} />}\n          </IconButton>\n        ),\n        id: 'SaveHosts'\n      }\n    ],\n    selectedHosts,\n    setSelectedHosts\n  };\n};\n\nexport default useCommonActions;\n","import { KeyboardEvent, useEffect, useState } from 'react';\n\nimport { equals, toUpper } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { useNavigate } from 'react-router-dom';\n\nimport { useRequest, useSnackbar } from '@centreon/ui';\n\nimport useTableParams from '../../Listing/useTableParams';\nimport {\n  labelSaveCommandWasSubmitted,\n  labelSomethingWentWrong\n} from '../../translatedLabels';\nimport { UseListing } from '../Context/types';\nimport { getDiscoveredHosts, saveHosts } from '../api';\nimport { listingHostsDecoder } from '../api/decoders';\nimport { DiscoveredHostListing } from '../models';\n\nimport useCommonActions from './useCommonActions';\n\ninterface Props {\n  jobId: number;\n}\n\nconst useListing = ({ jobId }: Props): UseListing => {\n  const { t } = useTranslation();\n  const [discoveredHosts, setDiscoveredHosts] = useState<DiscoveredHostListing>(\n    {\n      meta: {\n        limit: 0,\n        page: 0,\n        total: 0\n      },\n      result: []\n    }\n  );\n  const [search, setSearch] = useState<string>('');\n  const [updateHosts, setUpdateHosts] = useState<boolean>(false);\n  const [mappersPanelOpen, setMappersPanelOpen] = useState<boolean>(false);\n\n  const navigate = useNavigate();\n\n  const { sendRequest: loadDiscoveredHosts, sending: sendingDiscoveredHosts } =\n    useRequest<DiscoveredHostListing>({\n      decoder: listingHostsDecoder,\n      defaultFailureMessage: t(labelSomethingWentWrong),\n      request: getDiscoveredHosts\n    });\n  const {\n    sendRequest: saveDiscoveredHosts,\n    sending: sendingSaveDiscoveredHosts\n  } = useRequest({\n    defaultFailureMessage: t(labelSomethingWentWrong),\n    request: saveHosts\n  });\n  const { showSuccessMessage } = useSnackbar();\n\n  const load = (params): Promise<void> =>\n    loadDiscoveredHosts({\n      jobId,\n      parameters: {\n        ...params,\n        page: params.page + 1,\n        search: {\n          regex: {\n            fields: ['host.name', 'host.alias', 'host.ip_address'],\n            value: search\n          }\n        },\n        sort: { [params.sortf]: toUpper(params.sorto) }\n      }\n    }).then((data): void => {\n      setDiscoveredHosts(data);\n    });\n\n  const { getEndpointParams, ...tableParams } = useTableParams({\n    defaultParams: {\n      sortf: 'host.name',\n      sorto: 'asc'\n    },\n    onParamChange: (params): void => {\n      load(params);\n    }\n  });\n\n  const loadWithParams = (): void => {\n    load(getEndpointParams());\n  };\n\n  const executeAction = (action): Promise<unknown> =>\n    action.then((): void => {\n      showSuccessMessage(t(labelSaveCommandWasSubmitted));\n      loadWithParams();\n    });\n\n  const { buttons, selectedHosts, setSelectedHosts } = useCommonActions({\n    executeAction,\n    jobId,\n    saveDiscoveredHosts,\n    sendingSaveDiscoveredHosts\n  });\n\n  const backToJobs = (): void => {\n    navigate('/configuration/hosts/discovery/jobs');\n  };\n\n  const changeSearch = (event): void => {\n    setSearch(event.target.value);\n  };\n\n  const requestSearchOnEnterKey = (event: KeyboardEvent): void => {\n    const enterKeyPressed = equals(event.key, 'Enter');\n\n    if (!enterKeyPressed) {\n      return;\n    }\n\n    if (equals(tableParams.currentPage, 0)) {\n      loadWithParams();\n\n      return;\n    }\n\n    tableParams.paginate(null, 0);\n  };\n\n  const { limit } = getEndpointParams();\n\n  const startUpdateHosts = (): void => setUpdateHosts(true);\n  const stopUpdateHosts = (): void => setUpdateHosts(false);\n\n  const openMappersPanel = (): void => setMappersPanelOpen(true);\n  const closeMappersPanel = (): void => setMappersPanelOpen(false);\n\n  useEffect(() => {\n    if (updateHosts) {\n      loadWithParams();\n      stopUpdateHosts();\n    }\n  }, [updateHosts]);\n\n  return {\n    backToJobs,\n    buttons,\n    changeSearch,\n    changeSelection: setSelectedHosts,\n    closeMappersPanel,\n    discoveredHosts,\n    jobId,\n    limit,\n    loadWithParams,\n    mappersPanelOpen,\n    openMappersPanel,\n    requestSearchOnEnterKey,\n    search,\n    selectedHosts,\n    sending: sendingDiscoveredHosts,\n    startUpdateHosts,\n    tableParams\n  };\n};\n\nexport default useListing;\n","import { useFormikContext } from 'formik';\nimport { isEmpty } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Typography } from '@mui/material';\n\nimport { SaveButton } from '@centreon/ui';\n\nimport { labelMappers } from '../../translatedLabels';\n\ninterface Props {\n  succeeded: boolean;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  header: {\n    alignItems: 'center',\n    display: 'grid',\n    gridGap: theme.spacing(0.5),\n    gridTemplateColumns: 'auto min-content',\n    justifyItems: 'center',\n    margin: '0 auto',\n    width: '95%'\n  }\n}));\n\nconst Header = ({ succeeded }: Props): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n  const { dirty, isValid, errors, isSubmitting, submitForm } =\n    useFormikContext();\n\n  const canSubmit = dirty && isValid && isEmpty(errors);\n\n  return (\n    <div className={classes.header} data-testid=\"panelHeader\">\n      <Typography variant=\"h6\">{t(labelMappers)}</Typography>\n      <SaveButton\n        disabled={!canSubmit && !succeeded}\n        loading={isSubmitting}\n        succeeded={succeeded}\n        onClick={submitForm}\n      />\n    </div>\n  );\n};\n\nexport default Header;\n","import { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Skeleton, useTheme } from '@mui/material';\n\nimport { labelLoadingJobMappers } from '../../translatedLabels';\n\nconst useStyles = makeStyles()((theme) => ({\n  loadingMapper: {\n    marginTop: theme.spacing(2)\n  },\n  loadingMappers: {\n    justifyContent: 'center',\n    margin: theme.spacing(-1, 1, 0, 1)\n  }\n}));\n\nconst LoadingMappers = (): JSX.Element => {\n  const theme = useTheme();\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  return (\n    <div\n      aria-label={t(labelLoadingJobMappers)}\n      className={classes.loadingMappers}\n    >\n      {[...Array(5).keys()].map((id) => (\n        <Skeleton\n          animation=\"wave\"\n          className={classes.loadingMapper}\n          height={theme.spacing(4)}\n          key={`${id}`}\n          variant=\"rectangular\"\n          width=\"100%\"\n        />\n      ))}\n    </div>\n  );\n};\n\nexport default LoadingMappers;\n","import { memo, useEffect, useRef, useState } from 'react';\n\nimport { Formik } from 'formik';\nimport { T, always, cond, equals, isEmpty, isNil, not, or, pick } from 'ramda';\nimport { useTranslation } from 'react-i18next';\nimport { makeStyles } from 'tss-react/mui';\n\nimport { Panel, useRequest } from '@centreon/ui';\n\nimport Mappers from '../../JobWizard/Mappers';\nimport validateMappers from '../../JobWizard/Mappers/validate';\nimport type { MappersFormValues } from '../../JobWizard/models';\nimport { mappersToApplyDecoder } from '../../PanelEdit/api/decoders';\nimport type { MapperToApply } from '../../PanelEdit/models';\nimport { labelClose, labelSomethingWentWrong } from '../../translatedLabels';\nimport { useHostsContext } from '../Context';\nimport { getJobMappers, updateJobMappers } from '../api';\n\nimport Header from './Header';\nimport LoadingMappers from './LoadingMappers';\n\ninterface Props {\n  jobId: number;\n  providerId: number;\n}\n\ninterface MappersPanelProps extends Props {\n  closeMappersPanel: () => void;\n  startUpdateHosts: () => void;\n}\n\nconst useStyles = makeStyles()((theme) => ({\n  mappers: {\n    marginTop: theme.spacing(1)\n  }\n}));\n\nconst successfullSaveDurationInMs = 700;\n\nconst MappersPanel = ({\n  jobId,\n  providerId,\n  startUpdateHosts,\n  closeMappersPanel\n}: MappersPanelProps): JSX.Element => {\n  const { classes } = useStyles();\n  const { t } = useTranslation();\n\n  const [mappers, setMappers] = useState<Array<MapperToApply>>([]);\n  const [submitionSucceed, setSubmitionSucceed] = useState<boolean>(false);\n  const { sendRequest, sending } = useRequest<Array<MapperToApply>>({\n    decoder: mappersToApplyDecoder,\n    defaultFailureMessage: t(labelSomethingWentWrong),\n    request: getJobMappers\n  });\n  const timeoutSubmitionSucceed = useRef<NodeJS.Timeout | undefined>();\n\n  const checkMappers = (): boolean =>\n    or(equals(true, sending), isEmpty(mappers));\n\n  const submitMappers = (values, { setSubmitting }): void => {\n    setSubmitting(true);\n    updateJobMappers({ jobId, mappers: values.mappers })\n      .then(() => {\n        setMappers(values.mappers);\n        setSubmitionSucceed(true);\n        startUpdateHosts();\n        timeoutSubmitionSucceed.current = setTimeout(() => {\n          setSubmitionSucceed(false);\n          timeoutSubmitionSucceed.current = undefined;\n        }, successfullSaveDurationInMs);\n      })\n      .catch(() => {\n        setSubmitionSucceed(false);\n      })\n      .finally(() => setSubmitting(false));\n  };\n\n  const displayMappersForm = cond([\n    [checkMappers, always(<LoadingMappers />)],\n    [\n      T,\n      always(\n        <div className={classes.mappers}>\n          <Mappers displayMappersOnly />\n        </div>\n      )\n    ]\n  ]);\n\n  useEffect(() => {\n    sendRequest(jobId).then((mappersResult) => {\n      setMappers(\n        mappersResult.map((mapper, index) => ({ ...mapper, id: index }))\n      );\n    });\n\n    return (): void => {\n      if (not(isNil(timeoutSubmitionSucceed.current))) {\n        clearTimeout(timeoutSubmitionSucceed.current as NodeJS.Timeout);\n      }\n    };\n  }, [jobId]);\n\n  return (\n    <Formik<MappersFormValues>\n      enableReinitialize\n      initialValues={{\n        mappers,\n        providerId\n      }}\n      validate={validateMappers(t)}\n      onSubmit={submitMappers}\n    >\n      <Panel\n        header={<Header succeeded={submitionSucceed} />}\n        labelClose={t(labelClose)}\n        selectedTab={displayMappersForm()}\n        onClose={closeMappersPanel}\n      />\n    </Formik>\n  );\n};\n\nconst memoProps = ['jobId', 'providerId'];\n\nconst MemoizedMappersPanel = memo(MappersPanel, (prevProps, nextProps) =>\n  equals(pick(memoProps, prevProps), pick(memoProps, nextProps))\n);\n\nconst MappersPanelContainer = ({ jobId, providerId }: Props): JSX.Element => {\n  const { startUpdateHosts, closeMappersPanel } = useHostsContext();\n\n  return (\n    <MemoizedMappersPanel\n      closeMappersPanel={closeMappersPanel}\n      jobId={jobId}\n      providerId={providerId}\n      startUpdateHosts={startUpdateHosts}\n    />\n  );\n};\n\nexport default MappersPanelContainer;\n","import { memo } from 'react';\n\nimport { equals } from 'ramda';\n\nimport { ListingPage } from '@centreon/ui';\n\nimport { useHostsContext } from './Context';\nimport HostsListing from './Listing';\nimport Filters from './Listing/Filters';\nimport MappersPanel from './Mappers';\n\ninterface Props {\n  jobId: number;\n  providerId: number;\n}\n\ninterface ListingPageProps extends Props {\n  mappersPanelOpen: boolean;\n}\n\nconst HostListingPage = ({\n  providerId,\n  jobId,\n  mappersPanelOpen\n}: ListingPageProps): JSX.Element => (\n  <ListingPage\n    panelFixed\n    filter={<Filters />}\n    listing={<HostsListing jobId={jobId} />}\n    panel={<MappersPanel jobId={jobId} providerId={providerId} />}\n    panelOpen={mappersPanelOpen}\n  />\n);\n\nconst MemoizedHostListingPage = memo(HostListingPage, (prevProps, nextProps) =>\n  equals(prevProps.mappersPanelOpen, nextProps.mappersPanelOpen)\n);\n\nconst Page = (props: Props): JSX.Element => {\n  const { mappersPanelOpen } = useHostsContext();\n\n  return (\n    <MemoizedHostListingPage mappersPanelOpen={mappersPanelOpen} {...props} />\n  );\n};\n\nexport default Page;\n","import { JsonDecoder } from 'ts.data.json';\n\nimport { buildListingDecoder } from '@centreon/ui';\n\nimport {\n  DiscoveredHost,\n  ExtendedHost,\n  HostDetails,\n  HostTemplate,\n  MonitoringServer,\n  RawData\n} from '../models';\n\nconst extendedHostDecoder = JsonDecoder.object<ExtendedHost>(\n  {\n    actionUrl: JsonDecoder.nullable(JsonDecoder.string),\n    notes: JsonDecoder.nullable(JsonDecoder.string),\n    notesUrl: JsonDecoder.nullable(JsonDecoder.string)\n  },\n  'Extended Host'\n);\n\nconst monitoringServerDecoder = JsonDecoder.object<MonitoringServer>(\n  {\n    name: JsonDecoder.string\n  },\n  'Monitoring Server'\n);\n\nconst hostTemplateDecoder = JsonDecoder.object<HostTemplate>(\n  {\n    name: JsonDecoder.string\n  },\n  'Host Template'\n);\n\nconst hostDetailsDecoder = JsonDecoder.object<HostDetails>(\n  {\n    alias: JsonDecoder.nullable(JsonDecoder.string),\n    extended_host: JsonDecoder.nullable(extendedHostDecoder),\n    id: JsonDecoder.nullable(JsonDecoder.number),\n    ipAddress: JsonDecoder.nullable(JsonDecoder.string),\n    monitoringServer: monitoringServerDecoder,\n    name: JsonDecoder.nullable(JsonDecoder.string),\n    templates: JsonDecoder.array(hostTemplateDecoder, 'Host Templates')\n  },\n  'Host Details',\n  {\n    ipAddress: 'ip_address',\n    monitoringServer: 'monitoring_server'\n  }\n);\n\nconst hostDecoder = JsonDecoder.object<DiscoveredHost>(\n  {\n    host: hostDetailsDecoder,\n    hostnameAlreadyUsed: JsonDecoder.boolean,\n    id: JsonDecoder.number\n  },\n  'Host',\n  {\n    hostnameAlreadyUsed: 'hostname_already_used'\n  }\n);\n\nexport const listingHostsDecoder = buildListingDecoder<DiscoveredHost>({\n  entityDecoder: hostDecoder,\n  entityDecoderName: 'Hosts',\n  listingDecoderName: 'ListHosts'\n});\n\nexport const hostRawDataDecoder = JsonDecoder.object<RawData>(\n  {\n    discoveryResult: JsonDecoder.succeed,\n    id: JsonDecoder.number,\n    jobId: JsonDecoder.number\n  },\n  'Host Raw Data',\n  {\n    discoveryResult: 'discovery_result',\n    jobId: 'job_id'\n  }\n);\n","import { baseEndpoint } from '../../api/endpoint';\n\nexport interface RawDataParams {\n  hostId: number;\n  jobId: number;\n}\n\nexport const discoveredHostsEndpoint = (jobId: number): string =>\n  `${baseEndpoint}/auto-discovery/jobs/${jobId}/discovered-hosts`;\nexport const saveDiscoveredHostsEndpoint = (jobId: number): string =>\n  `${discoveredHostsEndpoint(jobId)}/save`;\nexport const getJobMappersEndpoint = (jobId: number): string =>\n  `${baseEndpoint}/auto-discovery/jobs/${jobId}/mappers`;\nexport const getHostRawDataEndpoint = ({\n  jobId,\n  hostId\n}: RawDataParams): string =>\n  `${baseEndpoint}/auto-discovery/jobs/${jobId}/discovered-hosts/${hostId}`;\n","import { CancelToken } from 'axios';\n\nimport {\n  BuildListingEndpointParameters,\n  buildListingEndpoint,\n  getData,\n  postData\n} from '@centreon/ui';\n\nimport { formatMappers } from '../../JobWizard/api/adapters';\nimport { Mapper } from '../../JobWizard/models';\nimport { MapperToApply } from '../../PanelEdit/models';\nimport { put } from '../../api';\nimport { DiscoveredHostListing, RawData } from '../models';\n\nimport {\n  RawDataParams,\n  discoveredHostsEndpoint,\n  getHostRawDataEndpoint,\n  getJobMappersEndpoint,\n  saveDiscoveredHostsEndpoint\n} from './endpoint';\n\nconst config = {\n  headers: { 'Content-Type': 'application/x-www-form-urlencoded' }\n};\n\ninterface DiscoveredHosts {\n  jobId: number;\n  parameters: BuildListingEndpointParameters;\n}\n\nexport const getDiscoveredHosts =\n  (cancelToken: CancelToken) =>\n  ({ jobId, parameters }: DiscoveredHosts): Promise<DiscoveredHostListing> => {\n    const endpoint = buildListingEndpoint({\n      baseEndpoint: discoveredHostsEndpoint(jobId),\n      parameters\n    });\n\n    return getData<DiscoveredHostListing>(cancelToken)({ endpoint });\n  };\n\nexport const getJobMappers =\n  (cancelToken: CancelToken) =>\n  (jobId: number): Promise<Array<MapperToApply>> =>\n    getData<Array<MapperToApply>>(cancelToken)({\n      endpoint: getJobMappersEndpoint(jobId)\n    });\n\ninterface UpdateJobMappers {\n  jobId: number;\n  mappers: Array<Mapper>;\n}\n\nexport const updateJobMappers = ({\n  jobId,\n  mappers\n}: UpdateJobMappers): Promise<unknown> => {\n  const mappersToPut = formatMappers(mappers);\n\n  return put(getJobMappersEndpoint(jobId), mappersToPut, config);\n};\n\ninterface SaveHosts {\n  hosts: Array<number>;\n  jobId: number;\n}\n\nexport const saveHosts =\n  (cancelToken: CancelToken) =>\n  ({ jobId, hosts }: SaveHosts): Promise<unknown> =>\n    postData(cancelToken)({\n      data: { all: false, ids: hosts },\n      endpoint: saveDiscoveredHostsEndpoint(jobId)\n    });\n\nexport const getHostRawData =\n  (cancelToken: CancelToken) =>\n  (params: RawDataParams): Promise<RawData> =>\n    getData<RawData>(cancelToken)({ endpoint: getHostRawDataEndpoint(params) });\n","import { useMemo } from 'react';\n\nimport { createStore } from 'jotai';\nimport { useParams, useSearchParams } from 'react-router-dom';\n\nimport { Module } from '@centreon/ui';\n\nimport Context from './Context';\nimport useListing from './Listing/useListing';\nimport Page from './Page';\n\nconst HostsPage = (): JSX.Element => {\n  const { id } = useParams();\n  const [searchParams] = useSearchParams(window.location.search);\n\n  const jobId = Number.parseInt(id as string, 10);\n\n  const listingContext = useListing({ jobId });\n\n  const contextValues = useMemo(\n    () => ({\n      ...listingContext\n    }),\n    [listingContext]\n  );\n\n  return (\n    <Context.Provider value={contextValues}>\n      <Page\n        jobId={jobId}\n        providerId={Number(searchParams.get('providerId') || '')}\n      />\n    </Context.Provider>\n  );\n};\n\nconst DiscoveryHostsPage = ({\n  store\n}: {\n  store: ReturnType<typeof createStore>;\n}): JSX.Element => (\n  <Module\n    maxSnackbars={1}\n    seedName=\"centreon-auto-discovery-discovered-hosts\"\n    store={store}\n  >\n    <HostsPage />\n  </Module>\n);\n\nexport default DiscoveryHostsPage;\n","const apiVersion = 'latest';\nconst baseEndpoint = `./api/${apiVersion}`;\nconst legacyBaseEndpoint = './api/internal.php';\n\nexport { baseEndpoint, legacyBaseEndpoint };\n","import axios from 'axios';\n\nexport const get = (endpoint) => axios.get(endpoint).then(({ data }) => data);\n\nexport const post = (endpoint, postData, config) =>\n  axios.post(endpoint, JSON.stringify(postData), config);\n\nexport const put = (endpoint, postData, config) =>\n  axios.put(endpoint, JSON.stringify(postData), config);\n\nexport default get;\n","// Global wizard\nexport const labelCancel = 'Cancel';\nexport const labelPrevious = 'Previous';\nexport const labelNext = 'Next';\nexport const labelFinished = 'Finished';\nexport const labelFinish = 'Finish';\nexport const labelTitleExitWizard = 'Exit wizard ?';\nexport const labelMessageExitWizard = 'Your progress will not be saved';\nexport